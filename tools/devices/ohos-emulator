#!/usr/bin/env bash
# Boots, stops, or names the shared OpenHarmony emulator: QEMU running the Oniro
# image that mise installed. Every checkout and session on the machine shares
# the one emulator, which forwards hdc from a fixed port, so a test reuses it
# whoever started it and leaves it running.
#
#   tools/devices/ohos-emulator boot   Boot it, or reuse it, and wait until it
#                                      answers hdc.
#   tools/devices/ohos-emulator stop   Stop it, which any session may be using.
#   tools/devices/ohos-emulator key    Print its hdc connect key once it answers
#                                      hdc; print nothing and fail before then,
#                                      so a caller can boot it and ask again.
#
# QEMU records its process in a pidfile under the XDG state directory, one per
# Oniro version, and holds a lock on it, so a second launch exits rather than
# run the same images too.
set -euo pipefail

connect_key=127.0.0.1:55555

if [[ $# -ne 1 ]]; then
  echo "usage: tools/devices/ohos-emulator boot|stop|key" >&2
  exit 2
fi
command=$1

image_dir=$(cd -P "$(mise where http:oniro-emulator)/images" && pwd)
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/maplibre-native-ffi
pidfile="$state_dir/ohos-emulator-$(basename "$(dirname "$image_dir")").pid"

# Prints the emulator's process ID. A PID can be reused after QEMU dies without
# removing its pidfile, so the process counts only while its command line names
# these images; otherwise the pidfile is stale and goes. An empty pidfile is one
# that a starting QEMU has not written yet.
running_pid() {
  local pid
  pid=$(cat "$pidfile" 2>/dev/null) || return 1
  [[ -n "$pid" ]] || return 1
  if [[ "$pid" =~ ^[0-9]+$ ]] &&
    [[ "$(ps -ww -p "$pid" -o command= 2>/dev/null)" == *"file=$image_dir/userdata.img,"* ]]; then
    printf '%s\n' "$pid"
    return 0
  fi
  rm -f "$pidfile"
  return 1
}

ready() {
  running_pid >/dev/null &&
    hdc tconn "$connect_key" >/dev/null 2>&1 &&
    hdc -t "$connect_key" shell echo ready 2>/dev/null | tr -d '\r' | grep -qx ready
}

launch() {
  local acceleration cpu image
  for image in bzImage ramdisk.img updater.img system.img vendor.img userdata.img; do
    if [[ ! -f "$image_dir/$image" ]]; then
      echo "OpenHarmony emulator image does not exist: $image_dir/$image" >&2
      return 2
    fi
  done
  if ! command -v qemu-system-x86_64 >/dev/null 2>&1; then
    echo "qemu-system-x86_64 is unavailable. Install QEMU through your system package manager and retry." >&2
    return 2
  fi
  case "$(uname -s)" in
    Linux)
      if [[ -r /dev/kvm && -w /dev/kvm ]]; then
        acceleration=(-enable-kvm)
        cpu=(-cpu host)
      else
        echo "KVM is inaccessible; using QEMU software emulation." >&2
        acceleration=(-accel "tcg,thread=multi")
        cpu=(-cpu max)
      fi
      ;;
    Darwin)
      # The Oniro image is x86_64, which the hypervisor on Apple Silicon cannot
      # accelerate, so macOS hosts always run it under TCG.
      acceleration=(-accel "tcg,thread=multi")
      cpu=(-cpu max)
      ;;
    *)
      echo "The OpenHarmony emulator supports Linux and macOS hosts." >&2
      return 2
      ;;
  esac
  mkdir -p "$state_dir"
  # QEMU returns once the machine starts, or fails if the port or the pidfile
  # is taken, and then runs on its own. running_pid tells it from any other
  # process by the image paths.
  qemu-system-x86_64 \
    -daemonize \
    -pidfile "$pidfile" \
    -machine q35 \
    -smp 6 \
    -m 4096M \
    -boot c \
    -vga none \
    -device virtio-gpu-pci,xres=360,yres=720,max_outputs=1,addr=08.0 \
    -display vnc=127.0.0.1:0 \
    -serial telnet:127.0.0.1:4444,server,nowait \
    -rtc base=utc,clock=host \
    -initrd "$image_dir/ramdisk.img" \
    -kernel "$image_dir/bzImage" \
    -drive if=none,file="$image_dir/updater.img",format=raw,file.locking=on,id=updater,index=0 \
    -device virtio-blk-pci,drive=updater \
    -drive if=none,file="$image_dir/system.img",format=raw,file.locking=on,id=system,index=1 \
    -device virtio-blk-pci,drive=system \
    -drive if=none,file="$image_dir/vendor.img",format=raw,file.locking=on,id=vendor,index=2 \
    -device virtio-blk-pci,drive=vendor \
    -drive if=none,file="$image_dir/userdata.img",format=raw,file.locking=on,id=userdata,index=3 \
    -device virtio-blk-pci,drive=userdata \
    -append "ip=dhcp loglevel=4 console=ttyS0,115200 init=init root=/dev/ram0 rw ohos.boot.hardware=x86_general ohos.required_mount.system=/dev/block/vdb@/usr@ext4@ro,barrier=1@wait,required ohos.required_mount.vendor=/dev/block/vdc@/vendor@ext4@ro,barrier=1@wait,required ohos.required_mount.misc=/dev/block/vda@/misc@none@none=@wait,required" \
    "${acceleration[@]}" \
    "${cpu[@]}" \
    -netdev "user,id=net0,hostfwd=tcp:$connect_key-:55555" \
    -device virtio-net-pci,netdev=net0
}

boot() {
  local attempt pid
  if ready; then
    echo "OpenHarmony emulator is ready at $connect_key."
    return 0
  fi
  if pid=$(running_pid); then
    echo "Waiting for the running OpenHarmony emulator."
  elif launch && pid=$(running_pid); then
    echo "Started OpenHarmony emulator as process $pid at $connect_key."
  # A launch that another session makes at the same moment fails here, and its
  # emulator is then the one to wait for.
  elif pid=$(running_pid); then
    echo "Waiting for the OpenHarmony emulator that another session started."
  else
    echo "OpenHarmony emulator did not start." >&2
    return 1
  fi
  for ((attempt = 0; attempt < 300; attempt++)); do
    if ready; then
      echo "OpenHarmony emulator is ready at $connect_key."
      return 0
    fi
    if ! running_pid >/dev/null; then
      echo "OpenHarmony emulator exited before it became ready." >&2
      return 1
    fi
    sleep 1
  done
  echo "OpenHarmony emulator did not become ready within 300 seconds." >&2
  return 1
}

stop() {
  local attempt pid
  if ! pid=$(running_pid); then
    echo "OpenHarmony emulator is not running."
    return 0
  fi
  # Disconnect hdc before QEMU closes the forwarded socket. This keeps the
  # listener port reusable when another suite starts the emulator immediately.
  hdc tconn "$connect_key" -remove >/dev/null 2>&1 || true
  kill "$pid" 2>/dev/null || return 0
  for ((attempt = 0; attempt < 30; attempt++)); do
    running_pid >/dev/null || return 0
    sleep 1
  done
  running_pid >/dev/null || return 0
  kill -KILL "$pid" 2>/dev/null || true
  rm -f "$pidfile"
}

case "$command" in
  boot) boot ;;
  stop) stop ;;
  key)
    ready || exit 1
    printf '%s\n' "$connect_key"
    ;;
  *)
    echo "usage: tools/devices/ohos-emulator boot|stop|key" >&2
    exit 2
    ;;
esac
