// https://dprint.dev
// dprint owns formatter routing. Prefer plugins where available and exec
// mise-installed formatters for languages without a dprint plugin.
{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 80,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  "excludes": [
    "third_party/**",
    ".github/workflows/ci-*.yml",
    ".github/workflows/_ci-*.yml",
    "**/*-lock.yaml",
    "**/*.lock.yaml",
    "**/*-lock.yml",
    "**/*.lock.yml",
    "uv.lock",
    "Cargo.lock",
    // Every .NET tool manifest is rewritten in the SDK's own style by the
    // command that updates it, Dependabot included, so formatting them turns
    // each tool update into a hygiene failure.
    "**/.config/dotnet-tools.json",
    "src/platform/rust/about.hbs",
    "gradlew",
    "gradlew.bat",
    // Oxc rejects the declaration-only style attribute in this logo.
    "docs/src/assets/maplibre-logo-square-for-light-bg.svg",
  ],
  "oxc": {
    "experimentalSortImports": { "newlinesBetween": true },
    "lineWidth": 80,
    "proseWrap": "always",
    "sortPackageJson": false,
  },
  "ruff": { "indentWidth": 4, "lineLength": 88 },
  "ktfmt": { "style": "google", "lineWidth": 100 },
  "googleJavaFormat": { "lineWidth": 100 },
  "csharpier": {
    // Bindgen formats the C# it generates as `*.g.cs`.
    "includeGenerated": true,
    "csharp.lineWidth": 100,
    "csharp.indentWidth": 4,
    "associations": [
      "!**/*.csproj",
      "!**/*.props",
      "!**/*.targets",
      "!**/*.slnx",
      "!**/*.config",
      "!**/*.xml",
      "!**/*.xaml",
      "!**/*.axaml",
      "!**/*.csx",
    ],
  },
  "gofumpt": {
    "langVersion": "go1.24",
    "modulePath": "github.com/maplibre/maplibre-native-ffi/bindings/go",
    "overrides": [
      {
        "files": ["examples/go-map/**"],
        "modulePath": "github.com/maplibre/maplibre-native-ffi/examples/go-map",
      },
    ],
  },
  "clangFormat": {
    "associations": ["**/*.inc"],
    "BasedOnStyle": "Google",
    "ColumnLimit": 80,
    "IndentWidth": 2,
    "ContinuationIndentWidth": 2,
    "UseCRLF": false,
    "UseTab": "Never",
    "AlignAfterOpenBracket": "BlockIndent",
    "IncludeBlocks": "Regroup",
    "IncludeCategories": [
      { "Regex": "^<[a-zA-Z0-9_]+>$", "Priority": -100 },
      { "Regex": "^<mln/.*>$", "Priority": -60 },
      { "Regex": "^<.*>$", "Priority": -50 },
      { "Regex": ".*", "Priority": 1 },
    ],
  },
  "exec": {
    "commands": [
      { "command": "bash .mise/bin/dprint-zig fmt --stdin", "exts": ["zig"] },
      {
        "command": "bash .mise/bin/dprint-zig fmt --stdin --zon",
        "exts": ["zon"],
      },
      { "command": "rustfmt --edition 2024", "exts": ["rs"] },
      {
        "command": "swiftformat stdin --stdin-path {{file_path}} --indent {{indent_width}} --max-width {{line_width}} --quiet",
        "exts": ["swift"],
      },
      {
        "command": "bash .mise/bin/dprint-mdxlint {{file_path}}",
        "exts": ["mdx"],
        "cacheKeyFiles": ["pnpm-lock.yaml"],
      },
    ],
  },
  "plugins": [
    "https://plugins.dprint.dev/clang-format-0.2.1.wasm",
    "https://plugins.dprint.dev/cmakefmt/cmakefmt-v2.3.0.wasm",
    "https://plugins.dprint.dev/exec-0.8.0.json@1f2dfbf5dec6d2e590b2c8b0ba6dbfaf80d0320fa9bd4c3f4f29efb99cd2bd6f",
    "https://plugins.dprint.dev/ruff-0.11.2.wasm",
    "https://plugins.dprint.dev/oxc-0.47.0.wasm",
    "https://plugins.dprint.dev/g-plane/markup_fmt-v0.27.6.wasm",
    "https://plugins.dprint.dev/sargunv/ktfmt-0.65.0.json@d355d4440dda00c0e315b5c39669f417bcfa76b64b68591fa1818f7a1f6b1005",
    "https://plugins.dprint.dev/sargunv/google-java-format-0.1.0.json@168697c8e19478c6492a5f9117d163f6241b26010d04946f8441a9236616486e",
    "https://plugins.dprint.dev/csharpier-0.1.1.wasm",
    "https://plugins.dprint.dev/jakebailey/gofumpt-v0.0.20.wasm",
  ],
}
