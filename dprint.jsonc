// https://dprint.dev
// dprint owns formatter routing. Prefer plugins where available and exec
// mise-installed formatters for languages without a dprint plugin.
{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 80,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  "excludes": [
    "third_party/**",
    ".github/workflows/ci.yml",
    "**/*-lock.yaml",
    "**/*.lock.yaml",
    "**/*-lock.yml",
    "**/*.lock.yml",
    "uv.lock",
    "Cargo.lock",
    // Every .NET tool manifest is rewritten in the SDK's own style by the
    // command that updates it, Dependabot included, so formatting them turns
    // each tool update into a hygiene failure.
    "**/.config/dotnet-tools.json",
    "src/platform/rust/about.hbs",
    "bindings/kotlin/src/jvmMain/generated/**",
    "gradlew",
    "gradlew.bat",
    "**/*.g.cs",
  ],
  "json": { "preferSingleLine": true },
  "markdown": { "textWrap": "always" },
  "oxc": { "experimentalSortImports": { "newlinesBetween": true } },
  "ruff": { "indentWidth": 4, "lineLength": 88 },
  "clangFormat": {
    "BasedOnStyle": "Google",
    "ColumnLimit": 80,
    "IndentWidth": 2,
    "ContinuationIndentWidth": 2,
    "UseCRLF": false,
    "UseTab": "Never",
    "AlignAfterOpenBracket": "BlockIndent",
    "IncludeBlocks": "Regroup",
    "IncludeCategories": [
      { "Regex": "^<[a-zA-Z0-9_]+>$", "Priority": -100 },
      { "Regex": "^<mln/.*>$", "Priority": -60 },
      { "Regex": "^<.*>$", "Priority": -50 },
      { "Regex": ".*", "Priority": 1 },
    ],
  },
  "exec": {
    "commands": [
      {
        "command": "bash .mise/bin/dprint-ktfmt --google-style - --stdin-name={{file_path}}",
        "exts": ["kt", "kts"],
      },
      {
        "command": "bash .mise/bin/dprint-java - --assume-filename {{file_path}}",
        "exts": ["java"],
      },
      {
        "command": "bash .mise/bin/dprint-csharpier {{file_path}}",
        "cwd": "${configDir}",
        "exts": ["cs"],
        "cacheKeyFiles": [".config/dotnet-tools.json"],
      },
      { "command": "bash .mise/bin/dprint-zig fmt --stdin", "exts": ["zig"] },
      {
        "command": "bash .mise/bin/dprint-zig fmt --stdin --zon",
        "exts": ["zon"],
      },
      { "command": "rustfmt --edition 2024", "exts": ["rs"] },
      { "command": "bash .mise/bin/dprint-go", "exts": ["go"] },
      {
        "command": "swiftformat stdin --stdin-path {{file_path}} --indent {{indent_width}} --max-width {{line_width}} --quiet",
        "exts": ["swift"],
      },
      {
        "command": "bash .mise/bin/dprint-mdxlint {{file_path}}",
        "exts": ["mdx"],
        "cacheKeyFiles": ["pnpm-lock.yaml"],
      },
    ],
  },
  "plugins": [
    "https://plugins.dprint.dev/sargunv/dprint-clang-format-0.1.0.wasm",
    "https://plugins.dprint.dev/sargunv/dprint-cmakefmt-0.1.0.wasm",
    "https://plugins.dprint.dev/exec-0.6.2.json@df98f54ffd3092b8a841aedd6d098a2651f16d0a796a40535774f1a8b4b9d463",
    "https://plugins.dprint.dev/ruff-0.7.0.wasm",
    "https://plugins.dprint.dev/oxc-0.20.0.wasm",
    "https://plugins.dprint.dev/json-0.21.3.wasm",
    "https://plugins.dprint.dev/markdown-0.21.1.wasm",
    "https://plugins.dprint.dev/toml-0.7.0.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
    "https://plugins.dprint.dev/g-plane/markup_fmt-v0.27.0.wasm",
    "https://plugins.dprint.dev/g-plane/malva-v0.15.3.wasm",
  ],
}
