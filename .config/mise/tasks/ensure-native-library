#!/usr/bin/env bash
set -euo pipefail

if [[ "${CI:-}" != "true" ]]; then
  exec mise run //:build
fi

if [[ ! -f "${MLN_BUILD_DIR}/pkgconfig/maplibre-native-c.pc" ]]; then
  echo "missing ${MLN_BUILD_DIR}/pkgconfig/maplibre-native-c.pc; native artifact was not downloaded" >&2
  exit 1
fi

found=false
for lib in "${MLN_BUILD_DIR}"/libmaplibre-native-c.*; do
  if [[ -f "$lib" ]]; then
    found=true
    break
  fi
done

if [[ "$found" != "true" ]]; then
  echo "missing ${MLN_BUILD_DIR}/libmaplibre-native-c.*; native artifact was not downloaded" >&2
  exit 1
fi
