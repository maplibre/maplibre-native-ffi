// https://dprint.dev
// dprint owns formatter routing. Prefer plugins where available and exec
// mise-installed formatters for languages without a dprint plugin.
{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 80,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  // Patterns with a directory component are relative to this config file.
  "excludes": [
    "../third_party/**",
    "../.github/workflows/ci-*.yml",
    "../.github/workflows/_ci-*.yml",
    "**/*-lock.yaml",
    "**/*.lock.yaml",
    "**/*-lock.yml",
    "**/*.lock.yml",
    "uv.lock",
    "Cargo.lock",
    // Every .NET tool manifest is rewritten in the SDK's own style by the
    // command that updates it, Dependabot included, so formatting them turns
    // each tool update into a hygiene failure.
    "**/.config/dotnet-tools.json",
    "gradlew",
    "gradlew.bat",
    // Oxc rejects the declaration-only style attribute in this logo.
    "../docs/src/assets/maplibre-logo-square-for-light-bg.svg",
    // Bindgen probe fixtures are inputs that the Dart formatter must not
    // rewrite.
    "../tests/bindgen/fixtures/probes/dart/**",
    // Bindgen copies MapLibre Native's plugin header as upstream wrote it.
    "../include/mln/**",
  ],
  // Docs snippets wrap at 70 columns, so they fit the docs site's code
  // blocks. Go and Zig formatters don't wrap lines.
  "oxc": {
    "experimentalSortImports": { "newlinesBetween": true },
    "lineWidth": 80,
    "proseWrap": "always",
    "sortPackageJson": false,
    "overrides": [{ "files": "**/docsnippets/**", "lineWidth": 70 }],
  },
  // Prettier is the last plugin, so it formats only the types that no plugin
  // above claims, MDX among them.
  "prettier": { "proseWrap": "always" },
  "ruff": {
    "indentWidth": 4,
    "lineLength": 88,
    "overrides": [{ "files": "**/docsnippets/**", "lineLength": 70 }],
  },
  "ktfmt": {
    "style": "google",
    "lineWidth": 100,
    "overrides": [{ "files": "**/docsnippets/**", "lineWidth": 70 }],
  },
  "googleJavaFormat": {
    "lineWidth": 100,
    "overrides": [{ "files": "**/docsnippets/**", "lineWidth": 70 }],
  },
  "csharpier": {
    // Bindgen formats the C# it generates as `*.g.cs`.
    "includeGenerated": true,
    "csharp.lineWidth": 100,
    "csharp.indentWidth": 4,
    "overrides": [{ "files": "**/DocSnippets/**", "csharp.lineWidth": 70 }],
    "associations": [
      "!**/*.csproj",
      "!**/*.props",
      "!**/*.targets",
      "!**/*.slnx",
      "!**/*.config",
      "!**/*.xml",
      "!**/*.xaml",
      "!**/*.axaml",
      "!**/*.csx",
    ],
  },
  "gofumpt": {
    "langVersion": "go1.26",
    "modulePath": "maplibre.org/maplibre-native-ffi",
  },
  "clangFormat": {
    "associations": ["**/*.inc"],
    "BasedOnStyle": "Google",
    "ColumnLimit": 80,
    "IndentWidth": 2,
    "ContinuationIndentWidth": 2,
    "UseCRLF": false,
    "UseTab": "Never",
    "AlignAfterOpenBracket": "BlockIndent",
    "IncludeBlocks": "Regroup",
    "overrides": [
      { "files": "**/docsnippets/**", "ColumnLimit": 70 },
      // g-ir-scanner reads a gtk-doc annotation only from a single line.
      { "files": "**/gobject/src/**", "ReflowComments": false },
    ],
    "IncludeCategories": [
      { "Regex": "^<[a-zA-Z0-9_]+>$", "Priority": -100 },
      { "Regex": "^<mln/.*>$", "Priority": -60 },
      { "Regex": "^<.*>$", "Priority": -50 },
      { "Regex": ".*", "Priority": 1 },
    ],
  },
  "exec": {
    // Only the first matching command formats a file, so the docs snippet
    // commands come before the general ones.
    "associations": [
      "**/*.zig",
      "**/*.zon",
      "**/*.dart",
      "**/*.rs",
      "**/*.swift",
    ],
    "commands": [
      {
        "command": "rustfmt --edition 2024 --config max_width=70",
        "associations": ["**/maplibre-native-ffi/examples/**/*.rs"],
      },
      {
        "command": "bash .mise/bin/dprint-dart format --output=show --page-width=70 --stdin-name={{file_path}}",
        "associations": ["**/docsnippets/**/*.dart"],
      },
      {
        "command": "swiftformat stdin --stdin-path {{file_path}} --indent {{indent_width}} --max-width 70 --quiet",
        "associations": ["**/DocSnippets/**/*.swift"],
      },
      { "command": "zig fmt --stdin", "exts": ["zig"] },
      { "command": "zig fmt --stdin --zon", "exts": ["zon"] },
      {
        "command": "bash .mise/bin/dprint-dart format --output=show --stdin-name={{file_path}}",
        "exts": ["dart"],
      },
      { "command": "rustfmt --edition 2024", "exts": ["rs"] },
      {
        "command": "swiftformat stdin --stdin-path {{file_path}} --indent {{indent_width}} --max-width {{line_width}} --quiet",
        "exts": ["swift"],
      },
    ],
  },
  "plugins": [
    "npm:@dprint/clang-format@0.3.0",
    "https://plugins.dprint.dev/cmakefmt/cmakefmt-v2.4.0.wasm",
    "npm:@dprint/exec@0.9.0/plugin.json@d4f708dc00798b51013ca4e7c26a86656bfb31e7255cdcde28a487f86813e34d",
    "npm:@dprint/ruff@0.12.1",
    "npm:@dprint/oxc@0.49.1",
    "npm:dprint-plugin-markup@0.27.6",
    "https://plugins.dprint.dev/sargunv/ktfmt-0.65.0.json@d355d4440dda00c0e315b5c39669f417bcfa76b64b68591fa1818f7a1f6b1005",
    "https://plugins.dprint.dev/sargunv/google-java-format-0.1.0.json@168697c8e19478c6492a5f9117d163f6241b26010d04946f8441a9236616486e",
    "npm:@dprint/csharpier@0.2.0",
    "npm:@jakebailey/dprint-plugin-gofumpt@0.0.20",
    "https://plugins.dprint.dev/prettier-0.72.0.json@6e7af2cb2182a5a11358d3adde9ae0ef3b94b7d2e5dcfdd252e3f7c3916541fe",
  ],
}
