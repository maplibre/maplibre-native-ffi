#!/usr/bin/env bash
#MISE description="Combine the Apple Metal native packages into the XCFramework zip, and check every slice."
#MISE shell="bash"
#USAGE arg "[input]" default="build/packages/native/dist" help="Directory that holds the Apple Metal native packages"

set -euo pipefail

input_root="${usage_input?}"
output="${MISE_MONOREPO_ROOT}/build/packages/native/dist/MaplibreNativeC.xcframework.zip"
presets="$(python3 -m tools.ci.plan --package-inputs apple-xcframework)"

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

while IFS= read -r preset; do
  archive="$(find "$input_root" -type f -name "maplibre-native-c-${preset}.tar.gz" -print -quit)"
  if [[ -z "$archive" ]]; then
    echo "Missing native package for ${preset} under ${input_root}" >&2
    exit 1
  fi
  # bsdtar restores AppleDouble sidecars as extended attributes.
  tar -xzf "$archive" -C "$work"
done <<< "$presets"

macos="$work/maplibre-native-c-macos-arm64-metal/Frameworks/MaplibreNativeC.framework"
intel="$work/maplibre-native-c-macos-x64-metal/Frameworks/MaplibreNativeC.framework"
lipo -create "$macos/MaplibreNativeC" "$intel/MaplibreNativeC" \
  -output "$macos/Versions/A/MaplibreNativeC"
lipo -create "$macos.dSYM/Contents/Resources/DWARF/MaplibreNativeC" \
  "$intel.dSYM/Contents/Resources/DWARF/MaplibreNativeC" \
  -output "$macos.dSYM/Contents/Resources/DWARF/MaplibreNativeC"
python3 - "$macos" "$intel" <<'PY'
import json
import sys
from pathlib import Path

from tools.release.sbom import component, compose, write_json

inventories = [
    json.loads((Path(framework) / "Resources/sbom.cdx.json").read_text())
    for framework in sys.argv[1:]
]
root = component(
    "MaplibreNativeC.framework",
    inventories[0]["metadata"]["component"]["version"],
    "BSD-2-Clause",
)
root["group"] = "org.maplibre.nativeffi"
write_json(Path(sys.argv[1]) / "Resources/sbom.cdx.json", compose(root, inventories))
PY

# Each slice must import cleanly as a module and link, and the macOS and Mac
# Catalyst slices also run.
cat >"$work/consumer.m" <<'EOF'
@import MaplibreNativeC;
@import MaplibreNativeC.Plugin;

int main(void) { return mln_plugin_get_register_function_v1() == NULL; }
EOF

frameworks=()
while IFS= read -r preset; do
  variant=
  case "${preset%-*-*}" in
    ios) sdk=iphoneos; os=ios ;;
    ios-maccatalyst) sdk=macosx; os=ios; variant=macabi ;;
    ios-simulator) sdk=iphonesimulator; os=ios; variant=simulator ;;
    macos) sdk=macosx; os=macos ;;
    tvos) sdk=appletvos; os=tvos ;;
    tvos-simulator) sdk=appletvsimulator; os=tvos; variant=simulator ;;
    visionos) sdk=xros; os=xros ;;
    visionos-simulator) sdk=xrsimulator; os=xros; variant=simulator ;;
    *) echo "Missing XCFramework SDK mapping for $preset" >&2; exit 1 ;;
  esac
  arch="${preset%-*}"
  arch="${arch##*-}"
  [[ "$arch" != x64 ]] || arch=x86_64
  framework="$work/maplibre-native-c-${preset}/Frameworks/MaplibreNativeC.framework"
  if [[ "$preset" == macos-x64-metal ]]; then
    framework="$macos"
  else
    frameworks+=(-framework "$framework" -debug-symbols "$framework.dSYM")
  fi

  minimum="$(vtool -arch "$arch" -show-build "$framework/MaplibreNativeC" | awk '$1 == "minos" { print $2 }')"
  xcrun --sdk "$sdk" clang -target "${arch}-apple-${os}${minimum}${variant:+-$variant}" \
    -fmodules -fmodules-cache-path="$work/module-cache" \
    -Werror -Wall -Wincomplete-umbrella \
    -F "${framework%/*}" -framework MaplibreNativeC -Wl,-rpath,"${framework%/*}" \
    "$work/consumer.m" -o "$work/consumer-${preset}"
  if [[ "$sdk" == macosx ]]; then
    "$work/consumer-${preset}"
  fi
  echo "Checked ${preset}"
done <<< "$presets"

xcframework="$work/MaplibreNativeC.xcframework"
xcodebuild -create-xcframework "${frameworks[@]}" -output "$xcframework"
mkdir -p "$(dirname "$output")"
rm -f "$output"
# Swift Package Manager expects the XCFramework at the zip's root, and ditto
# keeps the macOS symlinks.
ditto -c -k --norsrc --noextattr --keepParent "$xcframework" "$output"
echo "$output"
