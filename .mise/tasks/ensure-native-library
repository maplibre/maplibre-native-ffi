#!/usr/bin/env python
import json
import os
import subprocess
import sys


def validate_metadata(metadata_path: str) -> int:
    if not os.path.isfile(metadata_path):
        print(f"missing native metadata: {metadata_path}", file=sys.stderr)
        return 1

    with open(metadata_path, encoding="utf-8") as metadata_file:
        metadata = json.load(metadata_file)

    core_library_path = metadata.get("core_library_path")
    if not core_library_path:
        print(f"{metadata_path} is missing core_library_path", file=sys.stderr)
        return 1
    if not os.path.isfile(core_library_path):
        print(f"missing native core library: {core_library_path}", file=sys.stderr)
        return 1

    import_library_path = metadata.get("windows_import_library_path")
    if import_library_path and import_library_path != core_library_path:
        if not os.path.isfile(import_library_path):
            print(f"missing Windows import library: {import_library_path}", file=sys.stderr)
            return 1

    return 0


def main() -> int:
    metadata_path = os.path.join(
        os.environ["MLN_FFI_BUILD_DIR"],
        "maplibre-native-c.dev.json",
    )
    if os.environ.get("CI") != "true":
        build_status = subprocess.call(["mise", "run", "//:build"])
        if build_status != 0:
            return build_status

    return validate_metadata(metadata_path)


if __name__ == "__main__":
    raise SystemExit(main())
