#!/usr/bin/env python3
# [MISE] description="Verify snapshot component scopes classify every tracked path."
# [MISE] shell="python"

import pathlib
import sys


ROOT = pathlib.Path(__file__).resolve().parents[3]
sys.path.insert(0, str(ROOT))

from ci.snapshots import CONFIG, check_scopes  # noqa: E402


def main() -> int:
    problems = check_scopes(ROOT)
    if not problems:
        return 0
    for problem in problems:
        print(f"error: {problem}", file=sys.stderr)
    print(
        f"\nClassify every tracked path in {CONFIG.as_posix()}: add it to `shared` "
        "or to a component's `paths`, prefixed with `!` when it feeds no published "
        "artifact, and drop rules that match nothing.",
        file=sys.stderr,
    )
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
