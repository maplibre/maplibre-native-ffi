#!/usr/bin/env bash
#MISE description="Install the dependency group requested by CI."

set -euo pipefail

project="${1:-all}"

if [[ "$project" == "all" || "$project" == "hygiene" ]]; then
  MISE_NO_HOOKS=1 mise install
else
    if [[ "$project" == "android" ]]; then
      tools=(java rust)
  else
    tools=(rust)
  fi

  zig_tool=zig
  if [[ "${RUNNER_OS:-}" == "Windows" && "${RUNNER_ARCH:-}" == "ARM64" ]]; then
    zig_tool=http:zig
  fi

  case "$project" in
    android)
      ;;
    kotlin)
      tools+=(java)
      ;;
    docs)
      tools+=(node aqua:pnpm/pnpm "$zig_tool")
      ;;
    dotnet)
      tools+=(dotnet)
      ;;
    go)
      tools+=(go)
      ;;
    native)
      tools+=("$zig_tool")
      ;;
    openharmony)
      tools+=(node aqua:pnpm/pnpm)
      ;;
    package)
      ;;
    python)
      tools+=(python aqua:astral-sh/uv)
      ;;
    rust)
      ;;
    swift)
      if [[ "${RUNNER_OS:-}" == "Linux" ]]; then
        tools+=(swift)
      fi
      ;;
    zig)
      tools+=("$zig_tool")
      ;;
    *)
      echo "Unknown CI dependency group: $project" >&2
      exit 2
      ;;
  esac

  MISE_NO_HOOKS=1 mise install "${tools[@]}"
fi

if [[ "$project" != "hygiene" ]]; then
  mise run sync-submodules
fi
