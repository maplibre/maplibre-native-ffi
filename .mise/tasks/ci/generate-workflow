#!/usr/bin/env python3
# MISE description="Generate the GitHub Actions CI workflow."

import argparse
import difflib
import json
import pathlib
import sys
import tomllib


ROOT = pathlib.Path(__file__).resolve().parents[3]
SOURCE = ROOT / "ci" / "workflow.toml"
PRESETS = ROOT / "CMakePresets.json"
OUTPUT = ROOT / ".github" / "workflows" / "ci.yml"
CHECKOUT = "actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v4.3.1"
UPLOAD = "actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1"
DESKTOP = {"linux", "macos", "windows"}


def platform(preset: str) -> str:
    return preset.split("-", 1)[0]


def scalar(value: object) -> str:
    if isinstance(value, bool):
        return str(value).lower()
    return str(value)


def matrix(rows: list[dict[str, object]], indent: int = 8) -> list[str]:
    lines = [" " * indent + "include:"]
    for row in rows:
        first, *rest = row.items()
        key, value = first
        lines.append(" " * (indent + 2) + f"- {key}: {scalar(value)}")
        lines.extend(
            " " * (indent + 4) + f"{key}: {scalar(value)}" for key, value in rest
        )
    return lines


def setup(project: str) -> list[str]:
    return [
        f"      - uses: {CHECKOUT}",
        "        with:",
        "          persist-credentials: false",
        "      - uses: ./.github/actions/setup-ci-deps",
        "        with:",
        f"          project: {project}",
        "          target: ${{ matrix.preset }}",
        "          backend: ${{ matrix.backend }}",
        "          graphics: ${{ matrix.graphics }}",
        "          platform-sdk: ${{ matrix.platform-sdk }}",
    ]


def validate(source: dict[str, object], presets: dict[str, object]) -> None:
    targets = source["targets"]
    names = [target["preset"] for target in targets]
    if len(names) != len(set(names)):
        raise SystemExit("error: duplicate target in ci/workflow.toml")
    configured = {
        preset["name"]
        for preset in presets["configurePresets"]
        if not preset.get("hidden", False)
    }
    if set(names) != configured:
        raise SystemExit(
            f"error: CI targets differ from CMake configure presets: "
            f"missing={sorted(configured - set(names))}, extra={sorted(set(names) - configured)}"
        )
    packaged = {preset["name"] for preset in presets.get("packagePresets", [])}
    selected = {target["preset"] for target in targets if target["package"]}
    if selected != packaged:
        raise SystemExit(
            f"error: CI package targets differ from CMake package presets: "
            f"missing={sorted(packaged - selected)}, extra={sorted(selected - packaged)}"
        )


def render(source: dict[str, object]) -> str:
    targets = source["targets"]
    suites = source["suites"]
    job_ids = ["hygiene", "docs", "native", "android"] + [
        suite["id"] for suite in suites
    ] + ["package"]
    lines = [
        "# Generated by `mise run ci:generate-workflow`. Do not edit directly.",
        "name: CI",
        "",
        "on:",
        "  push:",
        "    branches:",
        "      - main",
        "  pull_request:",
        "    branches:",
        "      - main",
        "",
        "permissions:",
        "  contents: read",
        "",
        "concurrency:",
        "  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}",
        "  cancel-in-progress: ${{ github.event_name == 'pull_request' }}",
        "",
        "jobs:",
        "  hygiene:",
        "    name: hygiene",
        "    runs-on: ubuntu-latest",
        "    timeout-minutes: 30",
        "    steps:",
        f"      - uses: {CHECKOUT}",
        "        with:",
        "          persist-credentials: false",
        "      - uses: ./.github/actions/setup-ci-deps",
        "        with:",
        "          project: hygiene",
        "          target: linux-x64",
        "          backend: vulkan",
        "          graphics: none",
        "          platform-sdk: none",
        "      - run: mise run ci:generate-workflow --check",
        "      - run: mise run format-deps",
        "      - run: mise run //docs:install",
        "      - run: dprint output-resolved-config > /dev/null",
        "      - run: hk fix --all",
        "      - name: Check generated and formatted files",
        "        run: |",
        "          git update-index -q --refresh",
        "          git diff --exit-code -- . ':(exclude)mise.lock'",
        "          git diff --cached --exit-code -- . ':(exclude)mise.lock'",
        "",
        "  docs:",
        "    name: docs",
        "    runs-on: ubuntu-latest",
        "    timeout-minutes: 60",
        "    steps:",
        f"      - uses: {CHECKOUT}",
        "        with:",
        "          persist-credentials: false",
        "      - uses: ./.github/actions/setup-ci-deps",
        "        with:",
        "          project: docs",
        "          target: linux-x64",
        "          backend: vulkan",
        "          graphics: none",
        "          platform-sdk: none",
        "      - run: mise run //docs:build",
        "",
        "  native:",
        "    name: native / ${{ matrix.preset }}",
        "    runs-on: ${{ matrix.runner }}",
        "    timeout-minutes: 120",
        "    strategy:",
        "      fail-fast: false",
        "      matrix:",
        *matrix(
            [
                {
                    "preset": target["preset"],
                    "runner": target["runner"],
                    "backend": target["backend"],
                    "graphics": target["graphics"],
                    "platform-sdk": target["platform_sdk"],
                    "test": target["test"],
                }
                for target in targets
            ]
        ),
        "    steps:",
        *setup("${{ matrix.platform-sdk == 'ohos' && 'openharmony' || matrix.platform-sdk == 'android' && 'android' || 'native' }}"),
        "      - name: Validate native target",
        "        if: ${{ matrix.platform-sdk != 'ohos' }}",
        "        run: mise run build ${{ matrix.preset }}",
        "      - name: Test native target",
        "        if: ${{ matrix.test }}",
        "        run: mise run test ${{ matrix.preset }}",
        "      - name: Build OpenHarmony Rust binding",
        "        if: ${{ matrix.platform-sdk == 'ohos' }}",
        "        run: mise run //bindings/rust:build:ohos ${{ matrix.preset }}",
        "      - name: Build iOS Swift binding",
        "        if: ${{ matrix.platform-sdk == 'ios' }}",
        "        run: mise run //bindings/swift:build:ios",
        "      - name: Build iOS Swift example",
        "        if: ${{ matrix.platform-sdk == 'ios' }}",
        "        run: mise run //examples/swift-map:build:ios",
        "      - name: Build iOS simulator Swift binding",
        "        if: ${{ matrix.platform-sdk == 'ios-simulator' }}",
        "        run: mise run //bindings/swift:build:ios-simulator",
        "      - name: Test iOS simulator Zig binding",
        "        if: ${{ matrix.platform-sdk == 'ios-simulator' }}",
        "        run: mise run //bindings/zig:test:ios-simulator",
        "      - name: Test iOS simulator Swift binding",
        "        if: ${{ matrix.platform-sdk == 'ios-simulator' }}",
        "        run: >-",
        "          bash scripts/run-ios-simulator-test.sh",
        "          bindings/swift/.build/ios-simulator/arm64-apple-ios-simulator/debug/MaplibreNativeIOSSimulatorTests",
        "          120",
        "      - name: Build iOS simulator Swift example",
        "        if: ${{ matrix.platform-sdk == 'ios-simulator' }}",
        "        run: mise run //examples/swift-map:build:ios-simulator",
        "",
        "  android:",
        "    name: android / ${{ matrix.target }}",
        "    runs-on: ubuntu-latest",
        "    timeout-minutes: 120",
        "    strategy:",
        "      fail-fast: false",
        "      matrix:",
        *matrix(source["android"]),
        "    steps:",
        f"      - uses: {CHECKOUT}",
        "        with:",
        "          persist-credentials: false",
        "      - uses: ./.github/actions/setup-ci-deps",
        "        with:",
        "          project: android",
        "          target: ${{ matrix.target }}",
        "          backend: ${{ matrix.backend }}",
        "          graphics: none",
        "          platform-sdk: android",
        "      - name: Build Kotlin Android binding",
        "        run: >-",
        "          mise run //bindings/kotlin:androidBuild --",
        "          -Pmaplibre.android.abis=${{ matrix.abi }}",
        "          -Pmaplibre.android.backend=${{ matrix.backend }}",
        "      - name: Build Android map",
        "        if: ${{ matrix.build_map }}",
        "        run: >-",
        "          mise run //examples/android-map:build --",
        "          -Pmaplibre.android.abis=${{ matrix.abi }}",
        "          -Pmaplibre.android.backend=${{ matrix.backend }}",
        "",
    ]

    for suite in suites:
        rows = []
        for target in targets:
            preset = target["preset"]
            if platform(preset) not in suite["platforms"]:
                continue
            commands = []
            for command in suite["commands"]:
                if command.get("platforms") and platform(preset) not in command["platforms"]:
                    continue
                if command.get("include") and preset not in command["include"]:
                    continue
                if preset in command.get("exclude", []):
                    continue
                commands.append(command["task"])
            rows.append(
                {
                    "preset": preset,
                    "runner": target["runner"],
                    "backend": target["backend"],
                    "graphics": target["graphics"],
                    "platform-sdk": target["platform_sdk"],
                    "commands": " && ".join(
                        f"mise run {task} {preset}" for task in commands
                    ),
                }
            )
        lines.extend(
            [
                f"  {suite['id']}:",
                f"    name: {suite['id']} / ${{{{ matrix.preset }}}}",
                "    runs-on: ${{ matrix.runner }}",
                "    timeout-minutes: 90",
                "    strategy:",
                "      fail-fast: false",
                "      matrix:",
                *matrix(rows),
                "    steps:",
                *setup(suite["project"]),
                "      - run: ${{ matrix.commands }}",
                "",
            ]
        )

    package_targets = [target for target in targets if target["package"]]
    lines.extend(
        [
            "  package:",
            "    name: package / ${{ matrix.preset }}",
            "    runs-on: ${{ matrix.runner }}",
            "    timeout-minutes: 120",
            "    strategy:",
            "      fail-fast: false",
            "      matrix:",
            *matrix(
                [
                    {
                        "preset": target["preset"],
                        "runner": target["runner"],
                        "backend": target["backend"],
                        "graphics": target["graphics"],
                        "platform-sdk": target["platform_sdk"],
                    }
                    for target in package_targets
                ]
            ),
            "    steps:",
            *setup("package"),
            "      - run: mise run package-native ${{ matrix.preset }}",
            f"      - uses: {UPLOAD}",
            "        with:",
            "          name: native-package-${{ matrix.preset }}-${{ github.sha }}",
            "          path: build/packages/native/dist/maplibre-native-c-${{ matrix.preset }}.tar.gz",
            "          if-no-files-found: error",
            "",
            "  required:",
            "    name: ci-required",
            "    runs-on: ubuntu-latest",
            "    timeout-minutes: 5",
            "    if: ${{ always() }}",
            "    needs:",
            *[f"      - {job_id}" for job_id in job_ids],
            "    steps:",
            "      - name: Fail if required jobs failed",
            "        if: ${{ contains(needs.*.result, 'failure') || contains(needs.*.result, 'cancelled') || contains(needs.*.result, 'skipped') }}",
            "        run: |",
            "          echo '${{ toJSON(needs) }}'",
            "          exit 1",
            '      - run: "true"',
            "",
        ]
    )
    return "\n".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()
    with SOURCE.open("rb") as file:
        source = tomllib.load(file)
    presets = json.loads(PRESETS.read_text())
    validate(source, presets)
    expected = render(source)
    actual = OUTPUT.read_text() if OUTPUT.exists() else ""
    if args.check:
        if actual == expected:
            return 0
        sys.stderr.writelines(
            difflib.unified_diff(
                actual.splitlines(keepends=True),
                expected.splitlines(keepends=True),
                fromfile=str(OUTPUT),
                tofile=f"{OUTPUT} (generated)",
            )
        )
        return 1
    OUTPUT.write_text(expected)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
