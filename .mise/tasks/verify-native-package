#!/usr/bin/env python3
# [MISE] description="Reject private exports, build-host paths, and vendored loaders or headers in a native package."
# [MISE] shell="python"
# USAGE arg "<preset>" help="Native CMake preset"

"""Check what a packaged native artifact depends on and what it carries.

A dependency recorded by absolute path resolves against the build host's
layout, so an artifact carrying one loads on the machine that produced it and
nowhere else. Package managers make this easy to get wrong: Homebrew's Vulkan
loader, for one, has an absolute install name, and linking it is enough to
stamp `/opt/homebrew/opt/...` into the result.

A graphics loader is the host's to supply, and the library resolves one at run
time rather than linking it. An artifact that names or carries a loader anyway
runs a second copy alongside the host's, and handles minted by one are opaque
pointers the other does not own. Android and OpenHarmony are the exception,
where the loader is part of the platform at a fixed location.

The headers a host builds surface descriptors against belong to that same
implementation. An artifact carrying its own copy redistributes a snapshot that
can disagree with the implementation a host actually loads, so the package holds
the C API's headers and nothing else.
"""

from __future__ import annotations

import os
import pathlib
import re
import subprocess
import sys
import tarfile
import tempfile


# Load commands may name the system libraries every macOS host has at a fixed
# location, or resolve relative to the loading binary.
MACHO_ALLOWED_PREFIXES = (
    "@rpath/",
    "@loader_path/",
    "@executable_path/",
    "/usr/lib/",
    "/System/Library/",
)
# Search paths anchor to the loading binary, either exactly or as the root of a
# relative path, so the bundle stays relocatable.
MACHO_SEARCH_PATH_ROOTS = ("@loader_path", "@executable_path")
ELF_SEARCH_PATH_ROOTS = ("$ORIGIN", "${ORIGIN}")

# 64- and 32-bit thin Mach-O, then the 32- and 64-bit universal headers.
MACHO_MAGICS = frozenset(
    {b"\xcf\xfa\xed\xfe", b"\xce\xfa\xed\xfe", b"\xca\xfe\xba\xbe", b"\xca\xfe\xba\xbf"}
)
PE_MAGIC = b"MZ"

# A path may contain spaces, so it runs to the trailing offset field, which
# otool always prints. Anything narrower drops the build-host paths that live
# under a home directory holding a full name.
MACHO_NAME = re.compile(r"^\s*name (?P<name>.+) \(offset \d+\)$")
MACHO_PATH = re.compile(r"^\s*path (?P<path>.+) \(offset \d+\)$")
MACHO_COMMAND = re.compile(r"^\s*cmd (?P<command>LC_\w+)$")
ELF_ENTRY = re.compile(r"^\s*0x[0-9a-f]+\s+\((?P<tag>\w+)\)\s+.*\[(?P<value>[^\]]*)\]")
PE_EXPORT = re.compile(r"^\s*Name: (?P<name>\S+)$")

# The name a loader goes by, without the `lib` prefix, the version, and the
# extension: `libGLESv2.so.2`, `libvulkan.1.dylib`, and `@rpath/libEGL.dylib`
# all reduce to one of these.
LOADER_NAMES = frozenset(
    {
        "egl",
        "gl",
        "glesv1_cm",
        "glesv2",
        "glesv3",
        "moltenvk",
        "opengl",
        "vulkan",
        "vulkan-1",
    }
)
# Frameworks under these roots, Metal and OpenGL among them, are the platform's
# own graphics APIs, which every host reaches at the same fixed path.
PLATFORM_LIBRARY_PREFIXES = ("/System/Library/", "/usr/lib/")
# The presets whose loader ships with the operating system rather than with a
# host, and so is linked on purpose.
PLATFORM_LOADER_PRESETS = ("android-", "ohos-")
PACKAGED_LIBRARY_STEM = "maplibre-native-c"
# What the include directory holds: the umbrella header and the domain headers
# beside it.
PACKAGED_HEADER_ENTRIES = frozenset({"maplibre_native_c.h", "maplibre_native_c"})

BUILD_HOST_PATH = "names a build-host path"
PRIVATE_EXPORT = "exports a private symbol"
LINKED_LOADER = "links a graphics loader"
VENDORED_LOADER = "carries a library that is not the C API"
VENDORED_HEADER = "carries a header that is not the C API's"
REMEDIES = {
    BUILD_HOST_PATH: (
        "The package only loads on hosts that reproduce the paths above. "
        "Resolve the dependency at runtime, or give it a relocatable install "
        "name and ship it in the package."
    ),
    PRIVATE_EXPORT: (
        "Only the stable C API belongs in the dynamic symbol table. Hide the "
        "dependency symbol above or add a public mln_* entry point instead."
    ),
    LINKED_LOADER: (
        "The package pulls a graphics loader along wherever it is repackaged, "
        "and a host that loads its own then runs two. Resolve the entry points "
        "at runtime, the way src/render/opengl/egl_dispatch.cpp does, and link "
        "the loader into the test harness alone."
    ),
    VENDORED_LOADER: (
        "A host supplies its own graphics loader, so the package carries the C "
        "API and nothing else that loads. Install a local stand-in through the "
        "loader component instead, which stays out of the artifact."
    ),
    VENDORED_HEADER: (
        "A host supplies its own graphics implementation, and its headers come "
        "with it, so the package carries the C API's headers and nothing else. "
        "Install a local stand-in through the loader component instead, which "
        "stays out of the artifact."
    ),
}


def run(command: list[str]) -> str:
    result = subprocess.run(command, capture_output=True, text=True, check=False)
    if result.returncode != 0:
        raise SystemExit(
            f"{command[0]} failed for {command[-1]}:\n{result.stderr.strip()}"
        )
    return result.stdout


def anchored(path: str, roots: tuple[str, ...]) -> bool:
    """Whether a search path resolves against the binary that loads it."""
    return any(path == root or path.startswith(f"{root}/") for root in roots)


def loader_dependency(dependency: str) -> bool:
    """Whether a dependency names a graphics loader rather than a host library."""
    if dependency.startswith(PLATFORM_LIBRARY_PREFIXES):
        return False
    leaf = dependency.rsplit("/", 1)[-1]
    return leaf.removeprefix("lib").split(".", 1)[0].lower() in LOADER_NAMES


def macho_problems(binary: pathlib.Path, links_loader: bool) -> list[tuple[str, str]]:
    """Dependencies and run paths from the Mach-O load commands."""
    problems = []
    command = ""
    for line in run(["otool", "-l", str(binary)]).splitlines():
        match = MACHO_COMMAND.match(line)
        if match:
            command = match.group("command")
            continue
        if command.endswith("_DYLIB"):
            name = MACHO_NAME.match(line)
            if not name:
                continue
            dependency = name.group("name")
            # LC_ID_DYLIB names the library itself, which install_name_dir
            # already pins to @rpath, so it goes through the same check.
            if not dependency.startswith(MACHO_ALLOWED_PREFIXES):
                problems.append((BUILD_HOST_PATH, f"{command} {dependency}"))
            elif not links_loader and loader_dependency(dependency):
                problems.append((LINKED_LOADER, f"{command} {dependency}"))
        elif command == "LC_RPATH":
            path = MACHO_PATH.match(line)
            if path and not anchored(path.group("path"), MACHO_SEARCH_PATH_ROOTS):
                problems.append((BUILD_HOST_PATH, f"LC_RPATH {path.group('path')}"))
    return problems


def elf_problems(binary: pathlib.Path, links_loader: bool) -> list[tuple[str, str]]:
    """Needed libraries and search paths from the ELF dynamic section."""
    problems = []
    for line in run(["readelf", "--dynamic", "--wide", str(binary)]).splitlines():
        match = ELF_ENTRY.match(line)
        if not match:
            continue
        tag, value = match.group("tag"), match.group("value")
        # A needed library is a soname the dynamic loader resolves through the
        # host's own search path; one carrying a directory bypasses it.
        if tag == "NEEDED" and "/" in value:
            problems.append((BUILD_HOST_PATH, f"DT_NEEDED {value}"))
        elif tag == "NEEDED" and not links_loader and loader_dependency(value):
            problems.append((LINKED_LOADER, f"DT_NEEDED {value}"))
        elif tag in {"RPATH", "RUNPATH"}:
            problems.extend(
                (BUILD_HOST_PATH, f"DT_{tag} {entry}")
                for entry in value.split(":")
                if entry and not anchored(entry, ELF_SEARCH_PATH_ROOTS)
            )
    return problems


def pe_problems(binary: pathlib.Path) -> list[tuple[str, str]]:
    """Exports from a Windows library's PE export directory."""
    exports = (
        match.group("name")
        for line in run(["llvm-readobj", "--coff-exports", str(binary)]).splitlines()
        if (match := PE_EXPORT.match(line))
    )
    return [(PRIVATE_EXPORT, name) for name in exports if not name.startswith("mln_")]


def vendored_header(relative: pathlib.PurePath) -> bool:
    """Whether a packaged path is a header the C API does not own."""
    parts = relative.parts
    if "include" not in parts:
        return False
    entry = parts[parts.index("include") + 1]
    # An archive built on macOS carries an AppleDouble sidecar beside each file,
    # which belongs to whatever it sits next to.
    return entry.removeprefix("._") not in PACKAGED_HEADER_ENTRIES


def image_format(binary: pathlib.Path) -> str | None:
    """The executable format of a file, or None for one that does not load.

    Static archives and import libraries answer None, and so do the AppleDouble
    sidecars that an archive built on macOS carries beside each file.
    """
    with binary.open("rb") as file:
        magic = file.read(4)
    if magic == b"\x7fELF":
        return "elf"
    if magic in MACHO_MAGICS:
        return "macho"
    if magic.startswith(PE_MAGIC):
        return "pe"
    return None


def binary_problems(
    binary: pathlib.Path, image: str, links_loader: bool
) -> list[tuple[str, str]]:
    if image == "elf":
        return elf_problems(binary, links_loader)
    if image == "macho":
        # otool reads every slice of a universal binary, whose header is
        # big-endian on disk.
        return macho_problems(binary, links_loader)
    # Windows PE imports name a DLL without a directory, so there is no
    # build-host path for them to carry, and the one graphics library a WGL
    # build imports is the system opengl32.dll. Its exports still need to stay
    # within the public C API.
    return pe_problems(binary)


def main() -> int:
    preset = os.environ["usage_preset"]
    root = pathlib.Path(os.environ["MISE_MONOREPO_ROOT"])
    archive = root / "build/packages/native/dist" / f"maplibre-native-c-{preset}.tar.gz"
    if not archive.is_file():
        print(f"error: native package does not exist: {archive}", file=sys.stderr)
        return 1

    links_loader = preset.startswith(PLATFORM_LOADER_PRESETS)
    problems = []
    with tempfile.TemporaryDirectory() as directory:
        with tarfile.open(archive) as tar:
            tar.extractall(directory, filter="data")
        for binary in sorted(pathlib.Path(directory).rglob("*")):
            if not binary.is_file():
                continue
            relative = binary.relative_to(directory)
            if vendored_header(relative):
                problems.append((binary.name, VENDORED_HEADER, str(relative)))
                continue
            image = image_format(binary)
            if image is None:
                continue
            if not binary.name.removeprefix("lib").startswith(PACKAGED_LIBRARY_STEM):
                problems.append((binary.name, VENDORED_LOADER, str(relative)))
                # What a library that does not belong here depends on says
                # nothing about the artifact; removing it answers both.
                continue
            problems.extend(
                (binary.name, kind, detail)
                for kind, detail in binary_problems(binary, image, links_loader)
            )

    if not problems:
        return 0
    for name, kind, detail in problems:
        print(f"error: {name} {kind}: {detail}", file=sys.stderr)
    for remedy in dict.fromkeys(kind for _, kind, _ in problems):
        print(f"\n{archive.name}: {REMEDIES[remedy]}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
