#!/usr/bin/env python3
# [MISE] description="Check a native package's dependencies, exports, headers, and symbols."
# [MISE] shell="python"
# USAGE arg "<preset>" help="Native CMake preset"

"""Check what a native package links and carries.

- No dependency or run path names a build-host path. Linking Homebrew's Vulkan
  loader is enough to record `/opt/homebrew/opt/...`.
- No graphics loader is linked or carried, since the host supplies its own.
  Android and OpenHarmony ship theirs with the platform.
- The only headers are the C API's and MapLibre Native's plugin header.
- Each Apple library is stripped, with a matching dSYM beside it.
- The relocatable CMake package links shared and complete static consumers.
- A complete ELF archive keeps no COMDAT group, since a consumer's link would
  discard its private copy of a runtime in favor of the consumer's own.
"""

from __future__ import annotations

import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile

# System libraries, or paths relative to the loading binary.
MACHO_ALLOWED_PREFIXES = (
    "@rpath/",
    "@loader_path/",
    "@executable_path/",
    "/usr/lib/",
    "/System/Library/",
)
# Search paths must resolve against the loading binary.
MACHO_SEARCH_PATH_ROOTS = ("@loader_path", "@executable_path")
ELF_SEARCH_PATH_ROOTS = ("$ORIGIN", "${ORIGIN}")

# Thin 64- and 32-bit Mach-O, then 32- and 64-bit universal headers.
MACHO_MAGICS = frozenset(
    {b"\xcf\xfa\xed\xfe", b"\xce\xfa\xed\xfe", b"\xca\xfe\xba\xbe", b"\xca\xfe\xba\xbf"}
)
PE_MAGIC = b"MZ"

# A path may contain spaces, so match up to otool's trailing offset field.
MACHO_NAME = re.compile(r"^\s*name (?P<name>.+) \(offset \d+\)$")
MACHO_PATH = re.compile(r"^\s*path (?P<path>.+) \(offset \d+\)$")
MACHO_COMMAND = re.compile(r"^\s*cmd (?P<command>LC_\w+)$")
MACHO_UUID = re.compile(r"^\s*uuid (?P<uuid>[0-9A-F-]+)$")
ELF_ENTRY = re.compile(r"^\s*0x[0-9a-f]+\s+\((?P<tag>\w+)\)\s+.*\[(?P<value>[^\]]*)\]")
PE_EXPORT = re.compile(r"^\s*Name: (?P<name>\S+)$")

# Loader names without the `lib` prefix, version, or extension.
LOADER_NAMES = frozenset(
    {
        "egl",
        "gl",
        "glesv1_cm",
        "glesv2",
        "glesv3",
        "moltenvk",
        "opengl",
        "vulkan",
        "vulkan-1",
    }
)
# The platform's own graphics frameworks, such as Metal, live under these.
PLATFORM_LIBRARY_PREFIXES = ("/System/Library/", "/usr/lib/")
# Presets whose platform ships the graphics loader.
PLATFORM_LOADER_PRESETS = ("android-", "ohos-")
# Presets whose complete static archive holds ELF objects.
ELF_ARCHIVE_PRESETS = ("android-", "freebsd-", "linux-", "ohos-")
PACKAGED_LIBRARY_STEM = "maplibre-native-c"
# The binary of MaplibreNativeC.framework.
PACKAGED_FRAMEWORK_BINARY = "MaplibreNativeC"
# The prefix's and the framework's header directories.
HEADER_ROOTS = ("include", "Headers")
# The umbrella header and the directory of domain headers.
PACKAGED_HEADER_ENTRIES = frozenset({"maplibre_native_c.h", "maplibre_native_c"})
# MapLibre Native's plugin header, at the path plugin.h includes it from.
PACKAGED_PLUGIN_HEADER = pathlib.PurePath("mln/plugin/plugin_api.h")

BUILD_HOST_PATH = "names a build-host path"
PRIVATE_EXPORT = "exports a private symbol"
LINKED_LOADER = "links a graphics loader"
VENDORED_LOADER = "carries a library that is not the C API"
VENDORED_HEADER = "carries a header that is not the C API's"
UNSTRIPPED = "keeps local symbols"
MISSING_DSYM = "has no matching dSYM"
COMDAT_GROUPS = "keeps COMDAT groups"
REMEDIES = {
    BUILD_HOST_PATH: (
        "The package only loads where these paths exist. Resolve the "
        "dependency at run time, or give it a relocatable install name and "
        "ship it."
    ),
    PRIVATE_EXPORT: (
        "Only mln_* symbols belong in the dynamic symbol table. Hide the "
        "symbol, or add a public mln_* entry point."
    ),
    LINKED_LOADER: (
        "A host that loads its own graphics loader would run two. Resolve the "
        "entry points at run time, as src/render/opengl/egl_dispatch.cpp does, "
        "and link the loader into the test harness only."
    ),
    VENDORED_LOADER: (
        "The host supplies the graphics loader. Install a local stand-in "
        "through the loader component, which stays out of the package."
    ),
    VENDORED_HEADER: (
        "Graphics headers come with the host's implementation. Install a local "
        "stand-in through the loader component, which stays out of the package."
    ),
    UNSTRIPPED: (
        "An Apple library's local symbols belong in its dSYM. CPack strips "
        "macOS and Mac Catalyst libraries, and mln_ffi_install_apple_dsym "
        "strips embedded Apple ones."
    ),
    MISSING_DSYM: (
        "Debuggers and crash reports find an Apple library's local symbols in "
        "the dSYM beside it, by UUID. mln_ffi_install_apple_dsym writes it."
    ),
    COMDAT_GROUPS: (
        "A consumer that links its own copy of a bundled runtime would have "
        "one copy's members discarded. mln_ffi_elf_archive_commands removes "
        "the groups when it localizes the archive's symbols."
    ),
}


def run(command: list[str]) -> str:
    result = subprocess.run(command, capture_output=True, text=True, check=False)
    if result.returncode != 0:
        raise SystemExit(
            f"{command[0]} failed for {command[-1]}:\n"
            f"{result.stdout.strip()}\n{result.stderr.strip()}"
        )
    return result.stdout


def anchored(path: str, roots: tuple[str, ...]) -> bool:
    """Whether a search path resolves against the binary that loads it."""
    return any(path == root or path.startswith(f"{root}/") for root in roots)


def loader_dependency(dependency: str) -> bool:
    """Whether a dependency names a graphics loader rather than a host library."""
    if dependency.startswith(PLATFORM_LIBRARY_PREFIXES):
        return False
    leaf = dependency.rsplit("/", 1)[-1]
    return leaf.removeprefix("lib").split(".", 1)[0].lower() in LOADER_NAMES


def macho_problems(binary: pathlib.Path, links_loader: bool) -> list[tuple[str, str]]:
    """Dependencies and run paths from the Mach-O load commands."""
    problems = []
    command = ""
    for line in run(["otool", "-l", str(binary)]).splitlines():
        match = MACHO_COMMAND.match(line)
        if match:
            command = match.group("command")
            continue
        if command.endswith("_DYLIB"):
            name = MACHO_NAME.match(line)
            if not name:
                continue
            dependency = name.group("name")
            # LC_ID_DYLIB, the library's own name, must be relocatable too.
            if not dependency.startswith(MACHO_ALLOWED_PREFIXES):
                problems.append((BUILD_HOST_PATH, f"{command} {dependency}"))
            elif not links_loader and loader_dependency(dependency):
                problems.append((LINKED_LOADER, f"{command} {dependency}"))
        elif command == "LC_RPATH":
            path = MACHO_PATH.match(line)
            if path and not anchored(path.group("path"), MACHO_SEARCH_PATH_ROOTS):
                problems.append((BUILD_HOST_PATH, f"LC_RPATH {path.group('path')}"))
    return problems


def elf_problems(binary: pathlib.Path, links_loader: bool) -> list[tuple[str, str]]:
    """Needed libraries and search paths from the ELF dynamic section."""
    problems = []
    for line in run(["readelf", "--dynamic", "--wide", str(binary)]).splitlines():
        match = ELF_ENTRY.match(line)
        if not match:
            continue
        tag, value = match.group("tag"), match.group("value")
        # A soname with a directory bypasses the host's library search path.
        if tag == "NEEDED" and "/" in value:
            problems.append((BUILD_HOST_PATH, f"DT_NEEDED {value}"))
        elif tag == "NEEDED" and not links_loader and loader_dependency(value):
            problems.append((LINKED_LOADER, f"DT_NEEDED {value}"))
        elif tag in {"RPATH", "RUNPATH"}:
            problems.extend(
                (BUILD_HOST_PATH, f"DT_{tag} {entry}")
                for entry in value.split(":")
                if entry and not anchored(entry, ELF_SEARCH_PATH_ROOTS)
            )
    return problems


def pe_problems(binary: pathlib.Path) -> list[tuple[str, str]]:
    """Exports from a Windows library's PE export directory."""
    exports = (
        match.group("name")
        for line in run(["llvm-readobj", "--coff-exports", str(binary)]).splitlines()
        if (match := PE_EXPORT.match(line))
    )
    return [(PRIVATE_EXPORT, name) for name in exports if not name.startswith("mln_")]


def dsym_problems(binary: pathlib.Path, root: pathlib.Path) -> list[tuple[str, str]]:
    """Local symbols left in an Apple library, and its dSYM's absence or UUID."""
    problems = []
    symbols = run(["nm", "-m", "--defined-only", str(binary)]).splitlines()
    local = sum(" non-external " in line for line in symbols)
    if local:
        problems.append((UNSTRIPPED, f"{local} local symbols"))

    # A framework's dSYM sits beside the bundle, and a bare library's beside
    # the library.
    bundle = next(
        (path for path in binary.parents if path.suffix == ".framework"), binary
    )
    dsym = bundle.with_name(f"{bundle.name}.dSYM")
    symbol_file = dsym / "Contents/Resources/DWARF" / binary.name
    if not symbol_file.is_file():
        problems.append((MISSING_DSYM, f"no {symbol_file.relative_to(root)}"))
    elif macho_uuids(symbol_file) != macho_uuids(binary):
        problems.append(
            (MISSING_DSYM, f"{dsym.relative_to(root)} describes another build")
        )
    return problems


def macho_uuids(binary: pathlib.Path) -> list[str]:
    """The UUID of each slice of a Mach-O file."""
    return [
        match.group("uuid")
        for line in run(["otool", "-l", str(binary)]).splitlines()
        if (match := MACHO_UUID.match(line))
    ]


def vendored_header(relative: pathlib.PurePath) -> bool:
    """Whether a packaged path is a header the C API does not own."""
    parts = relative.parts
    root = next((part for part in parts if part in HEADER_ROOTS), None)
    if root is None:
        return False
    # An archive built on macOS has an AppleDouble `._` sidecar for each file.
    under_include = pathlib.PurePath(
        *(part.removeprefix("._") for part in parts[parts.index(root) + 1 :])
    )
    if under_include.parts[0] in PACKAGED_HEADER_ENTRIES:
        return False
    return under_include != PACKAGED_PLUGIN_HEADER and not (
        under_include.parts and under_include in PACKAGED_PLUGIN_HEADER.parents
    )


def comdat_problems(archive: pathlib.Path) -> list[tuple[str, str]]:
    groups = [
        line
        for line in run(["readelf", "--section-groups", str(archive)]).splitlines()
        if line.startswith("COMDAT group section")
    ]
    return [(COMDAT_GROUPS, f"{len(groups)} groups")] if groups else []


def image_format(binary: pathlib.Path) -> str | None:
    """The executable format of a file, or None for one that doesn't load."""
    with binary.open("rb") as file:
        magic = file.read(4)
    if magic == b"\x7fELF":
        return "elf"
    if magic in MACHO_MAGICS:
        return "macho"
    if magic.startswith(PE_MAGIC):
        return "pe"
    return None


def binary_problems(
    binary: pathlib.Path, image: str, links_loader: bool
) -> list[tuple[str, str]]:
    if image == "elf":
        return elf_problems(binary, links_loader)
    if image == "macho":
        # otool reads every slice of a universal binary.
        return macho_problems(binary, links_loader)
    # PE imports carry no directory, and a WGL build imports only the system
    # opengl32.dll, so only the exports need checking.
    return pe_problems(binary)


def verify_cmake_package(root: pathlib.Path, prefix: pathlib.Path, preset: str) -> None:
    """Build consumers from the extracted prefix with the preset's toolchain."""
    configs = list(
        prefix.glob("lib*/cmake/maplibre-native-c/maplibre-native-c-config.cmake")
    )
    if len(configs) != 1:
        raise SystemExit(f"expected one maplibre-native-c CMake config in {prefix}")
    source = prefix.parent / "consumer"
    shutil.copytree(root / "tests/package", source)
    (source / "CMakePresets.json").write_text(
        json.dumps({"version": 8, "include": [str(root / "CMakePresets.json")]}),
        encoding="utf-8",
    )
    build = source / "build"
    run(
        [
            "cmake",
            "--preset",
            preset,
            "-S",
            str(source),
            "-B",
            str(build),
            f"-Dmaplibre-native-c_DIR={configs[0].parent}",
            f"-DMLN_PACKAGE_PREFIX={prefix}",
        ]
    )
    run(["cmake", "--build", str(build), "--config", "Release"])


def main() -> int:
    preset = os.environ["usage_preset"]
    root = pathlib.Path(os.environ["MISE_MONOREPO_ROOT"])
    archive = root / "build/packages/native/dist" / f"maplibre-native-c-{preset}.tar.gz"
    if not archive.is_file():
        print(f"error: native package does not exist: {archive}", file=sys.stderr)
        return 1

    links_loader = preset.startswith(PLATFORM_LOADER_PRESETS)
    problems = []
    with tempfile.TemporaryDirectory() as directory:
        with tarfile.open(archive) as tar:
            tar.extractall(directory, filter="data")
        for binary in sorted(pathlib.Path(directory).rglob("*")):
            relative = binary.relative_to(directory)
            # dsym_problems checks a dSYM along with its library.
            if not binary.is_file() or any(
                part.endswith(".dSYM") for part in relative.parts
            ):
                continue
            if vendored_header(relative):
                problems.append((binary.name, VENDORED_HEADER, str(relative)))
                continue
            if binary.name == f"lib{PACKAGED_LIBRARY_STEM}.a" and preset.startswith(
                ELF_ARCHIVE_PRESETS
            ):
                problems.extend(
                    (binary.name, kind, detail)
                    for kind, detail in comdat_problems(binary)
                )
                continue
            image = image_format(binary)
            if image is None:
                continue
            if (
                binary.name != PACKAGED_FRAMEWORK_BINARY
                and not binary.name.removeprefix("lib").startswith(
                    PACKAGED_LIBRARY_STEM
                )
            ):
                problems.append((binary.name, VENDORED_LOADER, str(relative)))
                # Its dependencies don't matter once it's removed.
                continue
            problems.extend(
                (binary.name, kind, detail)
                for kind, detail in binary_problems(binary, image, links_loader)
            )
            # Skip the symlink to a macOS framework's binary.
            if image == "macho" and not binary.is_symlink():
                problems.extend(
                    (binary.name, kind, detail)
                    for kind, detail in dsym_problems(binary, pathlib.Path(directory))
                )
        verify_cmake_package(
            root, pathlib.Path(directory) / f"maplibre-native-c-{preset}", preset
        )

    if not problems:
        return 0
    for name, kind, detail in problems:
        print(f"error: {name} {kind}: {detail}", file=sys.stderr)
    for remedy in dict.fromkeys(kind for _, kind, _ in problems):
        print(f"\n{archive.name}: {REMEDIES[remedy]}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
