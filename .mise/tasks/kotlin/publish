#!/usr/bin/env bash
# [MISE] description="Stage or verify Kotlin Maven artifacts."
# [MISE] shell="bash"
# [MISE] tools={java="{{vars.java_version}}"}

set -euo pipefail

input_root="${MISE_MONOREPO_ROOT}/build/packages/native/maven-input"
build_root="${MISE_MONOREPO_ROOT}/build/packages/kotlin/local-build"
staging_base="${MISE_MONOREPO_ROOT}/build/packages/kotlin"
repository=MavenStagingRepository

usage() {
  echo "usage: $(basename "$0") stage [version]" >&2
  echo "       $(basename "$0") verify <maven-staging> [version]" >&2
}

extract_preset() {
  local preset="$1"
  local archive
  local destination="${build_root}/${preset}/install"
  archive="$(find "$input_root" -type f -name "maplibre-native-c-${preset}.tar.gz" -print -quit)"
  if [[ -z "$archive" ]]; then
    echo "Missing native package for ${preset} under ${input_root}" >&2
    return 1
  fi

  mkdir -p "$destination"
  tar -xzf "$archive" -C "$destination" --strip-components=1
}

prepare_native_inputs() {
  # The Linux, FreeBSD, and Windows installs also feed the JVM runtime
  # classifiers.
  local presets=(
    android-arm-egl
    android-arm-vulkan
    android-arm64-egl
    android-arm64-vulkan
    android-x64-egl
    android-x64-vulkan
    linux-gnu-arm64-egl
    linux-gnu-arm64-vulkan
    linux-gnu-x64-egl
    linux-gnu-x64-vulkan
    linux-musl-arm64-egl
    linux-musl-arm64-vulkan
    linux-musl-x64-egl
    linux-musl-x64-vulkan
    freebsd-x64-egl
    freebsd-x64-vulkan
    macos-arm64-egl
    macos-arm64-vulkan
    macos-arm64-metal
    ios-arm64-metal
    ios-simulator-arm64-metal
    tvos-arm64-metal
    tvos-simulator-arm64-metal
    windows-x64-wgl
    windows-arm64-wgl
    windows-x64-vulkan
    windows-arm64-vulkan
    emscripten-wasm32-webgl
    emscripten-wasm32-webgpu
  )

  rm -rf "$build_root"
  for preset in "${presets[@]}"; do
    extract_preset "$preset"
  done
}

prepare_browser_runtimes() {
  local backend preset directory
  for backend in webgl webgpu; do
    preset="emscripten-wasm32-${backend}"
    directory="${build_root}/${preset}/install/share/maplibre-native-kotlin"
    rm -rf "$directory"
    cmake -S bindings/kotlin/wasm --preset "$preset" \
      -B "${build_root}/${preset}/module" \
      -DMLN_FFI_NATIVE_PREFIX="${build_root}/${preset}/install" \
      -DCMAKE_INSTALL_PREFIX="$directory"
    cmake --build "${build_root}/${preset}/module" \
      --target maplibre_native_kotlin --config Release --parallel
    cmake --install "${build_root}/${preset}/module" --component maplibre_native_kotlin --config Release
  done
}

# Adds the tasks that publish each named publication of a project.
add_publications() {
  local project="$1"
  shift
  local publication
  for publication in "$@"; do
    publication_tasks+=("${project}:publish${publication}PublicationTo${repository}")
  done
}

publish() {
  local android_native=(AndroidNativeArm32 AndroidNativeArm64 AndroidNativeX64)
  local linux=(LinuxX64 LinuxArm64)
  local apple=(MacosArm64 IosArm64 IosSimulatorArm64 TvosArm64 TvosSimulatorArm64)

  # Only the Linux and Android Native KLIBs cross-compile; the Apple run keeps
  # the repository default.
  publication_tasks=()
  add_publications :bindings:kotlin Android "${android_native[@]}" "${linux[@]}"
  add_publications :bindings:kotlin:runtimes:opengl Android "${android_native[@]}" "${linux[@]}"
  add_publications :bindings:kotlin:runtimes:vulkan "${android_native[@]}" "${linux[@]}"
  ./gradlew "$@" -Pkotlin.native.enableKlibsCrossCompilation=true "${publication_tasks[@]}"
  # One run packages the Android libraries of one backend.
  ./gradlew "$@" -Pmaplibre.android.backend=vulkan \
    ":bindings:kotlin:runtimes:vulkan:publishAndroidPublicationTo${repository}"

  publication_tasks=()
  add_publications :bindings:kotlin KotlinMultiplatform Jvm WasmJs "${apple[@]}"
  add_publications :bindings:kotlin:runtimes:opengl KotlinMultiplatform Jvm MacosArm64 WasmJs
  add_publications :bindings:kotlin:runtimes:webgpu KotlinMultiplatform WasmJs
  add_publications :bindings:kotlin:runtimes:vulkan KotlinMultiplatform Jvm MacosArm64
  add_publications :bindings:kotlin:runtimes:metal KotlinMultiplatform Jvm "${apple[@]}"
  ./gradlew "$@" "${publication_tasks[@]}"
}

operation="${1:-}"

case "$operation" in
  stage)
    if [[ "$#" -gt 2 ]]; then
      usage
      exit 2
    fi
    version="${2:-}"
    # Gradle compiles the Android JNI shim with the pinned NDK compiler, even
    # when the native libraries are prebuilt.
    mise run //:android-sdk-packages
    staging_root="${staging_base}/maven-staging"
    rm -rf "$staging_root"
    prepare_native_inputs
    prepare_browser_runtimes
    release_version_args=()
    if [[ -n "$version" ]]; then
      release_version_args=("-Pmaplibre.maven.version=$version")
    fi
    publish \
      "${release_version_args[@]}" \
      -Pmaplibre.localBuild="$build_root" \
      -Pmaplibre.maven.localRepository="$staging_root"
    ;;
  verify)
    if [[ "$#" -lt 2 || "$#" -gt 3 ]]; then
      usage
      exit 2
    fi
    mise run //:kotlin:verify-staging "${@:2}"
    ;;
  *)
    usage
    exit 2
    ;;
esac
