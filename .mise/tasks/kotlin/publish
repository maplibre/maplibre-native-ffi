#!/usr/bin/env bash
# [MISE] description="Stage and verify Kotlin Maven artifacts."
# [MISE] shell="bash"
# [MISE] tools={java="{{vars.java_version}}"}

set -euo pipefail

input_root="${MISE_MONOREPO_ROOT}/build/packages/native/maven-input"
install_root="${MISE_MONOREPO_ROOT}/build/packages/kotlin/install"
staging_base="${MISE_MONOREPO_ROOT}/build/packages/kotlin"

usage() {
  echo "usage: $(basename "$0") stage <linux|apple> [version]" >&2
  echo "       $(basename "$0") verify <maven-staging> [version]" >&2
}

extract_preset() {
  local preset="$1"
  local archive
  local destination="${install_root}/${preset}"
  archive="$(find "$input_root" -type f -name "maplibre-native-c-${preset}.tar.gz" -print -quit)"
  if [[ -z "$archive" ]]; then
    echo "Missing native package for ${preset} under ${input_root}" >&2
    return 1
  fi

  mkdir -p "$destination"
  tar -xzf "$archive" -C "$destination" --strip-components=1
}

prepare_native_inputs() {
  local partition="$1"
  local presets=()

  case "$partition" in
    linux)
      presets=(
        android-arm64-egl
        android-arm64-vulkan
        android-x64-egl
        android-x64-vulkan
        linux-arm64-egl
        linux-arm64-vulkan
        linux-x64-egl
        linux-x64-vulkan
      )
      ;;
    apple)
      presets=(
        linux-x64-egl
        linux-arm64-egl
        linux-x64-vulkan
        linux-arm64-vulkan
        macos-arm64-egl
        macos-arm64-vulkan
        macos-arm64-metal
        ios-arm64-metal
        ios-simulator-arm64-metal
        windows-x64-wgl
        windows-arm64-wgl
        windows-x64-vulkan
        windows-arm64-vulkan
      )
      ;;
    *)
      usage
      return 2
      ;;
  esac

  rm -rf "$install_root"
  for preset in "${presets[@]}"; do
    extract_preset "$preset"
  done
}

publish_tasks() {
  local project="$1"
  local repository="$2"
  shift 2

  local tasks=()
  while [[ "$1" != "--" ]]; do
    tasks+=("${project}:publish${1}PublicationTo${repository}")
    shift
  done
  shift

  ./gradlew "${tasks[@]}" "$@"
}

publish_linux_leaves() {
  local repository="$1"
  shift
  local common=(
    -Pmaplibre.android.prebuiltInstallRoot="$install_root"
    "-Pmaplibre.android.abis=arm64-v8a,x86_64"
  )

  publish_tasks \
    :bindings:kotlin \
    "$repository" \
    Android -- \
    "$@" \
    "${common[@]}"

  publish_tasks \
    :bindings:kotlin:runtimes:opengl \
    "$repository" \
    Android -- \
    "$@" \
    "${common[@]}" \
    -Pmaplibre.android.backend=opengl

  publish_tasks \
    :bindings:kotlin:runtimes:vulkan \
    "$repository" \
    Android -- \
    "$@" \
    "${common[@]}" \
    -Pmaplibre.android.backend=vulkan

  publish_tasks \
    :bindings:kotlin \
    "$repository" \
    LinuxX64 -- \
    "$@"

  publish_tasks \
    :bindings:kotlin \
    "$repository" \
    LinuxArm64 -- \
    "$@" \
    -Pkotlin.native.enableKlibsCrossCompilation=true \
    -PmaplibreNativeCInstallDir="$install_root/linux-arm64-egl"

  publish_tasks \
    :bindings:kotlin:runtimes:opengl \
    "$repository" \
    LinuxX64 -- \
    "$@" \
    -Pmaplibre.runtime.opengl.linuxX64.installDir="$install_root/linux-x64-egl"

  publish_tasks \
    :bindings:kotlin:runtimes:opengl \
    "$repository" \
    LinuxArm64 -- \
    "$@" \
    -Pkotlin.native.enableKlibsCrossCompilation=true \
    -Pmaplibre.runtime.opengl.linuxArm64.installDir="$install_root/linux-arm64-egl"

  publish_tasks \
    :bindings:kotlin:runtimes:vulkan \
    "$repository" \
    LinuxX64 -- \
    "$@" \
    -Pmaplibre.runtime.vulkan.linuxX64.installDir="$install_root/linux-x64-vulkan"

  publish_tasks \
    :bindings:kotlin:runtimes:vulkan \
    "$repository" \
    LinuxArm64 -- \
    "$@" \
    -Pkotlin.native.enableKlibsCrossCompilation=true \
    -Pmaplibre.runtime.vulkan.linuxArm64.installDir="$install_root/linux-arm64-vulkan"

  ./gradlew \
    -Pkotlin.native.enableKlibsCrossCompilation=true \
    -PmaplibreNativeCInstallDir="$install_root/linux-arm64-egl" \
    :bindings:kotlin:linkDebugTestLinuxArm64
}

publish_apple_leaves() {
  local repository="$1"
  shift
  local opengl=(
    -Pmaplibre.runtime.opengl.macosArm64.installDir="$install_root/macos-arm64-egl"
    -Pmaplibre.runtime.opengl.jvm.natives-linux-x64.installDir="$install_root/linux-x64-egl"
    -Pmaplibre.runtime.opengl.jvm.natives-linux-arm64.installDir="$install_root/linux-arm64-egl"
    -Pmaplibre.runtime.opengl.jvm.natives-macos-arm64.installDir="$install_root/macos-arm64-egl"
    -Pmaplibre.runtime.opengl.jvm.natives-windows-x64.installDir="$install_root/windows-x64-wgl"
    -Pmaplibre.runtime.opengl.jvm.natives-windows-arm64.installDir="$install_root/windows-arm64-wgl"
  )
  local vulkan=(
    -Pmaplibre.runtime.vulkan.macosArm64.installDir="$install_root/macos-arm64-vulkan"
    -Pmaplibre.runtime.vulkan.jvm.natives-linux-x64.installDir="$install_root/linux-x64-vulkan"
    -Pmaplibre.runtime.vulkan.jvm.natives-linux-arm64.installDir="$install_root/linux-arm64-vulkan"
    -Pmaplibre.runtime.vulkan.jvm.natives-macos-arm64.installDir="$install_root/macos-arm64-vulkan"
    -Pmaplibre.runtime.vulkan.jvm.natives-windows-x64.installDir="$install_root/windows-x64-vulkan"
    -Pmaplibre.runtime.vulkan.jvm.natives-windows-arm64.installDir="$install_root/windows-arm64-vulkan"
  )
  local metal=(
    -Pmaplibre.runtime.metal.iosArm64.installDir="$install_root/ios-arm64-metal"
    -Pmaplibre.runtime.metal.iosSimulatorArm64.installDir="$install_root/ios-simulator-arm64-metal"
    -Pmaplibre.runtime.metal.macosArm64.installDir="$install_root/macos-arm64-metal"
    -Pmaplibre.runtime.metal.jvm.natives-macos-arm64.installDir="$install_root/macos-arm64-metal"
  )

  publish_tasks \
    :bindings:kotlin \
    "$repository" \
    Jvm MacosArm64 IosArm64 IosSimulatorArm64 -- \
    "$@"

  publish_tasks \
    :bindings:kotlin:runtimes:opengl \
    "$repository" \
    Jvm MacosArm64 -- \
    "$@" \
    "${opengl[@]}"

  publish_tasks \
    :bindings:kotlin:runtimes:vulkan \
    "$repository" \
    Jvm MacosArm64 -- \
    "$@" \
    "${vulkan[@]}"

  publish_tasks \
    :bindings:kotlin:runtimes:metal \
    "$repository" \
    Jvm MacosArm64 IosArm64 IosSimulatorArm64 -- \
    "$@" \
    "${metal[@]}"
}

publish_apple_roots() {
  local repository="$1"
  shift
  local opengl=(
    -Pmaplibre.runtime.opengl.macosArm64.installDir="$install_root/macos-arm64-egl"
  )
  local vulkan=(
    -Pmaplibre.runtime.vulkan.macosArm64.installDir="$install_root/macos-arm64-vulkan"
  )
  local metal=(
    -Pmaplibre.runtime.metal.iosArm64.installDir="$install_root/ios-arm64-metal"
    -Pmaplibre.runtime.metal.iosSimulatorArm64.installDir="$install_root/ios-simulator-arm64-metal"
    -Pmaplibre.runtime.metal.macosArm64.installDir="$install_root/macos-arm64-metal"
  )

  publish_tasks \
    :bindings:kotlin \
    "$repository" \
    KotlinMultiplatform -- \
    "$@"

  publish_tasks \
    :bindings:kotlin:runtimes:opengl \
    "$repository" \
    KotlinMultiplatform -- \
    "$@" \
    "${opengl[@]}"

  publish_tasks \
    :bindings:kotlin:runtimes:vulkan \
    "$repository" \
    KotlinMultiplatform -- \
    "$@" \
    "${vulkan[@]}"

  publish_tasks \
    :bindings:kotlin:runtimes:metal \
    "$repository" \
    KotlinMultiplatform -- \
    "$@" \
    "${metal[@]}"
}

publish_leaf_partition() {
  local partition="$1"
  local repository="$2"
  shift 2

  case "$partition" in
    linux)
      publish_linux_leaves "$repository" "$@"
      ;;
    apple)
      publish_apple_leaves "$repository" "$@"
      ;;
    *)
      usage
      return 2
      ;;
  esac
}

publish_partition() {
  local partition="$1"
  local repository="$2"
  shift 2

  publish_leaf_partition "$partition" "$repository" "$@"
  if [[ "$partition" == "apple" ]]; then
    publish_apple_roots "$repository" "$@"
  fi
}

operation="${1:-}"
partition="${2:-}"
version="${3:-}"

case "$operation" in
  stage)
    if [[ "$#" -lt 2 || "$#" -gt 3 ]]; then
      usage
      exit 2
    fi
    case "$partition" in
      linux | apple) ;;
      *)
        usage
        exit 2
        ;;
    esac
    staging_root="${staging_base}/maven-staging-${partition}"
    rm -rf "$staging_root"
    prepare_native_inputs "$partition"
    release_version_args=()
    if [[ -n "$version" ]]; then
      release_version_args=("-Pmaplibre.maven.version=$version")
    fi
    publish_partition \
      "$partition" \
      MavenStagingRepository \
      "${release_version_args[@]}" \
      -Pmaplibre.maven.localRepository="$staging_root"
    ;;
  verify)
    if [[ -z "$partition" || "$#" -lt 2 || "$#" -gt 3 ]]; then
      usage
      exit 2
    fi
    release_version_args=()
    if [[ -n "$version" ]]; then
      release_version_args=("-Pmaplibre.maven.version=$version")
    fi
    verify_args=("$partition")
    if [[ -n "$version" ]]; then
      verify_args+=("$version")
    fi
    mise run //:kotlin:verify-staging "${verify_args[@]}"

    ./gradlew \
      :examples:compose-map:packageUberJarForCurrentOS \
      :examples:lwjgl-map:installDist \
      -Pmaplibre.usePublishedKotlin=true \
      -Pmaplibre.runtime.backend=metal \
      "${release_version_args[@]}" \
      -Pmaplibre.maven.localRepository="$partition"

    ./gradlew \
      :examples:android-map:assembleDebug \
      -Pmaplibre.usePublishedKotlin=true \
      -Pmaplibre.android.backend=opengl \
      -Pmaplibre.android.abis=arm64-v8a,x86_64 \
      "${release_version_args[@]}" \
      -Pmaplibre.maven.localRepository="$partition"
    ;;
  *)
    usage
    exit 2
    ;;
esac
