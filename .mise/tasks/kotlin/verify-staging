COMMON_NATIVE_LICENSES = {
    "icu.txt",
    "maplibre-native.md",
    "nunicode.txt",
    "pmtiles.txt",
}

POM_NAMESPACE = {"m": "http://maven.apache.org/POM/4.0.0"}


def native_licenses(backend: str, target: str) -> set[str]:
    licenses = set(COMMON_NATIVE_LICENSES)
    if target.startswith(("android-", "linux-", "windows-")):
        licenses.add("rust.md")
    if target.startswith(("linux-", "windows-")):
        licenses.update({"libuv-extra.txt", "libuv.txt", "zlib.txt"})
    if backend == "vulkan":
        licenses.update(
            {"glslang.txt", "vulkan-headers.md", "vulkan-memory-allocator.txt"}
        )
    if backend == "opengl" and target.startswith("macos-"):
        licenses.add("angle.txt")
    return licenses


def one(paths: list[pathlib.Path], description: str) -> pathlib.Path:
    if len(paths) != 1:
        raise SystemExit(f"expected one {description}, found {len(paths)}: {paths}")
    return paths[0]


def module_files(root: pathlib.Path, module: str, suffix: str) -> list[pathlib.Path]:
    module_root = root / "org" / "maplibre" / "nativeffi" / module
    return sorted(path for path in module_root.rglob(f"*{suffix}") if path.is_file())


def required_pom_text(
    pom: pathlib.Path, project: element_tree.Element, path: str
) -> str:
    value = project.findtext(path, namespaces=POM_NAMESPACE)
    if value is None or not value.strip():
        raise SystemExit(f"{pom} is missing required POM field {path}")
    return value.strip()


def verify_repository_layout(root: pathlib.Path, expected_version: str | None) -> None:
    group_root = root / "org" / "maplibre" / "nativeffi"
    if not group_root.is_dir():
        raise SystemExit(f"the Maven repository is missing {group_root}")
    actual_modules = {path.name for path in group_root.iterdir() if path.is_dir()}
    if actual_modules != MODULES:
        raise SystemExit(
            f"the Maven repository contains modules {sorted(actual_modules)}; "
            f"expected {sorted(MODULES)}"
        )

    for module in MODULES:
        module_root = group_root / module
        version_directories = {path.name for path in module_root.iterdir() if path.is_dir()}
        if expected_version is not None and version_directories != {expected_version}:
            raise SystemExit(
                f"{module_root} contains versions {sorted(version_directories)}; "
                f"expected only {expected_version}"
            )

        pom = one(module_files(root, module, ".pom"), f"{module} POM")
        project = element_tree.parse(pom).getroot()
        group = required_pom_text(pom, project, "m:groupId")
        artifact = required_pom_text(pom, project, "m:artifactId")
        version = required_pom_text(pom, project, "m:version")
        if group != "org.maplibre.nativeffi" or artifact != module:
            raise SystemExit(
                f"{pom} has coordinates {group}:{artifact}; "
                f"expected org.maplibre.nativeffi:{module}"
            )
        if expected_version is not None and version != expected_version:
            raise SystemExit(f"{pom} has version {version}; expected {expected_version}")

        for field in (
            "m:name",
            "m:description",
            "m:url",
            "m:licenses/m:license/m:name",
            "m:licenses/m:license/m:url",
            "m:developers/m:developer/m:id",
            "m:developers/m:developer/m:name",
            "m:developers/m:developer/m:url",
            "m:scm/m:connection",
            "m:scm/m:developerConnection",
            "m:scm/m:url",
        ):
            required_pom_text(pom, project, field)


def verify_metadata(root: pathlib.Path, expected_version: str | None) -> None:
    for module in MODULES:
        pom = one(module_files(root, module, ".pom"), f"{module} POM")
        metadata = one(
            module_files(root, module, ".module"), f"{module} Gradle metadata"
        )
        element_tree.parse(pom)
        with metadata.open(encoding="utf-8") as stream:
            json.load(stream)

    for root_module, target_modules in ROOT_TARGET_MODULES.items():
        metadata_path = one(
            module_files(root, root_module, ".module"),
            f"{root_module} Gradle metadata",
        )
        metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
        component = metadata["component"]
        version = component["version"]
        if component["group"] != "org.maplibre.nativeffi":
            raise SystemExit(f"{metadata_path} has invalid group {component['group']}")
        if component["module"] != root_module:
            raise SystemExit(
                f"{metadata_path} has invalid module {component['module']}"
            )
        if expected_version is not None and version != expected_version:
            raise SystemExit(
                f"{metadata_path} has version {version}; expected {expected_version}"
            )

        referenced_targets = set()
        for variant in metadata["variants"]:
            available_at = variant.get("available-at")
            if available_at is None:
                continue
            target = max(
                (
                    name
                    for name in target_modules
                    if variant["name"].startswith(name)
                ),
                key=len,
                default=None,
            )
            if target is None:
                raise SystemExit(
                    f"{metadata_path} has no target mapping for {variant['name']}"
                )
            referenced_targets.add(target)
            target_module = target_modules[target]
            expected = {
                "url": f"../../{target_module}/{version}/{target_module}-{version}.module",
                "group": "org.maplibre.nativeffi",
                "module": target_module,
                "version": version,
            }
            if available_at != expected:
                raise SystemExit(
                    f"{metadata_path} has invalid {variant['name']} coordinates: "
                    f"{available_at}; expected {expected}"
                )
            one(
                module_files(root, target_module, ".module"),
                f"referenced {target_module} Gradle metadata",
            )
        if referenced_targets != set(target_modules):
            raise SystemExit(
                f"{metadata_path} references {referenced_targets}; "
                f"expected {set(target_modules)}"
            )


def verify_javadoc(root: pathlib.Path) -> None:
    for module in API_BEARING_MODULES:
        javadoc = one(
            module_files(root, module, "-javadoc.jar"), f"{module} javadoc JAR"
        )
        with zipfile.ZipFile(javadoc) as jar:
            names = set(jar.namelist())
            if "index.html" not in names:
                raise SystemExit(
                    f"{javadoc} does not contain generated documentation"
                )
            if not any(
                name.startswith("maplibre-native-ffi/org.maplibre.nativeffi")
                and name.endswith(".html")
                for name in names
            ):
                raise SystemExit(
                    f"{javadoc} does not contain generated API pages"
                )


RUSTLS_VERIFIER_PACKAGE = "org.maplibre.nativeffi.internal.rustlsplatformverifier"


def aar_keep_rules(aar: zipfile.ZipFile) -> str:
    names = [
        name
        for name in aar.namelist()
        if name.endswith((".pro", "proguard.txt"))
    ]
    return "\n".join(aar.read(name).decode("utf-8") for name in names)


def verify_android(root: pathlib.Path) -> None:
    # The binding AAR carries the Kotlin API and its private JavaCPP bridge. An
    # Android host of any language takes the C library and the TLS component from
    # a runtime AAR alone, so neither may appear here.
    core = one(
        module_files(root, "maplibre-native-ffi-android", ".aar"),
        "core Android AAR",
    )
    with zipfile.ZipFile(core) as aar:
        names = set(aar.namelist())
        for abi in ("armeabi-v7a", "arm64-v8a", "x86_64"):
            expected = f"jni/{abi}/libjniMaplibreNativeC.so"
            if expected not in names:
                raise SystemExit(f"the core Android AAR is missing {expected}")
            if not aar.read(expected).startswith(b"\x7fELF"):
                raise SystemExit(
                    f"the core Android AAR {expected} is not an ELF shared library"
                )
        unexpected = [
            name
            for name in names
            if name.startswith("jni/")
            and not name.endswith(("/", "libjniMaplibreNativeC.so"))
        ]
        if unexpected:
            raise SystemExit(
                f"the core Android AAR contains runtime native libraries: {unexpected}"
            )
        # The bridge links the NDK C++ runtime statically, so this AAR
        # redistributes NDK-licensed code and carries its own notice.
        if "META-INF/licenses/android-ndk/NOTICE" not in names:
            raise SystemExit(
                "the core Android AAR is missing META-INF/licenses/android-ndk/NOTICE"
            )
        if any("rustls" in name for name in names):
            raise SystemExit("the core Android AAR still carries the Rustls helper")
        if "org.bytedeco.javacpp" not in aar_keep_rules(aar):
            raise SystemExit(
                "the core Android AAR is missing the JavaCPP consumer keep rule"
            )

    for backend in ("opengl", "vulkan"):
        runtime = one(
            module_files(
                root, f"maplibre-native-ffi-runtime-{backend}-android", ".aar"
            ),
            f"{backend} Android runtime AAR",
        )
        with zipfile.ZipFile(runtime) as aar:
            names = set(aar.namelist())
            for license_name in native_licenses(backend, "android-arm64"):
                expected = f"META-INF/licenses/maplibre-native-c/{license_name}"
                if expected not in names:
                    raise SystemExit(f"{runtime} is missing {expected}")
            if "META-INF/licenses/android-ndk/NOTICE" not in names:
                raise SystemExit(
                    f"{runtime} is missing META-INF/licenses/android-ndk/NOTICE"
                )
            rustls_jar = "libs/rustls-platform-verifier-android.jar"
            if rustls_jar not in names:
                raise SystemExit(f"{runtime} is missing {rustls_jar}")
            if RUSTLS_VERIFIER_PACKAGE not in aar_keep_rules(aar):
                raise SystemExit(f"{runtime} is missing the Rustls consumer keep rule")
            for license_name in ("LICENSE-APACHE", "LICENSE-MIT", "NOTICE"):
                expected = (
                    "META-INF/licenses/rustls-platform-verifier/" + license_name
                )
                if expected not in names:
                    raise SystemExit(f"{runtime} is missing {expected}")
            abis = ("arm64-v8a", "x86_64")
            if backend == "opengl":
                abis = ("armeabi-v7a", *abis)
            for abi in abis:
                expected = f"jni/{abi}/libmaplibre-native-c.so"
                if expected not in names:
                    raise SystemExit(f"{runtime} is missing {expected}")
                payload = aar.read(expected)
                if not payload.startswith(b"\x7fELF"):
                    raise SystemExit(f"{runtime} {expected} is not an ELF shared library")
                # The Android presets link libc++ statically, so a host packages
                # this library alone.
                if b"libc++_shared.so" in payload:
                    raise SystemExit(f"{runtime} {expected} needs libc++_shared.so")
            unexpected = [
                name
                for name in names
                if name.startswith("jni/")
                and not name.endswith(("/", "libmaplibre-native-c.so"))
            ]
            if unexpected:
                raise SystemExit(f"{runtime} contains unexpected libraries: {unexpected}")


def verify_android_runtime_independence(root: pathlib.Path) -> None:
    """A non-Kotlin Android host depends on a runtime module alone, so the
    published Android runtime variants must not pull the Kotlin binding in."""
    for backend in ("opengl", "vulkan"):
        module = f"maplibre-native-ffi-runtime-{backend}-android"
        metadata_path = one(
            module_files(root, module, ".module"), f"{module} Gradle metadata"
        )
        metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
        for variant in metadata["variants"]:
            for dependency in variant.get("dependencies", []):
                if dependency.get("module") == "maplibre-native-ffi":
                    raise SystemExit(
                        f"{metadata_path} variant {variant['name']} depends on "
                        "maplibre-native-ffi"
                    )


def verify_jvm(root: pathlib.Path) -> None:
    expected = {
        "opengl": {
            "natives-linux-x64",
            "natives-linux-arm64",
            "natives-macos-arm64",
            "natives-windows-x64",
            "natives-windows-arm64",
        },
        "vulkan": {
            "natives-linux-x64",
            "natives-linux-arm64",
            "natives-macos-arm64",
            "natives-windows-x64",
            "natives-windows-arm64",
        },
        "metal": {"natives-macos-arm64"},
    }
    for backend, classifiers in expected.items():
        module = f"maplibre-native-ffi-runtime-{backend}-jvm"
        jars = module_files(root, module, ".jar")
        for classifier in classifiers:
            runtime = one(
                [path for path in jars if f"-{classifier}.jar" in path.name],
                f"{backend} {classifier} JVM runtime JAR",
            )
            with zipfile.ZipFile(runtime) as jar:
                prefix = f"META-INF/maplibre-native-ffi/{classifier}/"
                license_prefix = "META-INF/licenses/maplibre-native-c/"
                native_libraries = [
                    name
                    for name in jar.namelist()
                    if name.startswith(prefix)
                    and name.endswith((".dll", ".dylib", ".so"))
                ]
                if not any("maplibre-native-c" in name for name in native_libraries):
                    raise SystemExit(f"{runtime} does not contain the C API library")
                target = classifier.removeprefix("natives-")
                for license_name in native_licenses(backend, target):
                    if f"{license_prefix}{license_name}" not in jar.namelist():
                        raise SystemExit(
                            f"{runtime} is missing {license_prefix}{license_name}"
                        )


def verify_native(root: pathlib.Path) -> None:
    modules = {
        "maplibre-native-ffi-runtime-opengl-androidnativearm32": (
            "opengl",
            "android-arm",
        ),
        "maplibre-native-ffi-runtime-opengl-androidnativearm64": (
            "opengl",
            "android-arm64",
        ),
        "maplibre-native-ffi-runtime-opengl-androidnativex64": (
            "opengl",
            "android-x64",
        ),
        "maplibre-native-ffi-runtime-opengl-linuxarm64": ("opengl", "linux-arm64"),
        "maplibre-native-ffi-runtime-opengl-linuxx64": ("opengl", "linux-x64"),
        "maplibre-native-ffi-runtime-opengl-macosarm64": ("opengl", "macos-arm64"),
        "maplibre-native-ffi-runtime-vulkan-androidnativearm64": (
            "vulkan",
            "android-arm64",
        ),
        "maplibre-native-ffi-runtime-vulkan-androidnativex64": (
            "vulkan",
            "android-x64",
        ),
        "maplibre-native-ffi-runtime-vulkan-linuxarm64": ("vulkan", "linux-arm64"),
        "maplibre-native-ffi-runtime-vulkan-linuxx64": ("vulkan", "linux-x64"),
        "maplibre-native-ffi-runtime-vulkan-macosarm64": ("vulkan", "macos-arm64"),
        "maplibre-native-ffi-runtime-metal-macosarm64": ("metal", "macos-arm64"),
        "maplibre-native-ffi-runtime-metal-iosarm64": ("metal", "ios-arm64"),
        "maplibre-native-ffi-runtime-metal-iossimulatorarm64": (
            "metal",
            "ios-simulator-arm64",
        ),
        "maplibre-native-ffi-runtime-metal-tvosarm64": ("metal", "tvos-arm64"),
        "maplibre-native-ffi-runtime-metal-tvossimulatorarm64": (
            "metal",
            "tvos-simulator-arm64",
        ),
    }
    for module, (backend, target) in modules.items():
        interop = one(
            [
                path
                for path in module_files(root, module, ".klib")
                if "cinterop-maplibreNativeRuntime" in path.name
            ],
            f"{module} runtime cinterop KLIB",
        )
        with zipfile.ZipFile(interop) as klib:
            names = set(klib.namelist())
            if not any(
                name.endswith("/included/libmaplibre-native-c.a")
                for name in names
            ):
                raise SystemExit(f"{interop} does not embed libmaplibre-native-c.a")
            if target.startswith(("android-", "linux-")) and not any(
                name.endswith("/included/libmln_ffi_platform.a") for name in names
            ):
                raise SystemExit(f"{interop} does not embed libmln_ffi_platform.a")
            for license_name in native_licenses(backend, target):
                expected = f"resources/licenses/maplibre-native-c/{license_name}"
                if expected not in names:
                    raise SystemExit(f"{interop} is missing {expected}")


def main() -> int:
    if len(sys.argv) not in (2, 3):
        print(
            f"usage: {pathlib.Path(sys.argv[0]).name} "
            "<maven-staging> [expected-version]",
            file=sys.stderr,
        )
        return 2
    root = pathlib.Path(sys.argv[1])
    expected_version = sys.argv[2] if len(sys.argv) == 3 else None
    verify_repository_layout(root, expected_version)
    verify_metadata(root, expected_version)
    verify_javadoc(root)
    verify_android(root)
    verify_android_runtime_independence(root)
    verify_jvm(root)
    verify_native(root)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
