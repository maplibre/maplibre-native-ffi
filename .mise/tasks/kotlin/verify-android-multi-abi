#!/usr/bin/env bash
#MISE description="Verify multi-ABI Android runtime AARs from packaged native artifacts."
#MISE shell="bash"
#MISE tools={java="{{vars.java_version}}"}
#MISE depends=["//:android-sdk-packages"]

set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: $(basename "$0") <native-artifact-directory>" >&2
  exit 2
fi

input_root="$1"
build_root="${MISE_MONOREPO_ROOT}/build/packages/kotlin/android-multi-build"
presets="$(python3 -m tools.ci.plan --package-inputs android-multi)"

rm -rf "$build_root"
mkdir -p "$build_root"
while IFS= read -r preset; do
  archive="$(find "$input_root" -type f -name "maplibre-native-c-${preset}.tar.gz" -print -quit)"
  if [[ -z "$archive" ]]; then
    echo "Missing native package for ${preset} under ${input_root}" >&2
    exit 1
  fi

  archive="$(realpath "$archive")"
  archive_root="maplibre-native-c-${preset}"
  (
    cd "$build_root"
    # The AAR contains native metadata and Prefab headers, so extract them
    # with the library.
    cmake -E tar xzf "$archive" -- \
      "${archive_root}/include" \
      "${archive_root}/lib/libmaplibre-native-c.so" \
      "${archive_root}/share/maplibre-native-c"
  )
done <<< "$presets"

for backend in opengl vulkan; do
  ./gradlew \
    -Pmaplibre.localBuild="$build_root" \
    -Pmaplibre.android.backend="$backend" \
    -Pmaplibre.android.abis=armeabi-v7a,arm64-v8a,x86,x86_64 \
    :bindings:kotlin:androidBuild
done
