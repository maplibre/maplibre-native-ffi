#!/usr/bin/env bash
#MISE description="Verify the multi-ABI Android runtime from packaged native artifacts."
#MISE tools={java="{{vars.java_version}}"}

set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: $(basename "$0") <native-artifact-directory>" >&2
  exit 2
fi

input_root="$1"
install_root="${MISE_MONOREPO_ROOT}/build/packages/kotlin/android-multi-install"
presets=(android-arm64-vulkan android-x64-vulkan)

rm -rf "$install_root"
mkdir -p "$install_root"
for preset in "${presets[@]}"; do
  archive="$(find "$input_root" -type f -name "maplibre-native-c-${preset}.tar.gz" -print -quit)"
  if [[ -z "$archive" ]]; then
    echo "Missing native package for ${preset} under ${input_root}" >&2
    exit 1
  fi

  archive="$(realpath "$archive")"
  archive_root="maplibre-native-c-${preset}"
  (
    cd "$install_root"
    # The AAR bundles the native notices, and assembly now rejects an install
    # without them, so extract the license directory alongside the library.
    cmake -E tar xzf "$archive" -- \
      "${archive_root}/lib/libmaplibre-native-c.so" \
      "${archive_root}/share/maplibre-native-c/artifact.json" \
      "${archive_root}/share/maplibre-native-c/licenses"
  )
  mv "${install_root}/${archive_root}" "${install_root}/${preset}"
done

./gradlew \
  -Pmaplibre.android.prebuiltInstallRoot="$install_root" \
  -Pmaplibre.android.backend=vulkan \
  -Pmaplibre.android.abis=arm64-v8a,x86_64 \
  :bindings:kotlin:androidBuild
