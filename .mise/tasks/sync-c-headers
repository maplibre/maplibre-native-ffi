#!/usr/bin/env python3
# [MISE] description="Copy the C headers from third_party/mln-rs into include/."
# [MISE] shell="python"

"""Replace include/'s headers with mln-rs's, from the submodule as patched.

mln-rs's crates/mln_c/include defines the C API. include/ keeps a copy because
the Go module and git dependencies read the headers without the submodule.
"""

import shutil
import sys
from pathlib import Path

root = Path(__file__).resolve().parents[2]
source = root / "third_party/mln-rs/crates/mln_c/include"
target = root / "include"
if not (source / "maplibre_native_c.h").is_file():
    sys.exit("third_party/mln-rs is not checked out; run `mise deps`")
shutil.rmtree(target / "maplibre_native_c", ignore_errors=True)
shutil.copytree(source / "maplibre_native_c", target / "maplibre_native_c")
shutil.copy2(source / "maplibre_native_c.h", target / "maplibre_native_c.h")
