#!/usr/bin/env bash
#MISE description="Replace a native build tree with its packaged install."
#MISE shell="bash"
#USAGE arg "<preset>" help="Native CMake preset"
#USAGE arg "<archive>" help="Native package archive"

set -euo pipefail

preset="${usage_preset?}"
if [[ ! "$preset" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
  echo "Invalid native preset: $preset" >&2
  exit 2
fi

archive_arg="${usage_archive?}"
if [[ ! -f "$archive_arg" ]]; then
  echo "Native package archive does not exist: $archive_arg" >&2
  exit 1
fi
archive="$(realpath "$archive_arg")"

build_dir="$MISE_MONOREPO_ROOT/build/$preset"
staging_dir="$build_dir/.package-staging"
package_root="$staging_dir/maplibre-native-c-$preset"
install_dir="$build_dir/install"

# A package carries no graphics implementation, neither the loader nor the
# headers to build against, so the fixtures and examples that run against this
# tree supply one. The tree already holds it, put there by the loader component
# or by an earlier run of this task, so it is set aside here and restored below
# rather than fetched from wherever the build found it.
loader_stash=""
if [[ "$preset" == macos-*-egl && -f "$install_dir/lib/libEGL.dylib" ]]; then
  loader_stash="$(mktemp -d)"
  mkdir -p "$loader_stash/lib" "$loader_stash/include"
  cp "$install_dir/lib/libEGL.dylib" "$install_dir/lib/libGLESv2.dylib" \
    "$loader_stash/lib"
  cp -R "$install_dir/include/EGL" "$install_dir/include/GLES2" \
    "$install_dir/include/GLES3" "$install_dir/include/KHR" \
    "$loader_stash/include"
fi

# Rust cross-builds use the configured Zig wrappers after this task replaces the
# native tree with its packaged install. Preserve them across that replacement.
zig_shim_stash=""
if [[ "$preset" == linux-musl-* && -d "$build_dir/zig-shim" ]]; then
  zig_shim_stash="$(mktemp -d)"
  mv "$build_dir/zig-shim" "$zig_shim_stash/"
fi

mise run //:clean "$preset"
mkdir -p "$staging_dir"
(
  cd "$staging_dir"
  cmake -E tar xzf "$archive"
)

descriptor="$package_root/share/maplibre-native-c/artifact.json"
if [[ ! -f "$descriptor" ]]; then
  echo "Native package is missing its artifact descriptor: $descriptor" >&2
  exit 1
fi
license_dir="$package_root/share/maplibre-native-c/licenses"
# Expand the glob directly rather than shelling out. An unmatched pattern stays
# literal, so the -e test below fails on an empty or absent directory. This uses
# only core bash, avoiding both the GNU/BSD find differences on the macOS
# runners and compgen, which the Windows runners' bash does not provide.
license_entries=("$license_dir"/*)
if [[ ! -d "$license_dir" ]] || [[ ! -e "${license_entries[0]}" ]]; then
  echo "Native package is missing its third-party license bundle: $license_dir" >&2
  exit 1
fi

mv "$package_root" "$install_dir"
rm -rf "$staging_dir"

if [[ -n "$loader_stash" ]]; then
  mv "$loader_stash"/lib/libEGL.dylib "$loader_stash"/lib/libGLESv2.dylib \
    "$install_dir/lib"
  mv "$loader_stash"/include/EGL "$loader_stash"/include/GLES2 \
    "$loader_stash"/include/GLES3 "$loader_stash"/include/KHR \
    "$install_dir/include"
  rm -rf "$loader_stash"
fi

if [[ -n "$zig_shim_stash" ]]; then
  mv "$zig_shim_stash/zig-shim" "$build_dir/"
  rmdir "$zig_shim_stash"
fi

touch "$build_dir/.native-package-install"
