#!/usr/bin/env bash
#MISE description="Replace a native build tree with its packaged install."
#MISE shell="bash"
#USAGE arg "<preset>" help="Native CMake preset"
#USAGE arg "<archive>" help="Native package archive"

set -euo pipefail

preset="${usage_preset?}"
if [[ ! "$preset" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
  echo "Invalid native preset: $preset" >&2
  exit 2
fi

archive_arg="${usage_archive?}"
if [[ ! -f "$archive_arg" ]]; then
  echo "Native package archive does not exist: $archive_arg" >&2
  exit 1
fi
archive="$(realpath "$archive_arg")"

build_dir="$MISE_MONOREPO_ROOT/build/$preset"
staging_dir="$build_dir/.package-staging"
package_root="$staging_dir/maplibre-native-c-$preset"
install_dir="$build_dir/install"

mise run //:clean "$preset"
mkdir -p "$staging_dir"
(
  cd "$staging_dir"
  cmake -E tar xzf "$archive"
)

descriptor="$package_root/share/maplibre-native-c/artifact.json"
if [[ ! -f "$descriptor" ]]; then
  echo "Native package is missing its artifact descriptor: $descriptor" >&2
  exit 1
fi
license_dir="$package_root/share/maplibre-native-c/licenses"
# Expand the glob directly rather than shelling out. An unmatched pattern stays
# literal, so the -e test below fails on an empty or absent directory. This uses
# only core bash, avoiding both the GNU/BSD find differences on the macOS
# runners and compgen, which the Windows runners' bash does not provide.
license_entries=("$license_dir"/*)
if [[ ! -d "$license_dir" ]] || [[ ! -e "${license_entries[0]}" ]]; then
  echo "Native package is missing its third-party license bundle: $license_dir" >&2
  exit 1
fi

mv "$package_root" "$install_dir"
rm -rf "$staging_dir"
touch "$build_dir/.native-package-install"
