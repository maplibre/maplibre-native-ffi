#!/usr/bin/env bash
set -euo pipefail

repo_root="${MISE_MONOREPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"

if [[ "${MLN_DPRINT_SCOPED_TOOLS:-}" == "1" ]]; then
  exec zig "$@"
fi

exec mise -C "$repo_root/bindings/zig" x -- \
  env MLN_DPRINT_SCOPED_TOOLS=1 "$repo_root/.mise/bin/dprint-zig" "$@"
