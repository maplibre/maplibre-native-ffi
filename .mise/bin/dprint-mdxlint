#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: $(basename "$0") <file-path>" >&2
  exit 2
fi

repo_root="${MISE_MONOREPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"

# mise x installs the docs project's node modules on demand, so linting mdx
# works without every other project installing the docs site.
if [[ "${MLN_DPRINT_SCOPED_TOOLS:-}" != "1" ]]; then
  exec mise -C "$repo_root/docs" x -- \
    env MLN_DPRINT_SCOPED_TOOLS=1 "$repo_root/.mise/bin/dprint-mdxlint" "$@"
fi

cd "$repo_root/docs"
exec pnpm exec mdxlint --rc-path .mdxlintrc.json --file-path "$1"
