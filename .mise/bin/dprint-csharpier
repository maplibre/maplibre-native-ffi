#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: $(basename "$0") <stdin-path>" >&2
  exit 2
fi

repo_root="${MISE_MONOREPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"

if [[ "${MLN_FFI_DPRINT_SCOPED_TOOLS:-}" != "1" ]]; then
  exec mise -C "$repo_root/bindings/dotnet" x -- \
    env MLN_FFI_DPRINT_SCOPED_TOOLS=1 "$repo_root/.mise/bin/dprint-csharpier" "$@"
fi

cd "$repo_root"
exec dotnet csharpier format \
  --write-stdout \
  --stdin-path "$1" \
  --log-level None
