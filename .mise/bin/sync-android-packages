#!/usr/bin/env bash
set -euo pipefail

# Install the Android SDK packages the builds need, either as the `android-sdk`
# tool's post-install step or, through `//:android-sdk-packages`, against an SDK
# mise does not own.
#
# The `android-*` CMake presets resolve their toolchain file out of the NDK, so an
# SDK without it builds nothing. Gradle can fetch most of these itself, but not for
# a plain `mise run build android-arm64-vulkan`.
#
# Installing a package accepts its license, which asking for an Android build is
# taken as consent for. A contributor who would rather not have that happen installs
# the packages themselves.

# The versions arrive as arguments because a tool's post-install step gets neither
# the repository's environment nor its tools, only the paths of the tool it follows.
if [[ $# -ne 3 ]]; then
  echo "usage: ${0##*/} <java-version> <ndk-version> <cmake-version>" >&2
  exit 2
fi

java_version="$1"
ndk_version="$2"
cmake_version="$3"

# A post-install step names the SDK it follows; every other caller means the SDK the
# builds resolve.
sdk_root="${MISE_TOOL_INSTALL_PATH:-${ANDROID_HOME:-}}"
if [[ -z "$sdk_root" ]]; then
  echo "${0##*/}: set ANDROID_HOME to the SDK to install into" >&2
  exit 1
fi

# mise installs the command-line tools under their version, while an SDK from
# Android Studio or a CI image keeps them under `latest`, which sorts last.
sdkmanager="$sdk_root/cmdline-tools/${MISE_TOOL_VERSION:-}/bin/sdkmanager"
if [[ -z "${MISE_TOOL_VERSION:-}" ]]; then
  sdkmanager=""
  while IFS= read -r candidate; do
    sdkmanager="$candidate"
  done < <(find "$sdk_root/cmdline-tools" -mindepth 3 -maxdepth 3 -path '*/bin/sdkmanager' 2>/dev/null | sort)
fi
if [[ ! -x "$sdkmanager" ]]; then
  echo "${0##*/}: no sdkmanager under $sdk_root/cmdline-tools" >&2
  echo "Install the Android SDK command-line tools there, or let mise pin an SDK" >&2
  echo "of its own with \`mise -E android install\`." >&2
  exit 1
fi

# Android tools conventionally discover the command-line tools through
# `cmdline-tools/latest`, while mise installs the pinned version by its number.
# Add the conventional alias without replacing an SDK-managed path.
tools_version_dir="$(cd "$(dirname "$sdkmanager")/.." && pwd)"
latest_tools="$sdk_root/cmdline-tools/latest"
if [[ ! -e "$latest_tools" ]]; then
  ln -s "${tools_version_dir##*/}" "$latest_tools"
fi

# A post-install step runs from wherever mise invoked it.
repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
compile_sdk="$(
  sed -n 's/^android-compileSdk = "\([0-9][0-9]*\)"/\1/p' "$repository_root/gradle/libs.versions.toml" |
    head -n1
)"
if [[ -z "$compile_sdk" ]]; then
  echo "${0##*/}: could not read android-compileSdk from gradle/libs.versions.toml" >&2
  exit 1
fi

# Each package with the directory that proves it is installed, so a rerun against an
# SDK that already has them starts no JVM and reaches no network.
packages=(
  "ndk;${ndk_version}|ndk/${ndk_version}"
  "cmake;${cmake_version}|cmake/${cmake_version}"
  "platforms;android-${compile_sdk}|platforms/android-${compile_sdk}"
  "platform-tools|platform-tools"
)

missing=()
for entry in "${packages[@]}"; do
  if [[ ! -d "$sdk_root/${entry#*|}" ]]; then
    missing+=("${entry%%|*}")
  fi
done

if [[ ${#missing[@]} -eq 0 ]]; then
  exit 0
fi

echo "Installing Android SDK packages: ${missing[*]}"
# sdkmanager runs on a JVM, and a tool's post-install step gets the tool's own paths
# rather than the repository's, so the pinned JDK is requested explicitly.
#
# One `y` per license prompt, as a here-string rather than a pipe: `yes` would take a
# SIGPIPE when sdkmanager stops reading, and that becomes the pipeline's status.
#
# sdkmanager otherwise infers the root from where its own command-line tools sit,
# which is the same directory here, and naming it keeps that an explicit choice.
# It also prints a notice pointing at `android sdk`, its replacement, which downloads
# a further CLI on first use and reports usage metrics by default.
accepts="$(printf 'y\n%.0s' "${missing[@]}")"
mise exec --no-deps "core:java@$java_version" -- \
  "$sdkmanager" --sdk_root="$sdk_root" --install "${missing[@]}" <<<"$accepts"
