#!/usr/bin/env bash
set -euo pipefail

# Run a native build with sccache sharing cache entries across every checkout of
# this repository on the machine.
#
# sccache keys a C/C++ compilation on the preprocessor output, which carries the
# absolute path of every source and header the compiler read. Listing the
# checkouts in SCCACHE_BASEDIRS strips those prefixes from the key, so a Git
# worktree reuses what its siblings already compiled instead of building the
# vendored MapLibre Native core again.
#
# Shared entries also need preprocessor cache mode (SCCACHE_DIRECT) off. That
# mode answers a repeat compilation from a lookup keyed on the source path and
# command line, and its hit restores the depfile stored with the shared object
# entry. That depfile names the headers of whichever checkout first compiled
# the source, so Ninja tracks another worktree's files and misses later header
# edits here. With the mode off, each compilation preprocesses locally, and
# sccache keeps the depfile that local run wrote. The object key stays the
# preprocessed content, so worktrees still share every object.
#
# The server reads both settings once, when it starts, so a new worktree or a
# server started elsewhere means a restart. Stopping the server drains the
# compilations already in flight, which keeps a restart safe during a concurrent
# build.

if [[ $# -eq 0 ]]; then
  echo "usage: ${0##*/} <command> [args...]" >&2
  exit 2
fi

# Git hooks export GIT_DIR / GIT_INDEX_FILE; clear them so `git worktree list`
# resolves the worktree normally when a hook runs this.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR

# Windows checkouts reach sccache through a mix of path separators that the
# basedir match leaves alone, so those keep per-checkout cache entries.
case "$(uname -s)" in
  MINGW* | MSYS* | CYGWIN*) exec "$@" ;;
esac

if ! command -v sccache >/dev/null 2>&1; then
  exec "$@"
fi

basedirs="$(git worktree list --porcelain |
  sed -n 's|^worktree ||p' | sort -u | paste -sd: -)"
if [[ -z "$basedirs" ]]; then
  exec "$@"
fi
export SCCACHE_BASEDIRS="$basedirs" SCCACHE_DIRECT=false

# Reading the stats starts a server when none runs, so the common case already
# picks up the settings above and needs no restart.
normalize() {
  tr ':,' '\n\n' |
    sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s|/*$||' |
    sed '/^$/d' | sort -u
}

stats="$(sccache --show-stats 2>/dev/null || true)"
running="$(printf '%s\n' "$stats" |
  sed -n 's/^Base directories[[:space:]]*//p')"
direct="$(printf '%s\n' "$stats" |
  sed -n 's|^Use direct/preprocessor mode?[[:space:]]*||p')"

if [[ "$direct" == "yes" ]] || ! diff -q \
  <(printf '%s\n' "$running" | normalize) \
  <(printf '%s\n' "$basedirs" | normalize) >/dev/null 2>&1; then
  sccache --stop-server >/dev/null 2>&1 || true
  sccache --start-server >/dev/null
fi

exec "$@"
