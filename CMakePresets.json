{
  "$schema": "https://raw.githubusercontent.com/Kitware/CMake/v3.28.6/Help/manual/presets/schema.json",
  "version": 8,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "_base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/${presetName}/install",
      "cacheVariables": {
        "CMAKE_INSTALL_LIBDIR": "lib",
        "MLN_FFI_ARTIFACT_NAME": "${presetName}"
      }
    },
    {
      "name": "_single-config",
      "hidden": true,
      "inherits": "_base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "_linux-x64",
      "hidden": true,
      "inherits": "_single-config",
      "cacheVariables": { "MLN_FFI_TARGET_ARCHITECTURE": "x64" }
    },
    {
      "name": "_linux-arm64",
      "hidden": true,
      "inherits": "_single-config",
      "cacheVariables": { "MLN_FFI_TARGET_ARCHITECTURE": "arm64" }
    },
    {
      "name": "_macos-arm64",
      "hidden": true,
      "inherits": "_single-config",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.3"
      }
    },
    {
      "name": "_ios-arm64",
      "hidden": true,
      "inherits": "_single-config",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.3"
      }
    },
    {
      "name": "_android",
      "hidden": true,
      "inherits": "_single-config",
      "toolchainFile": "$env{ANDROID_HOME}/ndk/$env{MLN_FFI_ANDROID_NDK_VERSION}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "ANDROID_PLATFORM": "android-24",
        "ANDROID_STL": "c++_shared",
        "MLN_FFI_CARGO_TARGET_DIR": "${sourceDir}/build/${presetName}/cargo",
        "MLN_FFI_ENABLE_CLANG_TIDY": false
      }
    },
    {
      "name": "_android-arm64",
      "hidden": true,
      "inherits": "_android",
      "cacheVariables": { "ANDROID_ABI": "arm64-v8a" }
    },
    {
      "name": "_android-x64",
      "hidden": true,
      "inherits": "_android",
      "cacheVariables": { "ANDROID_ABI": "x86_64" }
    },
    {
      "name": "_ohos-arm64",
      "hidden": true,
      "inherits": "_single-config",
      "toolchainFile": "$env{OHOS_SDK_NATIVE}/build/cmake/ohos.toolchain.cmake",
      "cacheVariables": {
        "OHOS_ARCH": "arm64-v8a",
        "OHOS_STL": "c++_shared",
        "MLN_FFI_ENABLE_CLANG_TIDY": false
      }
    },
    {
      "name": "_windows",
      "hidden": true,
      "inherits": "_base",
      "generator": "Visual Studio 17 2022",
      "cacheVariables": {
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      }
    },
    {
      "name": "_metal",
      "hidden": true,
      "cacheVariables": { "MLN_FFI_RENDER_BACKEND": "metal" }
    },
    {
      "name": "_egl",
      "hidden": true,
      "cacheVariables": {
        "MLN_FFI_RENDER_BACKEND": "opengl",
        "MLN_FFI_OPENGL_CONTEXT_PROVIDER": "egl"
      }
    },
    {
      "name": "_wgl",
      "hidden": true,
      "cacheVariables": {
        "MLN_FFI_RENDER_BACKEND": "opengl",
        "MLN_FFI_OPENGL_CONTEXT_PROVIDER": "wgl"
      }
