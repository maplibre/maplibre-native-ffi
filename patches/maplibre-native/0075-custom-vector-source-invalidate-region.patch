+TEST(CustomVectorTile, InvalidateRegion) {
+    CustomVectorTileTest test;
+
+    std::vector<CanonicalTileID> fetched;
+    std::vector<CanonicalTileID> cancelled;
+    CustomVectorTileLoader loader([&](const CanonicalTileID& tileID) { fetched.push_back(tileID); },
+                                  [&](const CanonicalTileID& tileID) { cancelled.push_back(tileID); });
+    auto mb = std::make_shared<Mailbox>(*Scheduler::GetCurrent());
+    ActorRef<CustomVectorTileLoader> loaderActor(loader, mb);
+
+    // The root tile, every tile at zoom 1, and two tiles at zoom 2.
+    std::vector<OverscaledTileID> tileIDs{OverscaledTileID(0, 0, 0), OverscaledTileID(2, 2, 1), OverscaledTileID(2, 1, 1)};
+    for (uint32_t y = 0; y < 2; y++) {
+        for (uint32_t x = 0; x < 2; x++) {
+            tileIDs.emplace_back(1, x, y);
+        }
+    }
+    std::vector<std::unique_ptr<CustomVectorTile>> tiles;
+    for (const auto& tileID : tileIDs) {
+        tiles.push_back(std::make_unique<CustomVectorTile>(tileID, "source", test.tileParameters, loaderActor));
+        tiles.back()->setNecessity(TileNecessity::Required);
+    }
+    test.loop.waitForEmpty();
+    ASSERT_EQ(tileIDs.size(), fetched.size());
+
+    // Cached data would otherwise answer the refetch.
+    for (const auto& tile : tiles) {
+        loader.setTileData(tile->id.canonical, nullptr, TileDataFormat::MVT);
+    }
+    test.loop.waitForEmpty();
+    fetched.clear();
+
+    // Northeast of the origin, so it intersects the root tile, 1/1/0, and 2/2/1.
+    loader.invalidateRegion(LatLngBounds::hull({10, 10}, {20, 20}));
+    test.loop.waitForEmpty();
+
+    // The render source updates the necessity of a changed tile.
+    for (const auto& tile : tiles) {
+        tile->setNecessity(TileNecessity::Required);
+    }
+    test.loop.waitForEmpty();
+    const std::vector<CanonicalTileID> intersecting{
+        CanonicalTileID(0, 0, 0), CanonicalTileID(1, 1, 0), CanonicalTileID(2, 2, 1)};
+    std::sort(cancelled.begin(), cancelled.end());
+    std::sort(fetched.begin(), fetched.end());
+    EXPECT_EQ(intersecting, cancelled);
+    EXPECT_EQ(intersecting, fetched);
+}
