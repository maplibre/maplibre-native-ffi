+void CustomVectorTileLoader::invalidateRegion(const LatLngBounds& bounds) {
+    std::scoped_lock guard(dataMutex);
+    std::map<uint8_t, util::TileRange> tileRanges;
+    for (auto state = tileStates.begin(); state != tileStates.end();) {
+        const auto zoom = state->first.z;
+        auto tileRange = tileRanges.find(zoom);
+        if (tileRange == tileRanges.end()) {
+            tileRange = tileRanges.emplace(zoom, util::TileRange::fromLatLngBounds(bounds, zoom)).first;
+        }
+        if (tileRange->second.contains(state->first)) {
+            state = invalidate(state);
+        } else {
+            ++state;
+        }
+    }
+}
+
+// Makes every subscriber fetch the tile again when it next needs it, and drops
+// the tile's state and cached data. Returns the state after it.
+CustomVectorTileLoader::TileStates::iterator CustomVectorTileLoader::invalidate(TileStates::iterator state) {
+    const auto tileID = state->first;
     for (auto& subscriber : state->second.subscribers) {
         subscriber.tile.invoke(&CustomVectorTile::invalidateTileData);
     }
     if (state->second.required()) {
         invokeTileCancel(tileID);
     }
-    tileStates.erase(state);
     dataCache.erase(tileID);
+    return tileStates.erase(state);
 }
 
