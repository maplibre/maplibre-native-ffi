+
+void CustomVectorTileLoader::invalidateRegion(const LatLngBounds& bounds) {
+    std::scoped_lock guard(dataMutex);
+    std::map<uint8_t, util::TileRange> tileRanges;
+    for (auto tileCallbacks = tileCallbackMap.begin(); tileCallbacks != tileCallbackMap.end();) {
+        const auto zoom = tileCallbacks->first.z;
+        auto tileRange = tileRanges.find(zoom);
+        if (tileRange == tileRanges.end()) {
+            tileRange = tileRanges.emplace(zoom, util::TileRange::fromLatLngBounds(bounds, zoom)).first;
+        }
+        if (tileRange->second.contains(tileCallbacks->first)) {
+            tileCallbacks = invalidateTileCallbacks(tileCallbacks);
+        } else {
+            ++tileCallbacks;
+        }
+    }
+}
+
+// Makes every tile waiting for the entry's tile fetch it again, and drops the
+// entry and its cached data. Returns the entry after it.
+CustomVectorTileLoader::TileCallbackMap::iterator CustomVectorTileLoader::invalidateTileCallbacks(
+    TileCallbackMap::iterator tileCallbacks) {
+    const auto tileID = tileCallbacks->first;
     for (auto& iter : tileCallbacks->second) {
         auto actor = std::get<2>(iter);
         actor.invoke(&CustomVectorTile::invalidateTileData);
         invokeTileCancel(tileID);
     }
-    tileCallbackMap.erase(tileCallbacks);
     dataCache.erase(tileID);
+    return tileCallbackMap.erase(tileCallbacks);
 }
 
 void CustomVectorTileLoader::invokeTileFetch(const CanonicalTileID& tileID) {
