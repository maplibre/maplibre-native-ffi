@@ -718,6 +718,18 @@ void Transform::cancelTransitions() {
     finishTransitions(finished);
 }
 
+void Transform::cancelTransitions(uint64_t transitionId) {
+    std::vector<std::shared_ptr<Transition>> finished;
+    std::erase_if(transitions, [&](const auto& transition) {
+        if (transition->animation.transitionId != transitionId) return false;
+        finished.push_back(transition);
+        return true;
+    });
+    if (finished.empty()) return;
+    updateMovementFlags();
+    finishTransitions(finished);
+}
+
 void Transform::setGestureInProgress(bool inProgress) {
     state.setGestureInProgress(inProgress);
 }
