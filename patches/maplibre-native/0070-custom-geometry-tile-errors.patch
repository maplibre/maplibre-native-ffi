+TEST(CustomGeometryTile, InvalidateFailedTile) {
+    CustomTileTest test;
+
+    int fetches = 0;
+    CustomTileLoader loader([&](const CanonicalTileID&) { fetches++; }, nullptr);
+    auto mb = std::make_shared<Mailbox>(*Scheduler::GetCurrent());
+    ActorRef<CustomTileLoader> loaderActor(loader, mb);
+
+    StubTileObserver observer;
+    bool failed = false;
+    observer.tileError = [&](Tile&, std::exception_ptr) { failed = true; };
+
+    CustomGeometryTile tile(OverscaledTileID(0, 0, 0),
+                            "source",
+                            test.tileParameters,
+                            makeMutable<CustomGeometrySource::TileOptions>(),
+                            loaderActor,
+                            &observer);
+
+    tile.setNecessity(TileNecessity::Required);
+    test.loop.waitForEmpty();
+    ASSERT_EQ(1, fetches);
+
+    loader.setTileError(CanonicalTileID(0, 0, 0), std::make_exception_ptr(std::runtime_error("failed")));
+    test.loop.waitForEmpty();
+    EXPECT_TRUE(failed);
+
+    loader.invalidateTile(CanonicalTileID(0, 0, 0));
+    test.loop.waitForEmpty();
+
+    // The render source updates the necessity of a changed tile.
+    tile.setNecessity(TileNecessity::Required);
+    test.loop.waitForEmpty();
+    EXPECT_EQ(2, fetches);
+}
