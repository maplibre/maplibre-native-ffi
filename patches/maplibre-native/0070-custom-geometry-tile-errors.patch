+void CustomTileLoader::setTileError(const CanonicalTileID& tileID, std::exception_ptr error) {
+    std::scoped_lock guard(dataMutex);
+    auto state = tileStates.find(tileID);
+    if (state == tileStates.end() || !state->second.required()) return;
+    // The tiles stay subscribed, so invalidating the failed tile or needing it
+    // again fetches it again.
+    state->second.fetching = false;
+    for (auto& subscriber : state->second.subscribers) {
+        subscriber.tile.invoke(&CustomGeometryTile::setTileError, error);
+    }
+    dataCache.erase(tileID);
+}
