Makes OfflineDatabase::put() return before it compresses a response when the
maximum ambient cache size is 0
(https://github.com/maplibre/maplibre-native-ffi/issues/1689). A browser
runtime sets that size for its in-memory database, because the browser's HTTP
cache already holds what the ambient cache would. With no offline regions,
disabled() already skips the write. Once a region exists, put() compressed the
response, failed to make room for it, and logged "Unable to make space for
entry" for every resource a map loaded. It now skips that work and the log. The
result is the same: a cache with no room stores nothing.
Upstream: https://github.com/maplibre/maplibre-native/pull/4931

diff --git a/platform/default/src/mln/storage/offline_database.cpp b/platform/default/src/mln/storage/offline_database.cpp
index 6ca2c98..16a3f74 100644
--- a/platform/default/src/mln/storage/offline_database.cpp
+++ b/platform/default/src/mln/storage/offline_database.cpp
@@ -317,6 +317,11 @@ std::pair<bool, uint64_t> OfflineDatabase::putInternal(const Resource& resource,
         return {false, 0};
     }
 
+    // An ambient cache with no room can't store anything, so skip compressing.
+    if (evict_ && maximumAmbientCacheSize == 0) {
+        return {false, 0};
+    }
+
     std::string compressedData;
     bool compressed = false;
     uint64_t size = 0;
diff --git a/test/storage/offline_database.test.cpp b/test/storage/offline_database.test.cpp
index 3270602..5b32ac8 100644
--- a/test/storage/offline_database.test.cpp
+++ b/test/storage/offline_database.test.cpp
@@ -1245,6 +1245,24 @@ TEST(OfflineDatabase, PutFailsWhenEvictionInsuffices) {
     EXPECT_EQ(0u, log.uncheckedCount());
 }
 
+TEST(OfflineDatabase, PutSkipsZeroSizeAmbientCache) {
+    FixtureLog log;
+    OfflineDatabase db(":memory:", fixture::tileServerOptions);
+    db.setMaximumAmbientCacheSize(0);
+
+    // A region keeps the database enabled, so put() reaches the ambient cache.
+    OfflineTilePyramidRegionDefinition definition{"", LatLngBounds::world(), 0, INFINITY, 1.0, true};
+    ASSERT_TRUE(db.createRegion(definition, OfflineRegionMetadata()));
+
+    Response response;
+    response.data = randomString(1024);
+
+    EXPECT_FALSE(db.put(Resource::style("http://example.com/ambient"), response).first);
+    EXPECT_FALSE(bool(db.get(Resource::style("http://example.com/ambient"))));
+
+    EXPECT_EQ(0u, log.uncheckedCount());
+}
+
