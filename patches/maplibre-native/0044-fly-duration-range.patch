@@ -319,7 +319,20 @@ void Transform::flyTo(const CameraOptions& inputCamera,
         if (animation.velocity) {
             velocity = *animation.velocity / rho;
         }
-        duration = std::chrono::duration_cast<Duration>(std::chrono::duration<double>(S / velocity));
+        const double seconds = S / velocity;
+        // A flight too long for Duration to hold moves the camera at once, as
+        // one longer than maxDuration does. The upper bound is exclusive:
+        // rounding Duration::max() to double can produce one tick beyond its
+        // integer representation.
+        if (std::isfinite(seconds) && seconds >= 0 &&
+            seconds < std::chrono::duration<double>(Duration::max()).count()) {
+            duration = std::chrono::duration_cast<Duration>(std::chrono::duration<double>(seconds));
+        } else {
+            duration = Duration::zero();
+        }
+    }
+    if (!linearZoomInterpolation && animation.maxDuration && duration > *animation.maxDuration) {
+        duration = Duration::zero();
     }
     const double startScale = state.getScale();
     const EdgeInsets startEdgeInsets = state.getEdgeInsets();
