+
+TEST(Transform, FlyTooLongForDurationJumps) {
+    Transform transform;
+    transform.resize({512, 512});
+    const auto camera = CameraOptions().withZoom(1.0);
+    for (const double velocity : {std::numeric_limits<double>::denorm_min(), 1e-12}) {
+        transform.jumpTo(CameraOptions().withZoom(0.0));
+        bool finished = false;
+        AnimationOptions animation;
+        animation.velocity = velocity;
+        animation.transitionFinishFn = [&] { finished = true; };
+        transform.flyTo(camera, animation);
+        EXPECT_DOUBLE_EQ(1.0, transform.getZoom());
+        EXPECT_FALSE(transform.inTransition());
+        EXPECT_TRUE(finished);
+    }
+
+    transform.jumpTo(CameraOptions().withZoom(0.0));
+    AnimationOptions animation;
+    animation.velocity = 1e-9;
+    transform.flyTo(camera, animation);
+    EXPECT_GT(transform.getLatestTransitionDuration(), Duration::zero());
+    EXPECT_TRUE(transform.inTransition());
+    transform.cancelTransitions();
+}
+
+TEST(Transform, FlyPastMaxDurationJumps) {
+    const auto target = CameraOptions().withCenter(LatLng{40.0, -74.0}).withZoom(10.0);
+    const auto start = CameraOptions().withCenter(LatLng{0.0, 0.0}).withZoom(0.0);
+    Transform transform;
+    transform.resize({512, 512});
+    transform.flyTo(target, {});
+    const Duration natural = transform.getLatestTransitionDuration();
+    ASSERT_GT(natural, std::chrono::seconds(1));
+    transform.cancelTransitions();
+
+    // A flight within its maxDuration flies as it would without one.
+    transform.jumpTo(start);
+    AnimationOptions within;
+    within.maxDuration = natural + std::chrono::milliseconds(1);
+    transform.flyTo(target, within);
+    EXPECT_EQ(natural, transform.getLatestTransitionDuration());
+    EXPECT_TRUE(transform.inTransition());
+    transform.cancelTransitions();
+
+    // A longer flight, by a derived or a set duration, jumps.
+    AnimationOptions derived;
+    derived.maxDuration = natural - std::chrono::milliseconds(1);
+    AnimationOptions set{std::chrono::seconds(2)};
+    set.maxDuration = std::chrono::seconds(1);
+    for (const auto& animation : {derived, set}) {
+        transform.jumpTo(start);
+        transform.flyTo(target, animation);
+        EXPECT_FALSE(transform.inTransition());
+        EXPECT_NEAR(10.0, transform.getZoom(), 1e-9);
+        EXPECT_NEAR(40.0, transform.getLatLng().latitude(), 1e-9);
+        EXPECT_NEAR(-74.0, transform.getLatLng().longitude(), 1e-9);
+    }
+
+    // An ease ignores it, even where it reuses the flight.
+    transform.jumpTo(start);
+    AnimationOptions ease{std::chrono::seconds(2)};
+    ease.maxDuration = std::chrono::milliseconds(1);
+    transform.easeTo(target, ease);
+    EXPECT_EQ(Duration{std::chrono::seconds(2)}, transform.getLatestTransitionDuration());
+    EXPECT_TRUE(transform.inTransition());
+}
