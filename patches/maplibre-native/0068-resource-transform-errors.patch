+TEST(OnlineFileSource, FailedResourceTransform) {
+    util::RunLoop loop;
+    std::unique_ptr<FileSource> fs = std::make_unique<OnlineFileSource>(ResourceOptions::Default(), ClientOptions());
+    fs->setResourceTransform(
+        {[](Resource::Kind, const std::string&, ResourceTransform::FinishedCallback finished) {
+            finished(unexpected<Response::Error>(Response::Error{Response::Error::Reason::Other, "No credential"}));
+        }});
+
+    auto req = fs->request({Resource::Unknown, "http://127.0.0.1:3000/test"}, [&](Response res) {
+        ASSERT_NE(nullptr, res.error);
+        EXPECT_EQ(Response::Error::Reason::Other, res.error->reason);
+        EXPECT_EQ("No credential", res.error->message);
+        EXPECT_FALSE(bool(res.data));
+        loop.stop();
+    });
+
+    loop.run();
+}
+
+// A retry of a request that the resource transform failed asks the transform
+// again instead of loading the original URL.
+TEST(OnlineFileSource, TEST_REQUIRES_SERVER(RetryFailedResourceTransform)) {
+    util::RunLoop loop;
+    std::unique_ptr<FileSource> fs = std::make_unique<OnlineFileSource>(ResourceOptions::Default(), ClientOptions());
+
+    std::atomic<int> transforms = 0;
+    fs->setResourceTransform(
+        {[&](Resource::Kind, const std::string& url, ResourceTransform::FinishedCallback finished) {
+            EXPECT_EQ("http://127.0.0.1:3000/delayed", url);
+            if (transforms++ == 0) {
+                finished(unexpected<Response::Error>(Response::Error{Response::Error::Reason::Connection, "Offline"}));
+            } else {
+                finished(std::string("http://127.0.0.1:3000/test"));
+            }
+        }});
+
+    int responses = 0;
+    auto req = fs->request({Resource::Unknown, "http://127.0.0.1:3000/delayed"}, [&](Response res) {
+        switch (responses++) {
+            case 0:
+                ASSERT_NE(nullptr, res.error);
+                EXPECT_EQ(Response::Error::Reason::Connection, res.error->reason);
+                EXPECT_EQ("Offline", res.error->message);
+                // Retry now instead of after the backoff.
+                NetworkStatus::Reachable();
+                break;
+            case 1:
+                EXPECT_EQ(nullptr, res.error);
+                ASSERT_TRUE(res.data.get());
+                EXPECT_EQ("Hello World!", *res.data);
+                EXPECT_EQ(2, transforms);
+                loop.stop();
+                break;
+        }
+    });
+
+    loop.run();
+}
