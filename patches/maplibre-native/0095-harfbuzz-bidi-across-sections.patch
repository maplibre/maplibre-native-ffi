+        std::vector<HBShapeAdjust>{HBShapeAdjust(0, 0, 5), HBShapeAdjust(0, 0, 7)});
+    const auto shaping = shapeTaggedText(labelWithShapedSection(u"", true, u" 12", adjusts),
+                                         WritingModeType::Horizontal);
+    ASSERT_EQ(shaping.positionedLines.size(), 1u);
+    const auto& glyphs = shaping.positionedLines[0].positionedGlyphs;
+    ASSERT_EQ(glyphs.size(), 5u);
+    // "1", "2", and the space advance 12 each, and X its own 5.
+    EXPECT_EQ(glyphs[3].glyph.complex.code, u'X');
+    EXPECT_FLOAT_EQ(glyphs[4].x - glyphs[3].x, 5.0f);
+}
