+// shaped section as characters of the section's direction, which it moves as a
+// block without reversing them again.
+void reorderShapedLines(const TaggedString& formattedString, BiDi& bidi, std::vector<TaggedString>& lines) {
+    const auto& sections = formattedString.getSections();
+    const auto& styledText = formattedString.getStyledText();
+
+    std::u16string bidiText = styledText.first;
+    for (std::size_t i = 0; i < bidiText.size(); ++i) {
+        const auto& section = sections.at(styledText.second[i]);
+        if (section.type != GlyphIDType::FontPBF) {
+            bidiText[i] = section.rtl ? u'\u05D0' : u'a';
+        }
+    }
+    std::vector<bool> blockStyles(sections.size());
+    for (std::size_t i = 0; i < sections.size(); ++i) {
+        blockStyles[i] = sections[i].type != GlyphIDType::FontPBF;
+    }
+
+    std::set<std::size_t> lineBreaks;
+    std::size_t lineEnd = 0;
+    for (const auto& line : lines) {
+        lineEnd += line.length();
+        lineBreaks.insert(lineEnd);
+    }
+
+    lines.clear();
+    for (auto& line : bidi.processStyledText(styledText, lineBreaks, bidiText, blockStyles)) {
+        // A shaped section's adjustments start where its block now starts.
+        auto lineSections = sections;
+        for (std::size_t i = 0; i < lineSections.size(); ++i) {
+            if (!blockStyles[i]) continue;
+            const auto start = std::ranges::find(line.second, static_cast<uint8_t>(i));
+            lineSections[i].startIndex = static_cast<int32_t>(start - line.second.begin());
+        }
+        lines.emplace_back(std::move(line), std::move(lineSections));
+    }
