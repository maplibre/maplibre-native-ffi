Keeps the stencil reference out of the WebGPU pipeline cache key. WebGPU sets
the reference per draw with wgpuRenderPassEncoderSetStencilReference, and no
pipeline descriptor holds it, but hashStencilMode() hashed it and a change of
it reset the drawable's pipeline. Tile clip IDs change whenever the set of
visible tiles does, so panning created a new pipeline, with a descriptor
identical to a cached one, for each new ID. In the browser demo, 131 of the
146 pipelines created while moving were such duplicates; now 15 are created.
Upstream: not proposed

diff --git a/src/mln/webgpu/drawable.cpp b/src/mln/webgpu/drawable.cpp
index 00a303d..f03d554 100644
--- a/src/mln/webgpu/drawable.cpp
+++ b/src/mln/webgpu/drawable.cpp
@@ -51,9 +51,12 @@ struct alignas(16) GlobalUBOIndexData {
     uint32_t pad[3] = {0, 0, 0};
 };
 
+// Hashes the stencil state that a pipeline bakes in. The reference value is
+// dynamic state, which draw() sets with wgpuRenderPassEncoderSetStencilReference,
+// so it stays out: tile clip IDs change as tiles come and go, and keying on them
+// created a new pipeline with the same descriptor for each new ID.
 std::size_t hashStencilMode(const gfx::StencilMode& mode) {
-    std::size_t hash = util::hash(static_cast<int>(mode.ref),
-                                  static_cast<uint32_t>(mode.mask),
+    std::size_t hash = util::hash(static_cast<uint32_t>(mode.mask),
                                   static_cast<int>(mode.fail),
                                   static_cast<int>(mode.depthFail),
                                   static_cast<int>(mode.pass));
@@ -282,9 +285,9 @@ void Drawable::setDepthModeFor3D(const gfx::DepthMode& value) {
 
 void Drawable::setStencilModeFor3D(const gfx::StencilMode& value) {
     const auto newHash = hashStencilMode(value);
-    if (!impl->stencilModeHashValid || impl->stencilModeHash != newHash || impl->stencilMode.ref != value.ref ||
-        impl->stencilMode.mask != value.mask || impl->stencilMode.fail != value.fail ||
-        impl->stencilMode.depthFail != value.depthFail || impl->stencilMode.pass != value.pass) {
+    if (!impl->stencilModeHashValid || impl->stencilModeHash != newHash || impl->stencilMode.mask != value.mask ||
+        impl->stencilMode.fail != value.fail || impl->stencilMode.depthFail != value.depthFail ||
+        impl->stencilMode.pass != value.pass) {
         impl->pipelineState = nullptr;
         impl->stencilModeHashValid = false;
     }
