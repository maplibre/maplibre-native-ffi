+TEST(ImageManager, LateImagesRelayoutOnlyCompletedRequestors) {
+    util::RunLoop runLoop;
+    auto imageManager = ImageManager::create();
+    StubImageManagerObserver observer;
+    imageManager->setObserver(&observer);
+    imageManager->setLoaded(true);
+
+    for (const auto type : {ImageType::Icon, ImageType::Pattern}) {
+        StubImageRequestor completed(imageManager);
+        StubImageRequestor pending(imageManager);
+        StubImageRequestor unrelated(imageManager);
+        const ImageDependencies dependencies{{"one", type}, {"two", type}};
+        imageManager->getImages(completed, {dependencies, 0});
+        runLoop.runOnce();
+        imageManager->notifyIfMissingImageAdded();
+
+        auto pendingDependencies = dependencies;
+        pendingDependencies.emplace("three", type);
+        imageManager->getImages(pending, {pendingDependencies, 0});
+        ASSERT_TRUE(pending.hasPendingRequests());
+        size_t delivered = 0;
+        pending.imagesAvailable = [&](ImageMap icons, ImageMap patterns, ImageVersionMap) {
+            delivered = icons.size() + patterns.size();
+        };
+        imageManager->addImage(makeMutable<style::Image::Impl>("one", PremultipliedImage({16, 16}), 1.0f));
+        imageManager->addImage(makeMutable<style::Image::Impl>("two", PremultipliedImage({16, 16}), 1.0f));
+        // Synchronous layout re-requests its images inside the callback.
+        completed.relayout = [&] { imageManager->getImages(completed, {dependencies, 0}); };
+        imageManager->notifyIfMissingImageAdded();
+        EXPECT_EQ(completed.relayouts, 1u);
+        EXPECT_EQ(pending.relayouts, 0u);
+        EXPECT_EQ(unrelated.relayouts, 0u);
+        EXPECT_EQ(delivered, 0u);
+
+        // done() has run, but delivery still waits for notifyIfMissingImageAdded.
+        runLoop.runOnce();
+        ASSERT_FALSE(pending.hasPendingRequests());
+        imageManager->addImage(makeMutable<style::Image::Impl>("three", PremultipliedImage({16, 16}), 1.0f));
+        imageManager->notifyIfMissingImageAdded();
+        EXPECT_EQ(delivered, 3u);
+        EXPECT_EQ(pending.relayouts, 0u);
+        EXPECT_EQ(completed.relayouts, 1u);
+
+        imageManager->removeImage("one");
+        imageManager->removeImage("two");
+        imageManager->removeImage("three");
+    }
+}
+
+TEST(ImageManager, ReleasedRequestorCancelsQueuedRelayout) {
+    util::RunLoop runLoop;
+    auto imageManager = ImageManager::create();
+    StubImageManagerObserver observer;
+    imageManager->setObserver(&observer);
+    imageManager->setLoaded(true);
+    StubImageRequestor requestor(imageManager);
+    imageManager->getImages(requestor, {ImageDependencies{{"one", ImageType::Icon}}, 0});
+    runLoop.runOnce();
+    imageManager->notifyIfMissingImageAdded();
+    imageManager->addImage(makeMutable<style::Image::Impl>("one", PremultipliedImage({16, 16}), 1.0f));
+    imageManager->removeRequestor(requestor);
+    imageManager->notifyIfMissingImageAdded();
+    EXPECT_EQ(requestor.relayouts, 0u);
+}
