+void GeometryTileWorker::setAvailableImages(Immutable<std::set<std::string>> availableImages_,
+                                            uint64_t correlationID_) {
+    MLN_TRACE_FUNC();
+
+    try {
+        availableImages = std::move(availableImages_);
+        correlationID = correlationID_;
+
+        switch (state) {
+            case Idle:
+                parse();
+                coalesce();
+                break;
+
+            case Coalescing:
+            case NeedsSymbolLayout:
+                state = NeedsParse;
+                break;
+
+            case NeedsParse:
+                break;
+        }
+    } catch (...) {
+        parent.invoke(&GeometryTile::onError, std::current_exception(), correlationID);
+    }
+}
