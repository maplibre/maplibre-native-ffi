+namespace {
+
+// A GeoJSON source rendered with a circle layer. Its data is clustered, which
+// slices a tile within the call in either mode, so whether the tiles complete
+// within an update shows only how they lay out.
+struct SynchronousUpdateSource {
+    explicit SynchronousUpdateSource(SourceTest& test_, bool synchronousUpdate)
+        : test(test_),
+          options(makeOptions(synchronousUpdate)),
+          source("source", options),
+          renderSource(staticImmutableCast<GeoJSONSource::Impl>(source.baseImpl), test.threadPool) {}
+
+    static Immutable<GeoJSONOptions> makeOptions(bool synchronousUpdate) {
+        GeoJSONOptions result;
+        result.cluster = true;
+        result.synchronousUpdate = synchronousUpdate;
+        return makeMutable<GeoJSONOptions>(result);
+    }
+
+    // Sets new data and updates the render source, as a frame would.
+    void update() {
+        source.setGeoJSONData(GeoJSONData::create(
+            mapbox::geojson::parse(R"({"type": "FeatureCollection", "features": [{"type": "Feature", "properties": {},
+                "geometry": {"type": "Point", "coordinates": [1.1, 1.1]}}]})"),
+            Scheduler::GetSequenced(),
+            options));
+        TileParameters parameters = test.tileParameters();
+        parameters.isUpdateSynchronous = source.isUpdateSynchronous();
+        static_cast<RenderSource&>(renderSource).update(source.baseImpl, layers, true, true, parameters);
+    }
+
+    SourceTest& test;
+    Immutable<GeoJSONOptions> options;
+    GeoJSONSource source;
+    RenderGeoJSONSource renderSource;
+    CircleLayer layer{"id", "source"};
+    std::vector<Immutable<LayerProperties>> layers{
+        makeMutable<CircleLayerProperties>(staticImmutableCast<CircleLayer::Impl>(layer.baseImpl))};
+};
+
+} // namespace
+
+TEST(Source, GeoJSONSourceSynchronousUpdateOverrideAppliesToExistingTiles) {
+    SourceTest test;
+
+    SynchronousUpdateSource synchronous(test, true);
+    synchronous.update();
+    EXPECT_TRUE(synchronous.renderSource.isLoaded()); // The tiles complete within the update.
+    synchronous.source.setOverrideSynchronousUpdate(false);
+    synchronous.update();
+    EXPECT_FALSE(synchronous.renderSource.isLoaded()); // The tiles now lay out in the background.
+
+    SynchronousUpdateSource asynchronous(test, false);
+    asynchronous.update();
+    EXPECT_FALSE(asynchronous.renderSource.isLoaded());
+    while (!asynchronous.renderSource.isLoaded()) {
+        test.loop.runOnce();
+    }
+    asynchronous.source.setOverrideSynchronousUpdate(true);
+    asynchronous.update();
+    EXPECT_TRUE(asynchronous.renderSource.isLoaded()); // The tiles now complete within the update.
+}
