+TEST(Source, GeoJSONSourceSynchronousUpdateOverrideReplacesTheOption) {
+    GeoJSONOptions options;
+    options.synchronousUpdate = true;
+    GeoJSONSource source("source", makeMutable<GeoJSONOptions>(options));
+    EXPECT_TRUE(source.isUpdateSynchronous());
+
+    source.setOverrideSynchronousUpdate(false);
+    EXPECT_FALSE(source.isUpdateSynchronous());
+
+    source.setOverrideSynchronousUpdate(true);
+    EXPECT_TRUE(source.isUpdateSynchronous());
+
+    GeoJSONSource asynchronous("asynchronous");
+    EXPECT_FALSE(asynchronous.isUpdateSynchronous());
+    asynchronous.setOverrideSynchronousUpdate(true);
+    EXPECT_TRUE(asynchronous.isUpdateSynchronous());
+}
