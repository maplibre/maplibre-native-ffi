+TEST(Source, GeoJSONSourceSlicesInlineWhileABackgroundSliceRuns) {
+    SourceTest test;
+    // At zoom 3 the index slices its tiles on demand, which fills its tile cache.
+    test.transform.jumpTo(CameraOptions().withCenter(LatLng()).withZoom(3.0));
+    test.transformState = test.transform.getState();
+
+    // Unclustered data slices on this scheduler while the source is asynchronous.
+    auto slicer = std::make_shared<HeldScheduler>();
+    GeoJSONSource source("source");
+    source.setGeoJSONData(GeoJSONData::create(mapbox::geojson::parse(R"({"type": "Polygon",
+        "coordinates": [[[-10, -10], [10, -10], [10, 10], [-10, 10], [-10, -10]]]})"),
+                                              slicer));
+    RenderGeoJSONSource renderSource(staticImmutableCast<GeoJSONSource::Impl>(source.baseImpl), test.threadPool);
+    CircleLayer layer("id", "source");
+    std::vector<Immutable<LayerProperties>> layers{
+        makeMutable<CircleLayerProperties>(staticImmutableCast<CircleLayer::Impl>(layer.baseImpl))};
+    auto update = [&] {
+        TileParameters parameters = test.tileParameters();
+        parameters.isUpdateSynchronous = source.isUpdateSynchronous();
+        static_cast<RenderSource&>(renderSource).update(source.baseImpl, layers, true, true, parameters);
+    };
+
+    update();
+    ASSERT_FALSE(slicer->tasks.empty());
+    EXPECT_FALSE(renderSource.isLoaded());
+
+    // The queued slices run in the background while the source turns
+    // synchronous and recreates its tiles, which slice the same index inline.
+    source.setOverrideSynchronousUpdate(true);
+    std::thread background([tasks = std::exchange(slicer->tasks, {})] {
+        for (const auto& task : tasks) {
+            task();
+        }
+    });
+    update();
+    background.join();
+    EXPECT_TRUE(renderSource.isLoaded()); // The new tiles complete within the update.
+
+    // The background slices reply to tiles that no longer exist.
+    test.loop.runOnce();
+    EXPECT_TRUE(renderSource.isLoaded());
+}
