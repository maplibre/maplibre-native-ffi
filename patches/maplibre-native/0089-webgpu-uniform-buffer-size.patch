Makes a WebGPU uniform buffer report the size its caller asked for, as the
other backends' do, and keeps the rounded-up size for the GPU buffer and its
binding. UniformBufferArray::createOrUpdate() updates a buffer in place only
when the sizes match, and getSize() returned the size rounded up to 256 bytes,
so every update of a uniform block that isn't a multiple of 256 bytes created
a new buffer. A layer's uniform blocks are shared by all of its drawables, so
each of them then built new bind groups. In the browser demo, while moving,
this takes bind groups from about 420 a frame to 125.
Upstream: https://github.com/maplibre/maplibre-native/pull/4938

diff --git a/include/mln/webgpu/uniform_buffer.hpp b/include/mln/webgpu/uniform_buffer.hpp
index 7f2779ffa0..9560bc0e20 100644
--- a/include/mln/webgpu/uniform_buffer.hpp
+++ b/include/mln/webgpu/uniform_buffer.hpp
@@ -25,9 +25,13 @@ public:
 
     WGPUBuffer getBuffer() const { return buffer; }
 
+    /// getSize() rounded up to the uniform buffer alignment
+    std::size_t getAllocatedSize() const { return allocatedSize; }
+
 private:
     Context& context;
     WGPUBuffer buffer = nullptr;
+    std::size_t allocatedSize = 0;
 };
 
 /// Stores a collection of uniform buffers by name
diff --git a/src/mln/webgpu/drawable.cpp b/src/mln/webgpu/drawable.cpp
index 62cf5d4652..6d908d5a3f 100644
--- a/src/mln/webgpu/drawable.cpp
+++ b/src/mln/webgpu/drawable.cpp
@@ -583,7 +583,7 @@ void Drawable::draw(PaintParameters& parameters) const {
 
                                 entry.buffer = webgpuUniform->getBuffer();
                                 entry.offset = 0;
-                                entry.size = buffer->getSize();
+                                entry.size = webgpuUniform->getAllocatedSize();
                                 break;
                             }
                             case ShaderProgram::BindingType::Sampler: {
diff --git a/src/mln/webgpu/uniform_buffer.cpp b/src/mln/webgpu/uniform_buffer.cpp
index b97a3b5034..98d96c88f5 100644
--- a/src/mln/webgpu/uniform_buffer.cpp
+++ b/src/mln/webgpu/uniform_buffer.cpp
@@ -21,10 +21,13 @@ constexpr std::size_t alignedUniformSize(std::size_t size) {
 }
 } // namespace
 
+// getSize() is the requested size, which UniformBufferArray::createOrUpdate() compares
+// to update in place. Only the GPU buffer is rounded up.
 UniformBuffer::UniformBuffer(Context& context_, const void* data, std::size_t size_)
-    : gfx::UniformBuffer(alignedUniformSize(size_)),
-      context(context_) {
-    const std::size_t alignedSize = getSize();
+    : gfx::UniformBuffer(size_),
+      context(context_),
+      allocatedSize(alignedUniformSize(size_)) {
+    const std::size_t alignedSize = allocatedSize;
 
     auto& backend = static_cast<RendererBackend&>(context.getBackend());
     WGPUDevice device = static_cast<WGPUDevice>(backend.getDevice());
@@ -64,7 +67,8 @@ UniformBuffer UniformBuffer::clone() const {
 UniformBuffer::UniformBuffer(UniformBuffer&& other) noexcept
     : gfx::UniformBuffer(std::move(other)),
       context(other.context),
-      buffer(other.buffer) {
+      buffer(other.buffer),
+      allocatedSize(other.allocatedSize) {
     other.buffer = nullptr;
 }
 
