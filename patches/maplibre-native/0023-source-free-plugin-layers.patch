+void projectScreenToPixels(
+    const mln_plugin_frame_context_v1* context, double latitude, double longitude, double* outX, double* outY) {
+    if (!context || !outX || !outY) return;
+    const auto* state = static_cast<const TransformState*>(context->project_state);
+    if (!state) return;
+    // The ABI promises y-down logical pixels with antimeridian unwrapping;
+    // latLngToScreenCoordinate returns wrapped y-up.
+    auto unwrapped = LatLng(latitude, longitude).wrapped();
+    unwrapped.unwrapForShortestPath(state->getLatLng(LatLng::Wrapped));
+    const auto coordinate = state->latLngToScreenCoordinate(unwrapped);
+    *outX = coordinate.x;
+    *outY = state->getSize().height - coordinate.y;
+}
+
+void projectToMercatorPixels(
+    const mln_plugin_frame_context_v1* context, double latitude, double longitude, double* outX, double* outY) {
+    if (!context || !outX || !outY) return;
+    const auto* state = static_cast<const TransformState*>(context->project_state);
+    if (!state) return;
+    auto unwrapped = LatLng(latitude, longitude).wrapped();
+    unwrapped.unwrapForShortestPath(state->getLatLng(LatLng::Wrapped));
+    const auto point = Projection::project(unwrapped, state->getScale());
+    *outX = point.x;
+    *outY = point.y;
+}
+
+void destinationToLatLng(const mln_plugin_frame_context_v1* context,
+                         double latitude,
+                         double longitude,
+                         double distance_meters,
+                         double bearing_deg,
+                         double* out_latitude,
+                         double* out_longitude) {
+    if (!out_latitude || !out_longitude) return;
+    (void)context;
+    const mapbox::cheap_ruler::CheapRuler ruler(latitude, mapbox::cheap_ruler::CheapRuler::Meters);
+    const auto point = ruler.destination(mapbox::cheap_ruler::point(longitude, latitude), distance_meters, bearing_deg);
+    *out_latitude = point.y;
+    *out_longitude = point.x;
+}
