+bool PluginBucket::hasSameGeometry(const PluginBucket& other) const {
+    if (vertexStreams.size() != other.vertexStreams.size() || drawables.size() != other.drawables.size() ||
+        indices->vector() != other.indices->vector()) return false;
+    for (const auto& [id, stream] : vertexStreams) {
+        const auto found = other.vertexStreams.find(id);
+        if (found == other.vertexStreams.end()) return false;
+        const auto& candidate = found->second;
+        if (stream->getRawSize() != candidate->getRawSize() || stream->getRawCount() != candidate->getRawCount() ||
+            std::memcmp(stream->getRawData(), candidate->getRawData(), stream->getRawSize() * stream->getRawCount()) != 0)
+            return false;
+    }
+    for (std::size_t i = 0; i < drawables.size(); ++i) {
+        const auto& a = drawables[i];
+        const auto& b = other.drawables[i];
+        if (a.key != b.key || a.shaderID != b.shaderID || a.attributes != b.attributes ||
+            a.vertexCount != b.vertexCount || a.segments.size() != b.segments.size()) return false;
+        for (std::size_t j = 0; j < a.segments.size(); ++j) {
+            const auto& x = a.segments[j];
+            const auto& y = b.segments[j];
+            if (x.vertexOffset != y.vertexOffset || x.vertexLength != y.vertexLength ||
+                x.indexOffset != y.indexOffset || x.indexLength != y.indexLength) return false;
+        }
