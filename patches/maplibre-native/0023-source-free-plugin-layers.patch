+    (void)context;
+    const mapbox::cheap_ruler::CheapRuler ruler(latitude, mapbox::cheap_ruler::CheapRuler::Meters);
+    const auto point = ruler.destination(mapbox::cheap_ruler::point(longitude, latitude), distance_meters, bearing_deg);
+    *out_latitude = point.y;
+    *out_longitude = point.x;
