+#pragma once
+
+#include <mln/util/chrono.hpp>
+#include <mln/util/geo.hpp>
+
+#include <cstdint>
+#include <functional>
+#include <optional>
+
+namespace mln {
+
+/** How the travel of one momentum component slows over its duration. */
+struct MomentumCurve {
+    Duration duration = Duration::zero();
+
+    /** Travel follows 1 - (1 - t / duration)^exponent. Must be at least 1. */
+    double exponent = 2.0;
+
+    /** When set, travel instead follows an exponential decay at this rate per
+        second: (1 - e^(-rate t)) / (1 - e^(-rate duration)). */
+    std::optional<double> decayRate;
+
+    /** The share of the total travel covered after `elapsed`, from 0 to 1. */
+    double progress(Duration elapsed) const;
+
+    /** The rate at which progress grows after `elapsed`, per second. */
+    double rate(Duration elapsed) const;
+};
+
+/** How fast each component of a momentum moves, in its own unit per second. */
+struct MomentumVelocity {
+    /** Logical pixels per second that the map's content moves on screen. */
+    ScreenCoordinate pan{0, 0};
+    /** Zoom levels per second. */
+    double zoom = 0;
+    /** Degrees per second. */
+    double bearing = 0;
+    /** Degrees per second. */
+    double pitch = 0;
+};
+
+/** How a momentum ended. */
+struct MomentumEnd {
+    /** The speed of the components that were still moving when the momentum
+        was cancelled, as of the last frame that moved the camera. A momentum
+        that ran to its end reports zero. */
+    MomentumVelocity velocity;
+    /** Whether another command took a field that a moving part needed, which
+        stopped that part early. */
+    bool replaced = false;
+};
+
+/** Where the bearing settles once the rest of a momentum ends normally. */
+struct BearingSnap {
+    /** Equally spaced bearings to settle on, starting at `targetOffset`
+        degrees. */
+    uint32_t targetCount = 1;
+    double targetOffset = 0;
+    /** The largest distance, in degrees, from which the bearing settles. */
+    double tolerance = 7;
+    Duration duration = Duration::zero();
+};
+
+/** Camera motion that continues a gesture after its last contact lifts.
+
+    Each component moves its total over its own curve, applied every frame
+    relative to the camera as it stands, so other commands can change the
+    fields that the momentum leaves alone. A command that sets a field stops
+    the components that move it. Pan moves the map's content on screen in
+    short steps, so it travels its distance at any pitch. */
+struct CameraMomentum {
+    /** The screen distance, in logical pixels, that the content moves. */
+    std::optional<ScreenCoordinate> pan;
+    MomentumCurve panCurve;
+
+    /** Zoom levels to add. */
+    std::optional<double> zoom;
+    MomentumCurve zoomCurve;
+    /** The screen point that the zoom keeps in place. */
+    std::optional<ScreenCoordinate> zoomAnchor;
+
+    /** Degrees to add to the bearing. */
+    std::optional<double> bearing;
+    MomentumCurve bearingCurve;
+    /** The screen point that the rotation keeps in place. */
+    std::optional<ScreenCoordinate> bearingAnchor;
+
+    /** Degrees to add to the pitch. */
+    std::optional<double> pitch;
+    MomentumCurve pitchCurve;
+
+    std::optional<BearingSnap> bearingSnap;
+
+    /** Called once when the momentum ends, just before
+        AnimationOptions::transitionFinishFn. */
+    std::function<void(const MomentumEnd&)> finishFn;
+};
+
+} // namespace mln
