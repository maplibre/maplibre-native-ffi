+TEST(Transform, MomentumSettlesOnTargets) {
+    Transform transform;
+    transform.resize({1000, 1000});
+    transform.jumpTo(CameraOptions().withBearing(84));
+    const double rate = frictionRate(Milliseconds(140));
+    CameraMomentum momentum;
+    // Moves (v - 1) / k = 4 degrees, then settles on the nearest of every 90.
+    momentum.bearingVelocity = 1.0 + 4.0 * rate;
+    momentum.bearingSnap = MomentumSnap{.spacing = 90, .tolerance = 7, .duration = Milliseconds(200)};
+    unsigned finished = 0;
+    AnimationOptions animation;
+    animation.transitionFinishFn = [&] {
+        ++finished;
