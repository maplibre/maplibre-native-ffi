+    transform.updateTransitions(start + Seconds(1));
+    EXPECT_NEAR(util::rad2deg(-transform.getBearing()), 88, 1e-9);
+    EXPECT_EQ(finished, 0u);
+    EXPECT_TRUE(transform.isRotating());
+    transform.updateTransitions(start + Milliseconds(1200));
+    EXPECT_NEAR(util::rad2deg(-transform.getBearing()), 90, 1e-9);
+    EXPECT_EQ(finished, 1u);
+
+    // Without motion, instant snaps settle at once: the bearing around the
+    // circle, and the zoom on the nearest whole level. A value outside the
+    // tolerance stays.
+    CameraMomentum snapOnly;
+    snapOnly.bearingSnap = MomentumSnap{.spacing = 360, .tolerance = 7};
+    snapOnly.zoomSnap = MomentumSnap{.spacing = 1, .tolerance = 0.5};
+    snapOnly.pitchSnap = MomentumSnap{.spacing = 90, .tolerance = 7};
+    transform.jumpTo(CameraOptions().withBearing(355).withZoom(7.3).withPitch(30));
+    transform.startMomentum(snapOnly, animation);
+    EXPECT_EQ(finished, 2u);
+    EXPECT_NEAR(util::rad2deg(-transform.getBearing()), 0, 1e-9);
+    EXPECT_NEAR(transform.getZoom(), 7, 1e-9);
+    EXPECT_NEAR(util::rad2deg(transform.getPitch()), 30, 1e-9);
