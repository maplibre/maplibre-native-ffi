+// The value that a part of a momentum moves, for its snap.
+static double momentumValue(const TransformState& state, size_t part) {
+    switch (part) {
+        case 1:
+            return state.getZoom();
+        case 2:
+            return -util::rad2deg(state.getBearing());
+        default:
+            return util::rad2deg(state.getPitch());
+    }
+}
+
+void Transform::startMomentum(const CameraMomentum& options, const AnimationOptions& animation) {
+    auto momentum = std::make_shared<MomentumState>();
+    momentum->options = options;
+    uint16_t moving = 0;
+    uint16_t settling = 0;
+    Duration motion = Duration::zero();
+    using Glide = MomentumState::Glide;
+    if (options.panVelocity) {
+        const double speed = std::hypot(options.panVelocity->x, options.panVelocity->y);
+        if (const auto glide = Glide::plan(speed, options.panDecay)) {
+            momentum->pan = {.fields = Center, .glide = *glide, .moving = true};
+            moving |= Center;
+            motion = glide->duration;
+            const double scale = glide->distance / speed;
+            momentum->panTotal = {options.panVelocity->x * scale, options.panVelocity->y * scale};
+        }
+    }
+    struct Scalar {
+        MomentumState::Part& part;
+        double& total;
+        const std::optional<double>& velocity;
+        const MomentumDecay& decay;
+        const std::optional<ScreenCoordinate>& anchor;
+        const std::optional<MomentumSnap>& snap;
+        uint16_t field;
+    };
+    const std::array<Scalar, 3> scalars{{
+        {momentum->zoom, momentum->zoomTotal, options.zoomVelocity, options.zoomDecay, options.zoomAnchor,
+         options.zoomSnap, Zoom},
+        {momentum->bearing, momentum->bearingTotal, options.bearingVelocity, options.bearingDecay,
+         options.bearingAnchor, options.bearingSnap, Bearing},
+        {momentum->pitch, momentum->pitchTotal, options.pitchVelocity, options.pitchDecay, options.pitchAnchor,
+         options.pitchSnap, Pitch},
+    }};
+    bool instant = true;
+    for (size_t i = 0; i < scalars.size(); ++i) {
+        const auto& scalar = scalars[i];
+        auto& part = scalar.part;
+        part.fields = scalar.field | (scalar.anchor ? Center : 0);
+        const auto glide = scalar.velocity ? Glide::plan(std::abs(*scalar.velocity), scalar.decay) : std::nullopt;
+        if (glide) {
+            part.glide = *glide;
+            part.moving = true;
+            moving |= part.fields;
+            motion = std::max(motion, glide->duration);
+            scalar.total = std::copysign(glide->distance, *scalar.velocity);
+        }
+        // Without motion, a part settles only if it is near a target now.
+        part.snap = scalar.snap;
+        part.snapPending = scalar.snap &&
+                           (part.moving || snapDelta(momentumValue(state, i + 1), *scalar.snap, i == 1) != 0.0);
+        if (part.snapPending) {
+            settling |= part.fields;
+            if (scalar.snap->duration != Duration::zero()) instant = false;
+        }
+    }
+
+    auto transition = std::make_shared<Transition>(animation);
+    transition->fields = moving | settling;
+    transition->coupledFields = 0;
+    transition->movingFields = moving;
+    transition->momentum = momentum;
+    transition->start = latestTransitionStart = Clock::now();
+    transition->duration = latestTransitionDuration = motion;
+
+    // A momentum that doesn't move ends at once, without a camera change, and
+    // instant snaps without motion settle at once.
+    if (!moving && (!settling || instant)) {
+        if (settling) {
+            auto finished = releaseFields(settling);
+            updateMovementFlags();
+            finishTransitions(finished);
+            observer.onCameraWillChange(MapObserver::CameraChangeMode::Immediate);
+            for (size_t i = 0; i < scalars.size(); ++i) {
+                auto& part = scalars[i].part;
+                if (!part.snapPending) continue;
+                part.snapPending = false;
+                stepScalar(i + 1, snapDelta(momentumValue(state, i + 1), *part.snap, i == 1), scalars[i].anchor);
+            }
+        }
+        if (options.finishFn) options.finishFn(momentum->end());
+        if (animation.transitionFinishFn) animation.transitionFinishFn();
+        if (settling) observer.onCameraDidChange(MapObserver::CameraChangeMode::Immediate);
+        return;
+    }
+
+    auto finished = releaseFields(transition->fields);
+    transitions.push_back(transition);
+    updateMovementFlags();
+    finishTransitions(finished);
+
+    // Finish callbacks may replace or cancel the momentum.
+    if (std::find(transitions.begin(), transitions.end(), transition) == transitions.end()) return;
+    observer.onCameraWillChange(MapObserver::CameraChangeMode::Animated);
+}
+
+bool Transform::stepScalar(size_t part, double amount, const std::optional<ScreenCoordinate>& anchor) {
+    switch (part) {
+        case 1:
+            return stepZoom(amount, anchor);
+        case 2:
+            stepBearing(amount, anchor);
+            return true;
+        default:
+            return stepPitch(amount, anchor);
+    }
+}
+
+void Transform::advanceMomentum(Transition& transition, const TimePoint& now) {
+    auto& momentum = *transition.momentum;
+    const auto elapsed = now - transition.start;
+    momentum.elapsed = elapsed;
+
+    const auto advance = [&](MomentumState::Part& part) -> double {
+        if (!part.moving) return 0.0;
+        const double progress = part.glide.progress(elapsed);
+        const double fraction = progress - part.applied;
+        part.applied = progress;
+        if (progress >= 1.0) part.moving = false;
+        return fraction;
+    };
+    // A part that bounds or limits hold in place stops.
+    if (const double fraction = advance(momentum.pan); fraction != 0.0) {
+        if (!stepPan({momentum.panTotal.x * fraction, momentum.panTotal.y * fraction})) momentum.pan.moving = false;
+    }
+    const std::array<std::tuple<MomentumState::Part*, double, const std::optional<ScreenCoordinate>*>, 3> scalars{{
+        {&momentum.zoom, momentum.zoomTotal, &momentum.options.zoomAnchor},
+        {&momentum.bearing, momentum.bearingTotal, &momentum.options.bearingAnchor},
+        {&momentum.pitch, momentum.pitchTotal, &momentum.options.pitchAnchor},
+    }};
+    for (size_t i = 0; i < scalars.size(); ++i) {
+        auto& [part, total, anchor] = scalars[i];
+        if (const double fraction = advance(*part); fraction != 0.0) {
+            if (!stepScalar(i + 1, total * fraction, *anchor)) part->moving = false;
+        }
+        // The part settles once it stops moving, which can be before its
+        // planned end when bounds, limits, or commands stopped it.
+        if (part->snapPending && !part->moving) {
+            part->snapPending = false;
+            const double delta = snapDelta(momentumValue(state, i + 1), *part->snap, i == 1);
+            if (delta != 0.0) {
+                part->snapDelta = delta;
+                part->snapStart = elapsed;
+                transition.duration = std::max(transition.duration, elapsed + part->snap->duration);
+                transition.movingFields |= part->fields;
+            }
+        }
+        if (part->snapDelta) {
+            const auto duration = part->snap->duration;
+            const double t = duration == Duration::zero()
+                                 ? 1.0
+                                 : std::clamp(std::chrono::duration<double>(elapsed - part->snapStart) /
+                                                  std::chrono::duration<double>(duration),
+                                              0.0,
+                                              1.0);
+            const double eased = t >= 1.0 ? 1.0 : util::DEFAULT_TRANSITION_EASE.solve(t, 0.001);
+            const double fraction = eased - part->snapApplied;
+            part->snapApplied = eased;
+            const bool moved = fraction == 0.0 || stepScalar(i + 1, *part->snapDelta * fraction, *anchor);
+            if (t >= 1.0 || !moved) part->snapDelta.reset();
+        }
+    }
+
+    // Parts that ran to their end give up their fields.
+    transition.fields = momentum.retain(transition.fields);
+}
+
+bool Transform::stepPan(const ScreenCoordinate& offset) {
+    // Each step moves the content no farther than a drag moves it in one
+    // event, so the travel on screen stays even at high pitch. A frame that
+    // would need more steps than a frame can afford takes longer ones.
+    constexpr double maxStep = 16.0;
+    constexpr double maxSteps = 100.0;
+    const double distance = std::hypot(offset.x, offset.y);
+    if (!(distance > 0.0)) return true;
+    const LatLng before = getLatLng(LatLng::Unwrapped);
+    const double altitude = state.getCenterAltitude();
+    const double steps = std::min(std::ceil(distance / maxStep), maxSteps);
+    const ScreenCoordinate step{offset.x / steps, offset.y / steps};
+    const bool bounded = state.getLatLngBounds() != LatLngBounds();
+    for (double i = 0; i < steps; ++i) {
+        const ScreenCoordinate point =
+            state.getEdgeInsets().getCenter(state.getSize().width, state.getSize().height) - step;
+        const LatLng unwrapped = screenCoordinateToLatLng(point, LatLng::Unwrapped);
+        CameraOptions camera = CameraOptions().withCenter(bounded ? unwrapped : unwrapped.wrapped());
+        double zoom = state.getZoom();
+        state.constrainCameraAndZoomToBounds(camera, zoom);
+        state.setLatLngZoom(*camera.center, zoom);
+    }
+    state.setCenterAltitude(altitude);
+    return getLatLng(LatLng::Unwrapped) != before;
+}
+
+bool Transform::stepZoom(double zoom, const std::optional<ScreenCoordinate>& anchor) {
+    const double before = state.getZoom();
+    const double altitude = state.getCenterAltitude();
+    std::optional<ScreenCoordinate> point;
+    LatLng anchorLatLng;
+    if (anchor) {
+        point = ScreenCoordinate{anchor->x, state.getSize().height - anchor->y};
+        anchorLatLng = state.screenCoordinateToLatLng(*point);
+    }
+    double target = util::clamp(state.getZoom() + zoom, state.getMinZoom(), state.getMaxZoom());
+    CameraOptions camera = CameraOptions().withCenter(getLatLng(LatLng::Unwrapped));
+    state.constrainCameraAndZoomToBounds(camera, target);
+    state.setLatLngZoom(*camera.center, target);
+    // The altitude in meters holds before the anchor correction, which reads
+    // the projection, and through the correction's change of center.
+    state.setCenterAltitude(altitude);
+    if (point) {
+        state.moveLatLng(anchorLatLng, *point);
+        state.setCenterAltitude(altitude);
+    }
+    return state.getZoom() != before;
+}
+
+void Transform::stepBearing(double bearing, const std::optional<ScreenCoordinate>& anchor) {
+    std::optional<ScreenCoordinate> point;
+    LatLng anchorLatLng;
+    if (anchor) {
+        point = ScreenCoordinate{anchor->x, state.getSize().height - anchor->y};
+        anchorLatLng = state.screenCoordinateToLatLng(*point);
+    }
+    constexpr double pi = std::numbers::pi;
+    state.setBearing(util::wrap(state.getBearing() - util::deg2rad(bearing), -pi, pi));
+    if (point) {
+        // Moving the center keeps the altitude in pixels, so restore it in meters.
+        const double altitude = state.getCenterAltitude();
+        state.moveLatLng(anchorLatLng, *point);
+        state.setCenterAltitude(altitude);
+    }
+}
+
+bool Transform::stepPitch(double pitch, const std::optional<ScreenCoordinate>& anchor) {
+    std::optional<ScreenCoordinate> point;
+    LatLng anchorLatLng;
+    if (anchor) {
+        point = ScreenCoordinate{anchor->x, state.getSize().height - anchor->y};
+        anchorLatLng = state.screenCoordinateToLatLng(*point);
+    }
+    const double before = state.getPitch();
+    state.setPitch(util::clamp(
+        before + util::deg2rad(pitch), state.getMinPitch(), getMaxPitchForEdgeInsets(state.getEdgeInsets())));
+    if (state.getPitch() == before) return false;
+    if (point) {
+        // Moving the center keeps the altitude in pixels, so restore it in meters.
+        const double altitude = state.getCenterAltitude();
+        state.moveLatLng(anchorLatLng, *point);
+        state.setCenterAltitude(altitude);
+    }
+    return true;
+}
+
 void Transform::cancelTransitions() {
     auto finished = std::exchange(transitions, {});
     updateMovementFlags();
