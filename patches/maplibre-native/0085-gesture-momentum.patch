+TEST(Transform, MomentumSettlesTheBearingAfterItsMotion) {
+    Transform transform;
+    transform.resize({1000, 1000});
+    transform.jumpTo(CameraOptions().withBearing(84));
+    CameraMomentum momentum;
+    momentum.bearing = 4.0;
+    momentum.bearingCurve.duration = Milliseconds(100);
+    momentum.bearingSnap = BearingSnap{.targetCount = 4, .targetOffset = 0, .tolerance = 7, .duration = Milliseconds(200)};
+    unsigned finished = 0;
+    AnimationOptions animation;
+    animation.transitionFinishFn = [&] {
+        ++finished;
+    };
+    transform.startMomentum(momentum, animation);
+    const auto start = transform.getLatestTransitionStart();
+    transform.updateTransitions(start + Milliseconds(100));
+    EXPECT_NEAR(util::rad2deg(-transform.getBearing()), 88, 1e-9);
+    EXPECT_EQ(finished, 0u);
+    EXPECT_TRUE(transform.isRotating());
+    transform.updateTransitions(start + Milliseconds(300));
+    EXPECT_NEAR(util::rad2deg(-transform.getBearing()), 90, 1e-9);
+    EXPECT_EQ(finished, 1u);
+
+    // Outside the tolerance, the bearing stays.
+    transform.jumpTo(CameraOptions().withBearing(30));
+    CameraMomentum snapOnly;
+    snapOnly.bearingSnap = BearingSnap{.targetCount = 1, .targetOffset = 0, .tolerance = 7, .duration = Milliseconds(200)};
+    transform.startMomentum(snapOnly, animation);
+    transform.updateTransitions(transform.getLatestTransitionStart());
+    EXPECT_NEAR(util::rad2deg(-transform.getBearing()), 30, 1e-9);
+    EXPECT_EQ(finished, 2u);
+    EXPECT_FALSE(transform.inTransition());
+}
