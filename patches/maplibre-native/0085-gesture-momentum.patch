+#pragma once
+
+#include <mln/util/chrono.hpp>
+#include <mln/util/geo.hpp>
+
+#include <cstdint>
+#include <functional>
+#include <limits>
+#include <optional>
+
+namespace mln {
+
+/** How one part of a momentum slows from its release speed.
+
+    Speeds and distances are in the part's unit: logical pixels for pan, zoom
+    levels for zoom, and degrees for bearing and pitch. */
+struct MomentumDecay {
+    enum class Model {
+        /** The speed halves every `halfLife`, until it drops to `stopSpeed`. */
+        Friction,
+        /** The part moves `distance` over `duration`, along `easing`, as a
+            caller plans it, for example from a platform's own fling physics. */
+        Ease,
+    };
+
+    /** A unit cubic Bézier, from (0, 0) to (1, 1), with these control points. */
+    struct Easing {
+        double x1 = 0;
+        double y1 = 0;
+        double x2 = 0.25;
+        double y2 = 1;
+    };
+
+    Model model = Model::Friction;
+    Duration halfLife = std::chrono::milliseconds(140);
+    /** Must be positive for Model::Friction. */
+    double stopSpeed = 1;
+    /** For Model::Ease. */
+    double distance = 0;
+    Duration duration = Duration::zero();
+    /** For Model::Ease, the share of `distance` covered over the share of
+        `duration`. Android's scroll fling follows (0.175, 0.5, 0.35, 1). */
+    Easing easing;
+    /** A slower release doesn't move. */
+    double minSpeed = 0;
+    /** For Model::Friction, a faster release counts as this speed. */
+    double maxSpeed = std::numeric_limits<double>::infinity();
+    /** The farthest the part moves. A friction release that would move
+        farther starts slower, so it ends sooner, and an eased glide moves at
+        most this far over its duration. */
+    double maxDistance = std::numeric_limits<double>::infinity();
+};
+
+/** How fast each part of a momentum moves, in its own unit per second. */
+struct MomentumVelocity {
+    /** Logical pixels per second that the map's content moves on screen. */
+    ScreenCoordinate pan{0, 0};
+    /** Zoom levels per second. */
+    double zoom = 0;
+    /** Degrees per second. */
+    double bearing = 0;
+    /** Degrees per second. */
+    double pitch = 0;
+};
+
+/** How a momentum ended. */
+struct MomentumEnd {
+    /** The speed of the parts that were still moving when the momentum was
+        cancelled, as of the last frame that moved the camera. A momentum that
+        ran to its end reports zero. */
+    MomentumVelocity velocity;
+    /** Whether another command took a field that a moving part needed, which
+        stopped that part early. */
+    bool replaced = false;
+};
+
+/** Where a part settles once its glide ends normally: on the nearest of the
+    targets every `spacing` from `offset`, when it is within `tolerance` of
+    one. Bearing targets wrap around the circle. */
+struct MomentumSnap {
+    double spacing = 360;
+    double offset = 0;
+    double tolerance = 7;
+    /** Zero settles at once. */
+    Duration duration = Duration::zero();
+};
+
+/** Camera motion that continues a gesture after its last contact lifts.
+
+    Each part starts at its release velocity and slows by its decay, applied
+    every frame relative to the camera as it stands, so other commands can
+    change the fields that the momentum leaves alone. A command that sets a
+    field stops the parts that move it. On a tilted map, pan moves the map's
+    content the same distance on screen in every direction. */
+struct CameraMomentum {
+    /** How fast the map's content moved on screen, in logical pixels per
+        second. */
+    std::optional<ScreenCoordinate> panVelocity;
+    MomentumDecay panDecay;
+
+    /** Zoom levels per second. */
+    std::optional<double> zoomVelocity;
+    MomentumDecay zoomDecay;
+    /** The screen point that the zoom keeps in place. */
+    std::optional<ScreenCoordinate> zoomAnchor;
+    std::optional<MomentumSnap> zoomSnap;
+
+    /** Degrees per second. */
+    std::optional<double> bearingVelocity;
+    MomentumDecay bearingDecay;
+    /** The screen point that the rotation keeps in place. */
+    std::optional<ScreenCoordinate> bearingAnchor;
+    std::optional<MomentumSnap> bearingSnap;
+
+    /** Degrees per second. */
+    std::optional<double> pitchVelocity;
+    MomentumDecay pitchDecay;
+    /** The screen point that the tilt keeps in place. */
+    std::optional<ScreenCoordinate> pitchAnchor;
+    std::optional<MomentumSnap> pitchSnap;
+
+    /** Called once when the momentum ends, just before
+        AnimationOptions::transitionFinishFn. */
+    std::function<void(const MomentumEnd&)> finishFn;
+};
+
+} // namespace mln
