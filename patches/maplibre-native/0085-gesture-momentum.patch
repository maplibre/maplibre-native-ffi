+// MARK: - Momentum
+
+double MomentumCurve::progress(Duration elapsed) const {
+    if (duration <= Duration::zero() || elapsed >= duration) return 1.0;
+    if (elapsed <= Duration::zero()) return 0.0;
+    const double t = std::chrono::duration<double>(elapsed).count();
+    const double total = std::chrono::duration<double>(duration).count();
+    if (decayRate) return std::expm1(-*decayRate * t) / std::expm1(-*decayRate * total);
+    return 1.0 - std::pow(1.0 - t / total, exponent);
+}
+
+double MomentumCurve::rate(Duration elapsed) const {
+    if (duration <= Duration::zero() || elapsed >= duration) return 0.0;
+    const double t = std::max(0.0, std::chrono::duration<double>(elapsed).count());
+    const double total = std::chrono::duration<double>(duration).count();
+    if (decayRate) return *decayRate * std::exp(-*decayRate * t) / -std::expm1(-*decayRate * total);
+    return exponent * std::pow(1.0 - t / total, exponent - 1.0) / total;
+}
+
+struct Transform::MomentumState {
+    struct Component {
+        // The fields that this component needs to keep moving.
+        uint16_t fields = 0;
+        MomentumCurve curve;
+        // The share of the total already applied.
+        double applied = 0;
+        bool moving = false;
+    };
+
+    CameraMomentum options;
+    Component pan;
+    Component zoom;
+    Component bearing;
+    Component pitch;
+    // Whether the bearing may still settle once the components end.
+    bool snapPending = false;
+    // The bearing change that the settling makes, while it runs, and when it
+    // started.
+    std::optional<double> snapDelta;
+    Duration snapStart = Duration::zero();
+    double snapApplied = 0;
+    // Whether another command took a field that a moving part needed.
+    bool replaced = false;
+    // When the last frame applied the momentum, from its start.
+    Duration elapsed = Duration::zero();
+
+    std::array<Component*, 4> components() { return {&pan, &zoom, &bearing, &pitch}; }
+
+    // Stops the parts that lost a field they need, and returns the fields that
+    // the rest still need.
+    uint16_t retain(uint16_t owned) {
+        uint16_t needed = 0;
+        for (auto* component : components()) {
+            if (!component->moving) continue;
+            if ((component->fields & owned) != component->fields) {
+                component->moving = false;
+                replaced = true;
+                continue;
+            }
+            needed |= component->fields;
+        }
+        if (snapPending || snapDelta) {
+            if (owned & Bearing) {
+                needed |= Bearing;
+            } else {
+                if (snapDelta) replaced = true;
+                snapPending = false;
+                snapDelta.reset();
+            }
+        }
+        return needed;
+    }
+
+    // Reports the speed as of the last frame, which left the camera where it
+    // stands.
+    MomentumEnd end() const {
+        MomentumEnd result;
+        result.replaced = replaced;
+        if (pan.moving) {
+            const double rate = pan.curve.rate(elapsed);
+            result.velocity.pan = {options.pan->x * rate, options.pan->y * rate};
+        }
+        if (zoom.moving) result.velocity.zoom = *options.zoom * zoom.curve.rate(elapsed);
+        if (bearing.moving) result.velocity.bearing = *options.bearing * bearing.curve.rate(elapsed);
+        if (pitch.moving) result.velocity.pitch = *options.pitch * pitch.curve.rate(elapsed);
+        return result;
+    }
+};
