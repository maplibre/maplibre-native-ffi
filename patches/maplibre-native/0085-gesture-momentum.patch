+TEST(Transform, MomentumPartsGiveWayToCommands) {
+    Transform transform;
+    transform.resize({1000, 1000});
+    transform.jumpTo(CameraOptions().withZoom(8));
+    CameraMomentum momentum;
+    momentum.pan = ScreenCoordinate{100, 0};
+    momentum.panCurve.duration = Seconds(1);
+    momentum.zoom = 1.0;
+    momentum.zoomCurve.duration = Seconds(1);
+    std::optional<MomentumEnd> ended;
+    momentum.finishFn = [&](const MomentumEnd& end) { ended = end; };
+    transform.startMomentum(momentum);
+    const auto start = transform.getLatestTransitionStart();
+    EXPECT_TRUE(transform.isPanning());
+    EXPECT_TRUE(transform.isScaling());
+
+    transform.jumpTo(CameraOptions().withZoom(3));
+    EXPECT_FALSE(ended);
+    EXPECT_TRUE(transform.isPanning());
+    EXPECT_FALSE(transform.isScaling());
+    const auto before = transform.getLatLng();
+    transform.updateTransitions(start + Milliseconds(500));
+    EXPECT_NEAR(transform.getZoom(), 3, 1e-9);
+    EXPECT_NE(transform.getLatLng().longitude(), before.longitude());
+
+    transform.updateTransitions(start + Seconds(1));
+    ASSERT_TRUE(ended);
+    EXPECT_TRUE(ended->replaced);
+    EXPECT_FALSE(transform.inTransition());
+}
