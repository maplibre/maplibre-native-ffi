+namespace {
+
+// The friction decay rate per second for a half-life.
+double frictionRate(Duration halfLife) {
+    return std::numbers::ln2 / std::chrono::duration<double>(halfLife).count();
+}
+
+MomentumDecay friction(Duration halfLife, double stopSpeed) {
+    MomentumDecay decay;
+    decay.halfLife = halfLife;
+    decay.stopSpeed = stopSpeed;
+    return decay;
+}
+
+} // namespace
+
+TEST(Transform, MomentumSlowsEachPartByFriction) {
+    Transform transform;
+    transform.resize({1000, 1000});
+    transform.jumpTo(CameraOptions().withCenter(LatLng{10, 20}).withZoom(8).withPitch(10));
+    const LatLng center = transform.getLatLng();
+
+    CameraMomentum momentum;
+    momentum.zoomVelocity = 1.0;
+    momentum.zoomDecay = friction(Milliseconds(250), 0.01);
+    momentum.bearingVelocity = -10.0;
+    momentum.pitchVelocity = 5.0;
+    unsigned finished = 0;
+    std::optional<MomentumEnd> ended;
+    momentum.finishFn = [&](const MomentumEnd& end) { ended = end; };
+    AnimationOptions animation;
+    animation.transitionFinishFn = [&] {
+        ++finished;
+    };
+    transform.startMomentum(momentum, animation);
+    const auto start = transform.getLatestTransitionStart();
+    EXPECT_TRUE(transform.inTransition());
+
+    // A speed v that decays at rate k has moved (v / k)(1 - e^(-kt)).
+    const double zoomRate = frictionRate(Milliseconds(250));
+    transform.updateTransitions(start + Milliseconds(500));
+    EXPECT_NEAR(transform.getZoom(), 8 + 1.0 / zoomRate * -std::expm1(-zoomRate * 0.5), 1e-9);
+    EXPECT_EQ(finished, 0u);
+
+    // Each part stops at its stop speed, so it moves (v - stop) / k.
+    const double rate = frictionRate(Milliseconds(140));
+    transform.updateTransitions(start + Seconds(3));
+    EXPECT_NEAR(transform.getZoom(), 8 + (1.0 - 0.01) / zoomRate, 1e-9);
+    EXPECT_NEAR(util::rad2deg(-transform.getBearing()), -(10.0 - 1.0) / rate, 1e-9);
+    EXPECT_NEAR(util::rad2deg(transform.getPitch()), 10 + (5.0 - 1.0) / rate, 1e-9);
+    EXPECT_NEAR(transform.getLatLng().latitude(), center.latitude(), 1e-9);
+    EXPECT_NEAR(transform.getLatLng().longitude(), center.longitude(), 1e-9);
+    EXPECT_EQ(finished, 1u);
+    ASSERT_TRUE(ended);
+    EXPECT_FALSE(ended->replaced);
+    EXPECT_EQ(ended->velocity.zoom, 0);
+    EXPECT_FALSE(transform.inTransition());
+}
+
+TEST(Transform, MomentumPansItsDistanceOnScreen) {
+    Transform transform;
+    transform.resize({1000, 1000});
+    transform.jumpTo(CameraOptions().withCenter(LatLng{10, 20}).withZoom(8));
+    const LatLng center = transform.getLatLng();
+    CameraMomentum momentum;
+    momentum.panVelocity = ScreenCoordinate{1200, -500};
+    transform.startMomentum(momentum);
+    const auto start = transform.getLatestTransitionStart();
+    const double rate = frictionRate(Milliseconds(140));
+
+    transform.updateTransitions(start + Milliseconds(100));
+    const double moved = -std::expm1(-rate * 0.1) / rate;
+    auto point = transform.latLngToScreenCoordinate(center);
+    EXPECT_NEAR(point.x, 500 + 1200 * moved, 1e-6);
+    EXPECT_NEAR(point.y, 500 - 500 * moved, 1e-6);
+
+    transform.updateTransitions(start + Seconds(3));
+    const double distance = (1300.0 - 1.0) / rate;
+    point = transform.latLngToScreenCoordinate(center);
+    EXPECT_NEAR(point.x, 500 + distance * 1200 / 1300, 1e-6);
+    EXPECT_NEAR(point.y, 500 - distance * 500 / 1300, 1e-6);
+    EXPECT_FALSE(transform.inTransition());
+}
