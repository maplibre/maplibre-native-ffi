+TEST(Transform, MomentumReportsItsSpeedWhenCancelled) {
+    Transform transform;
+    transform.resize({1000, 1000});
+    CameraMomentum momentum;
+    momentum.pan = ScreenCoordinate{100, 0};
+    momentum.panCurve.duration = Seconds(1);
+    momentum.zoom = 1.0;
+    momentum.zoomCurve.duration = Seconds(1);
+    std::optional<MomentumEnd> ended;
+    momentum.finishFn = [&](const MomentumEnd& end) { ended = end; };
+    transform.startMomentum(momentum);
+    transform.updateTransitions(transform.getLatestTransitionStart() + Milliseconds(500));
+    transform.cancelTransitions();
+    ASSERT_TRUE(ended);
+    EXPECT_FALSE(ended->replaced);
+    // Halfway through, a power-2 curve moves at its average speed.
+    EXPECT_NEAR(ended->velocity.pan.x, 100, 1e-9);
+    EXPECT_EQ(ended->velocity.pan.y, 0);
+    EXPECT_NEAR(ended->velocity.zoom, 1, 1e-9);
+    EXPECT_FALSE(transform.inTransition());
+}
