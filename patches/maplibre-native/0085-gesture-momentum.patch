+    momentum.zoomVelocity = -1.0;
+    momentum.zoomDecay.model = MomentumDecay::Model::Ease;
+    momentum.zoomDecay.distance = 2;
+    momentum.zoomDecay.duration = Seconds(1);
+    momentum.zoomDecay.easing = {.x1 = 1.0 / 3, .y1 = 1.0 / 3, .x2 = 2.0 / 3, .y2 = 2.0 / 3};
+    std::optional<MomentumEnd> ended;
+    momentum.finishFn = [&](const MomentumEnd& end) { ended = end; };
+    transform.startMomentum(momentum);
+    transform.updateTransitions(transform.getLatestTransitionStart() + Milliseconds(250));
+    EXPECT_NEAR(transform.getZoom(), 8 - 0.5, 1e-6);
+    transform.cancelTransitions();
+    ASSERT_TRUE(ended);
+    EXPECT_NEAR(ended->velocity.zoom, -2, 1e-6);
+
+    transform.startMomentum(momentum);
+    transform.updateTransitions(transform.getLatestTransitionStart() + Seconds(1));
+    EXPECT_NEAR(transform.getZoom(), 8 - 0.5 - 2, 1e-9);
+    EXPECT_FALSE(transform.inTransition());
+}
