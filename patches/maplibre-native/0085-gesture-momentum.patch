+TEST(Transform, MomentumMovesEachPartOnItsCurve) {
+    Transform transform;
+    transform.resize({1000, 1000});
+    transform.jumpTo(CameraOptions().withCenter(LatLng{10, 20}).withZoom(8).withPitch(10));
+    const LatLng center = transform.getLatLng();
+
+    CameraMomentum momentum;
+    momentum.pan = ScreenCoordinate{100, 0};
+    momentum.panCurve.duration = Seconds(1);
+    momentum.zoom = 1.0;
+    momentum.zoomCurve.duration = Seconds(1);
+    momentum.zoomCurve.exponent = 4;
+    momentum.bearing = 10.0;
+    momentum.bearingCurve.duration = Seconds(1);
+    momentum.bearingCurve.decayRate = 3.0;
+    momentum.pitch = 5.0;
+    momentum.pitchCurve.duration = Milliseconds(500);
+    unsigned finished = 0;
+    std::optional<MomentumEnd> ended;
+    momentum.finishFn = [&](const MomentumEnd& end) { ended = end; };
+    AnimationOptions animation;
+    animation.transitionFinishFn = [&] {
+        ++finished;
+    };
+    transform.startMomentum(momentum, animation);
+    const auto start = transform.getLatestTransitionStart();
+    EXPECT_TRUE(transform.inTransition());
+
+    transform.updateTransitions(start + Milliseconds(500));
+    const double bearingShare = std::expm1(-1.5) / std::expm1(-3.0);
+    EXPECT_NEAR(transform.getZoom(), 8 + 0.9375, 1e-9);
+    EXPECT_NEAR(util::rad2deg(-transform.getBearing()), 10 * bearingShare, 1e-9);
+    EXPECT_NEAR(util::rad2deg(transform.getPitch()), 15, 1e-9);
+    EXPECT_EQ(finished, 0u);
+
+    transform.updateTransitions(start + Seconds(1));
+    EXPECT_NEAR(transform.getZoom(), 9, 1e-9);
+    EXPECT_NEAR(util::rad2deg(-transform.getBearing()), 10, 1e-9);
+    EXPECT_EQ(finished, 1u);
+    ASSERT_TRUE(ended);
+    EXPECT_FALSE(ended->replaced);
+    EXPECT_EQ(ended->velocity.pan.x, 0);
+    EXPECT_FALSE(transform.inTransition());
+    EXPECT_NE(transform.getLatLng().longitude(), center.longitude());
+}
