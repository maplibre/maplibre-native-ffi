+namespace {
+
+// Android's OverScroller spline, and the constants it plans a fling with.
+constexpr int splineSamples = 100;
+constexpr double splineInflexion = 0.35;
+constexpr double splineStartTension = 0.5;
+constexpr double splineEndTension = 1.0;
+// SensorManager.GRAVITY_EARTH * inches per meter * pixels per inch * 0.84, for
+// a 160 ppi screen, whose pixels are Android's density-independent pixels.
+constexpr double splinePhysicalCoefficient = 9.80665 * 39.37 * 160.0 * 0.84;
+
+double splineDecelerationRate() {
+    static const double rate = std::log(0.78) / std::log(0.9);
+    return rate;
+}
+
+// The share of a fling's distance that it covers at each hundredth of its
+// duration, as SplineOverScroller computes it.
+const std::array<double, splineSamples + 1>& splinePositions() {
+    static const auto positions = [] {
+        std::array<double, splineSamples + 1> result{};
+        const double p1 = splineStartTension * splineInflexion;
+        const double p2 = 1.0 - splineEndTension * (1.0 - splineInflexion);
+        double xMin = 0.0;
+        for (int i = 0; i < splineSamples; ++i) {
+            const double alpha = static_cast<double>(i) / splineSamples;
+            double xMax = 1.0;
+            double x = 0.0;
+            double coef = 0.0;
+            while (true) {
+                x = xMin + (xMax - xMin) / 2.0;
+                coef = 3.0 * x * (1.0 - x);
+                const double tx = coef * ((1.0 - x) * p1 + x * p2) + x * x * x;
+                if (std::abs(tx - alpha) < 1e-5) break;
+                if (tx > alpha) {
+                    xMax = x;
+                } else {
+                    xMin = x;
+                }
+            }
+            result[i] = coef * ((1.0 - x) * splineStartTension + x) + x * x * x;
+        }
+        result[splineSamples] = 1.0;
+        return result;
+    }();
+    return positions;
+}
+
+} // namespace
+
+struct Transform::MomentumState {
+    // How far one part moves, over how long, and along which curve.
+    struct Glide {
+        double distance = 0;
+        Duration duration = Duration::zero();
+        bool spline = false;
+        // For friction, the decay rate per second.
+        double rate = 0;
+
+        // Plans a release at `speed`, or returns nothing when it doesn't move.
+        static std::optional<Glide> plan(double speed, const MomentumDecay& decay) {
+            if (!(speed > 0.0) || speed < decay.minSpeed) return std::nullopt;
+            speed = std::min(speed, decay.maxSpeed);
+            Glide glide;
+            double seconds = 0.0;
+            if (decay.model == MomentumDecay::Model::Friction) {
+                const double halfLife = std::chrono::duration<double>(decay.halfLife).count();
+                if (!(halfLife > 0.0) || !(decay.stopSpeed > 0.0)) return std::nullopt;
+                glide.rate = std::numbers::ln2 / halfLife;
+                speed = std::min(speed, decay.stopSpeed + glide.rate * decay.maxDistance);
+                if (speed <= decay.stopSpeed) return std::nullopt;
+                seconds = std::log(speed / decay.stopSpeed) / glide.rate;
+                glide.distance = (speed - decay.stopSpeed) / glide.rate;
+            } else {
+                const double rate = splineDecelerationRate();
+                const double coefficient = decay.scrollFriction * splinePhysicalCoefficient;
+                if (!(coefficient > 0.0)) return std::nullopt;
+                double l = std::log(splineInflexion * speed / coefficient);
+                glide.distance = coefficient * std::exp(rate / (rate - 1.0) * l);
+                if (glide.distance > decay.maxDistance) {
+                    l = std::log(decay.maxDistance / coefficient) * (rate - 1.0) / rate;
+                    glide.distance = decay.maxDistance;
+                }
+                seconds = std::exp(l / (rate - 1.0));
+                glide.spline = true;
+            }
+            // A glide too long for the clock doesn't move. The bound is exclusive,
+            // as in flyTo(), because Duration::max() rounds up as a double.
+            if (!(glide.distance > 0.0) || !(seconds > 0.0) ||
+                seconds >= std::chrono::duration<double>(Duration::max()).count()) {
+                return std::nullopt;
+            }
+            glide.duration = std::chrono::duration_cast<Duration>(std::chrono::duration<double>(seconds));
+            if (glide.duration <= Duration::zero()) return std::nullopt;
+            return glide;
+        }
+
+        // The share of the distance covered after `elapsed`, from 0 to 1.
+        double progress(Duration elapsed) const {
+            if (elapsed >= duration) return 1.0;
+            if (elapsed <= Duration::zero()) return 0.0;
+            const double t = std::chrono::duration<double>(elapsed).count();
+            const double total = std::chrono::duration<double>(duration).count();
+            if (!spline) return std::expm1(-rate * t) / std::expm1(-rate * total);
+            const double u = t / total;
+            const auto index = static_cast<size_t>(u * splineSamples);
+            const auto& positions = splinePositions();
+            const double slope = (positions[index + 1] - positions[index]) * splineSamples;
+            return positions[index] + (u - static_cast<double>(index) / splineSamples) * slope;
+        }
+
+        // The share of the distance covered per second after `elapsed`.
+        double speed(Duration elapsed) const {
+            if (elapsed >= duration) return 0.0;
+            const double t = std::max(0.0, std::chrono::duration<double>(elapsed).count());
+            const double total = std::chrono::duration<double>(duration).count();
+            if (!spline) return rate * std::exp(-rate * t) / -std::expm1(-rate * total);
+            const auto index = std::min<size_t>(static_cast<size_t>(t / total * splineSamples), splineSamples - 1);
+            const auto& positions = splinePositions();
+            return (positions[index + 1] - positions[index]) * splineSamples / total;
+        }
+    };
+
+    struct Part {
+        // The fields that this part needs to keep moving.
+        uint16_t fields = 0;
+        Glide glide;
+        // The share of the distance already applied.
+        double applied = 0;
+        bool moving = false;
+    };
+
+    CameraMomentum options;
+    // Each part's distance, with its direction.
+    ScreenCoordinate panTotal{0, 0};
+    double zoomTotal = 0;
+    double bearingTotal = 0;
+    double pitchTotal = 0;
+    Part pan;
+    Part zoom;
+    Part bearing;
+    Part pitch;
+    // Whether the bearing may still settle once the parts end.
+    bool snapPending = false;
+    // The bearing change that the settling makes, while it runs, and when it
+    // started.
+    std::optional<double> snapDelta;
+    Duration snapStart = Duration::zero();
+    double snapApplied = 0;
+    // Whether another command took a field that a moving part needed.
+    bool replaced = false;
+    // When the last frame applied the momentum, from its start.
+    Duration elapsed = Duration::zero();
+
+    std::array<Part*, 4> parts() { return {&pan, &zoom, &bearing, &pitch}; }
+
+    // Stops the parts that lost a field they need, and returns the fields that
+    // the rest still need.
+    uint16_t retain(uint16_t owned) {
+        uint16_t needed = 0;
+        for (auto* part : parts()) {
+            if (!part->moving) continue;
+            if ((part->fields & owned) != part->fields) {
+                part->moving = false;
+                replaced = true;
+                continue;
+            }
+            needed |= part->fields;
+        }
+        if (snapPending || snapDelta) {
+            if (owned & Bearing) {
+                needed |= Bearing;
+            } else {
+                if (snapDelta) replaced = true;
+                snapPending = false;
+                snapDelta.reset();
+            }
+        }
+        return needed;
+    }
+
+    // Reports the speed as of the last frame, which left the camera where it
+    // stands.
+    MomentumEnd end() const {
+        MomentumEnd result;
+        result.replaced = replaced;
+        if (pan.moving) {
+            const double share = pan.glide.speed(elapsed);
+            result.velocity.pan = {panTotal.x * share, panTotal.y * share};
+        }
+        if (zoom.moving) result.velocity.zoom = zoomTotal * zoom.glide.speed(elapsed);
+        if (bearing.moving) result.velocity.bearing = bearingTotal * bearing.glide.speed(elapsed);
+        if (pitch.moving) result.velocity.pitch = pitchTotal * pitch.glide.speed(elapsed);
+        return result;
+    }
+};
+
+// The change that `snap` makes to `bearing`, or zero when the bearing stays.
+static double bearingSnapDelta(double bearing, const BearingSnap& snap) {
+    const double spacing = 360.0 / std::max<uint32_t>(snap.targetCount, 1);
+    const double target = snap.targetOffset + std::round((bearing - snap.targetOffset) / spacing) * spacing;
+    const double delta = target - bearing - 360.0 * std::floor((target - bearing + 180.0) / 360.0);
+    return std::abs(delta) <= snap.tolerance ? delta : 0.0;
+}
