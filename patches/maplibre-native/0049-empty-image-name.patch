diff --git a/test/map/map.test.cpp b/test/map/map.test.cpp
index 721452d9c3ea..5c6681aaa9b8 100644
--- a/test/map/map.test.cpp
+++ b/test/map/map.test.cpp
@@ -1240,6 +1240,57 @@ TEST(Map, NoHangOnMissingImage) {
     test.frontend.render(test.map);
 }
 
+TEST(Map, EmptyImageNameIsNoImage) {
+    MapTest<> test;
+    test.fileSource->glyphsResponse = [](const Resource&) {
+        Response response;
+        response.data = std::make_shared<std::string>(util::read_file("test/fixtures/resources/glyphs.pbf"));
+        return response;
+    };
+    std::vector<std::string> missing;
+    test.observer.styleImageMissingCallback = [&](const std::string& id) {
+        missing.push_back(id);
+    };
+
+    // A style says "no image" with an empty name. A name that depends only on zoom
+    // is already constant per tile, so these depend on feature data.
+    test.map.getStyle().loadJSON(R"STYLE({
+      "version": 8,
+      "glyphs": "https://example.com/{fontstack}/{range}.pbf",
+      "sources": {
+        "polygon": {"type": "geojson", "data": {"type": "Feature", "properties": {"pattern": ""},
+          "geometry": {"type": "Polygon", "coordinates": [[[-10, -10], [10, -10], [10, 10], [-10, 10], [-10, -10]]]}}},
+        "point": {"type": "geojson", "data": {"type": "Feature", "properties": {"icon": "dot"},
+          "geometry": {"type": "Point", "coordinates": [0, 0]}}}
+      },
+      "layers": [{
+        "id": "fill",
+        "type": "fill",
+        "source": "polygon",
+        "paint": {"fill-pattern": ["get", "pattern"]}
+      }, {
+        "id": "symbol",
+        "type": "symbol",
+        "source": "point",
+        "layout": {
+          "icon-image": ["step", ["zoom"], ["get", "icon"], 8, ""],
+          "text-field": "Town",
+          "text-font": ["Open Sans Regular"]
+        }
+      }]
+    })STYLE");
+    test.map.jumpTo(CameraOptions().withCenter(LatLng{0, 0}).withZoom(10));
+    test.frontend.render(test.map);
+
+    EXPECT_THAT(missing, testing::IsEmpty());
+    // The symbol still places its text without an icon.
+    RenderedQueryOptions options;
+    options.layerIDs = {{"symbol"}};
+    const auto size = test.frontend.getSize();
+    const ScreenBox box{{0, 0}, {static_cast<double>(size.width), static_cast<double>(size.height)}};
+    EXPECT_EQ(test.frontend.getRenderer()->queryRenderedFeatures(box, options).size(), 1u);
+}
+
 TEST(Map, PrefetchDeltaOverride) {
     MapTest<> test{1, MapMode::Continuous};
 
