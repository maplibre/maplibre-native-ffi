Treats an empty image name as no image, as the style spec's reference
implementation does, so an icon-image or *-pattern that evaluates to "" is
neither requested nor reported missing
(https://github.com/maplibre/maplibre-native-ffi/issues/819).
Upstream: https://github.com/maplibre/maplibre-native/pull/4927

diff --git a/src/mln/tile/geometry_tile_worker.cpp b/src/mln/tile/geometry_tile_worker.cpp
index c57eabf..123aaac 100644
--- a/src/mln/tile/geometry_tile_worker.cpp
+++ b/src/mln/tile/geometry_tile_worker.cpp
@@ -429,6 +429,8 @@ void GeometryTileWorker::requestNewDependencies(const GlyphDependencies& glyphDe
     // results inline, and layout would finalize without icons if the image
     // dependencies were still unregistered.
     pendingImageDependencies = imageDependencies;
+    // An empty image name means no image, as in the style spec, so don't request it.
+    pendingImageDependencies.erase("");
 
     if (!pendingGlyphDependencies.glyphs.empty()) {
         parent.invoke(&GeometryTile::getGlyphs, pendingGlyphDependencies);
diff --git a/test/map/map.test.cpp b/test/map/map.test.cpp
index d4229cf..38e8c7d 100644
--- a/test/map/map.test.cpp
+++ b/test/map/map.test.cpp
@@ -1298,6 +1298,29 @@ TEST(Map, NoHangOnMissingImage) {
     test.frontend.render(test.map);
 }
 
+TEST(Map, EmptyImageNameIsNoImage) {
+    MapTest<> test;
+    std::vector<std::string> missing;
+    test.observer.onStyleImageMissingCallback = [&](const std::string& id) {
+        missing.push_back(id);
+    };
+
+    test.map.getStyle().loadJSON(R"STYLE({
+      "version": 8,
+      "sources": {
+        "polygon": {"type": "geojson", "data": {"type": "Feature", "properties": {"image": ""},
+          "geometry": {"type": "Polygon", "coordinates": [[[-10, -10], [10, -10], [10, 10], [-10, 10], [-10, -10]]]}}}
+      },
+      "layers": [
+        {"id": "fill", "type": "fill", "source": "polygon", "paint": {"fill-pattern": ["get", "image"]}},
+        {"id": "symbol", "type": "symbol", "source": "polygon", "layout": {"icon-image": ["get", "image"]}}
+      ]
+    })STYLE");
+    test.frontend.render(test.map);
+
+    EXPECT_THAT(missing, testing::IsEmpty());
+}
+
 TEST(Map, PrefetchDeltaOverride) {
     MapTest<> test{1, MapMode::Continuous};
 
