Reports the source layer that each vector-tile source-feature query result came
from. Applies after 0047.
Upstream: not proposed

diff --git a/include/mln/util/feature.hpp b/include/mln/util/feature.hpp
--- a/include/mln/util/feature.hpp
+++ b/include/mln/util/feature.hpp
@@ -21,6 +21,8 @@ using GlobalStateMap = mapbox::base::ValueObject;                          // <p
 class Feature : public GeoJSONFeature {
 public:
     std::string source;
+    /// The source layer a vector tile feature came from. Empty for sources
+    /// without source layers, such as GeoJSON.
     std::string sourceLayer;
     /// The style layer a rendered-feature query matched. A feature that
     /// several layers render is returned once per layer. Empty for features
diff --git a/src/mln/tile/geometry_tile.cpp b/src/mln/tile/geometry_tile.cpp
--- a/src/mln/tile/geometry_tile.cpp
+++ b/src/mln/tile/geometry_tile.cpp
@@ -590,7 +590,8 @@ void GeometryTile::querySourceFeatures(std::vector<Feature>& result,
                     continue;
                 }
 
-                result.emplace_back(convertFeature(*feature, id.canonical));
+                auto& converted = result.emplace_back(convertFeature(*feature, id.canonical));
+                converted.sourceLayer = sourceLayer;
             }
         }
     }
