+// Reads a font file of a font face: an object with a `url`, and with an optional
+// `unicode-range` that limits the code points the font draws. Adds a warning for
+// each range it can't read, and skips the range.
+FontFace parseFontFile(const std::string& faceName, const JSValue& fontFile, std::vector<std::string>& warnings) {
+    FontFace fontFace(faceName, "", {{0, 0x10FFFF}});
+
+    if (fontFile.HasMember("url")) {
+        const JSValue& url = fontFile["url"];
+        if (url.IsString()) fontFace.url = url.GetString();
+    }
+
+    if (fontFile.HasMember("unicode-range")) {
+        const JSValue& unicodeRange = fontFile["unicode-range"];
+        fontFace.ranges.clear();
+        if (unicodeRange.IsArray()) {
+            for (const auto& range : unicodeRange.GetArray()) {
+                if (!range.IsString()) continue;
+                std::string rangeString = range.GetString();
+                if (rangeString.length() <= 2) continue;
+                rangeString = rangeString.substr(2);
+                const std::string::size_type pos = rangeString.find('-');
+                if (pos == std::string::npos) continue;
+                const std::string start = rangeString.substr(0, pos);
+                const std::string end = rangeString.substr(pos + 1);
+                if (start.empty() || end.empty()) continue;
+                auto startInt = util::parse<int>(start, 16);
+                auto endInt = util::parse<int>(end, 16);
+                if (startInt && endInt) {
+                    fontFace.ranges.emplace_back(*startInt, *endInt);
+                } else {
+                    warnings.push_back("Invalid unicode-range in font-face: " + rangeString);
+                }
+            }
+        }
+    }
+
+    return fontFace;
+}
+
+} // namespace
+
+std::shared_ptr<FontFaces> parseFallbackFontFaces(const std::string& json) {
+    rapidjson::GenericDocument<rapidjson::UTF8<>, rapidjson::CrtAllocator> document;
+    document.Parse<0>(json.c_str());
+    if (document.HasParseError()) {
+        throw std::runtime_error(formatJSONParseError(document));
+    }
+    if (!document.IsArray()) {
+        throw std::runtime_error("fallback font faces must be an array");
+    }
+
+    auto fontFaces = std::make_shared<FontFaces>();
+    for (const auto& fontFile : document.GetArray()) {
+        if (!fontFile.IsObject()) {
+            throw std::runtime_error("each fallback font face must be an object");
+        }
+        std::vector<std::string> warnings;
+        FontFace fontFace = parseFontFile("", fontFile, warnings);
+        if (!warnings.empty()) {
+            throw std::runtime_error(warnings.front());
+        }
+        if (fontFace.url.empty()) {
+            throw std::runtime_error("each fallback font face must have a url");
+        }
+        if (fontFace.ranges.empty()) {
+            throw std::runtime_error("each fallback font face must cover a unicode-range");
+        }
+        fontFace.type = genNewGlyphIDType(fontFace.url, FontStack{}, fontFace.ranges);
+        fontFaces->push_back(std::move(fontFace));
+    }
+    return fontFaces;
+}
