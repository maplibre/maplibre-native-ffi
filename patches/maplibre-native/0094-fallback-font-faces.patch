+TEST(StyleParser, FallbackFontFaces) {
+    auto faces = style::parseFallbackFontFaces(
+        R"([{"url": "a.ttf", "unicode-range": ["U+1000-109F", "U+A9E0-A9FF"]}, {"url": "b.ttf"}])");
+    ASSERT_EQ(faces->size(), 2u);
+    EXPECT_EQ((*faces)[0].name, "");
+    EXPECT_EQ((*faces)[0].url, "a.ttf");
+    EXPECT_EQ((*faces)[0].ranges, (std::vector<FontFace::Range>{{0x1000, 0x109F}, {0xA9E0, 0xA9FF}}));
+    EXPECT_EQ((*faces)[1].ranges, (std::vector<FontFace::Range>{{0, 0x10FFFF}}));
+    EXPECT_NE((*faces)[0].type, GlyphIDType::FontPBF);
+
+    EXPECT_THROW(style::parseFallbackFontFaces("{}"), std::runtime_error);
+    EXPECT_THROW(style::parseFallbackFontFaces("[1]"), std::runtime_error);
+    EXPECT_THROW(style::parseFallbackFontFaces(R"([{"unicode-range": ["U+0-FF"]}])"), std::runtime_error);
+    EXPECT_THROW(style::parseFallbackFontFaces(R"([{"url": "a.ttf", "unicode-range": ["U+XYZ-FF"]}])"),
