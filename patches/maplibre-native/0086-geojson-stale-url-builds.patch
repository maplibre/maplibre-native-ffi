+namespace {
+
+std::shared_ptr<const std::string> geoJSONPoints(std::size_t count) {
+    std::string features;
+    for (std::size_t i = 0; i < count; ++i) {
+        features += std::string(i ? "," : "") +
+                    R"({"type": "Feature", "properties": {}, "geometry": {"type": "Point", "coordinates": [0, 0]}})";
+    }
+    return std::make_shared<const std::string>(R"({"type": "FeatureCollection", "features": [)" + features + "]}");
+}
+
+std::size_t geoJSONSourceFeatureCount(const GeoJSONSource& source) {
+    std::size_t count = 0;
+    if (auto data = source.impl().getData().lock()) {
+        data->getTile(
+            CanonicalTileID(0, 0, 0), [&](const GeoJSONData::TileFeatures& features) { count = features.size(); }, true);
+    }
+    return count;
+}
+
+// The background build of a URL response holds the response body until it has
+// queued its reply on the loop. Wait for that, then run the loop through the
+// reply.
+void finishGeoJSONBuild(const std::shared_ptr<const std::string>& body, util::RunLoop& loop) {
+    while (body.use_count() > 1) {
+        std::this_thread::yield();
+    }
+    loop.invoke([&] { loop.stop(); });
+    loop.run();
+}
+
+} // namespace
+
+TEST(Source, GeoJSONSourceDataReplacesBuildingURLData) {
+    util::RunLoop loop;
+    // The background pool lives only while something refers to it.
+    auto background = Scheduler::GetBackground();
+    StubFileSource fileSource(ResourceOptions::Default(), ClientOptions(), StubFileSource::ResponseType::Manual);
+    const auto body = geoJSONPoints(1);
+    fileSource.sourceResponse = [&](const Resource&) {
+        Response response;
+        response.data = body;
+        return response;
+    };
+    StubStyleObserver observer;
+    int loads = 0;
+    observer.sourceLoaded = [&](Source&) { ++loads; };
+
+    GeoJSONSource source("source");
+    source.setObserver(&observer);
+    source.setURL("url");
+    source.loadDescription(fileSource);
+    // The URL's data arrives and starts building in the background.
+    fileSource.respondToAll();
+
+    source.setGeoJSONData(GeoJSONData::create(mapbox::geojson::parse(*geoJSONPoints(2)), Scheduler::GetSequenced()));
+    finishGeoJSONBuild(body, loop);
+
+    EXPECT_EQ(0, loads);
+    EXPECT_EQ(2u, geoJSONSourceFeatureCount(source));
+}
+
+TEST(Source, GeoJSONSourceURLReplacesBuildingURLData) {
+    util::RunLoop loop;
+    // The background pool lives only while something refers to it.
+    auto background = Scheduler::GetBackground();
+    StubFileSource fileSource(ResourceOptions::Default(), ClientOptions(), StubFileSource::ResponseType::Manual);
+    const auto oldBody = geoJSONPoints(1);
+    const auto newBody = geoJSONPoints(2);
+    fileSource.sourceResponse = [&](const Resource& resource) {
+        Response response;
+        response.data = resource.url == "old" ? oldBody : newBody;
+        return response;
+    };
+    StubStyleObserver observer;
+    int loads = 0;
+    observer.sourceLoaded = [&](Source&) { ++loads; };
+
+    GeoJSONSource source("source");
+    source.setObserver(&observer);
+    source.setURL("old");
+    source.loadDescription(fileSource);
+    // The old URL's data arrives and starts building in the background.
+    fileSource.respondToAll();
+
+    source.setURL("new");
+    finishGeoJSONBuild(oldBody, loop);
+
+    EXPECT_EQ(0, loads);
+    EXPECT_FALSE(source.loaded);
+
+    // Request the new URL only now, so that its response can't arrive before
+    // the old build's reply runs.
+    source.loadDescription(fileSource);
+    fileSource.respondToAll();
+    finishGeoJSONBuild(newBody, loop);
+
+    EXPECT_EQ(1, loads);
+    EXPECT_EQ(2u, geoJSONSourceFeatureCount(source));
+}
