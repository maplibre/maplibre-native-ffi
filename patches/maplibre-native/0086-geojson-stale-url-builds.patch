-    for (const auto& [key, value] : pending) {
-        auto& [resource, responseFunction, callback] = value;
+    // Respond to the requests pending now. A callback can cancel or start
+    // requests, so take each one out of `pending` before calling it.
+    std::vector<AsyncRequest*> requests;
+    requests.reserve(pending.size());
+    for (const auto& entry : pending) {
+        requests.push_back(entry.first);
+    }
+    for (AsyncRequest* request : requests) {
+        auto it = pending.find(request);
+        if (it == pending.end()) {
+            continue;
+        }
+        auto [resource, responseFunction, callback] = std::move(it->second);
+        pending.erase(it);
         if (const std::optional<Response> res = responseFunction(resource)) {
             callback(*res);
         }
-        pending.erase(key);
     }
