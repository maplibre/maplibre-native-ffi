+TEST(OfflineDownload, RestartingFromTheTileLimitKeepsTheDownloadActive) {
+    OfflineTest test;
+    auto region = test.createRegion();
+    ASSERT_TRUE(region);
+    test.db.setOfflineMapboxTileCountLimit(0);
+    test.fileSource.styleResponse = [&](const Resource&) {
+        return test.response("mapbox_source.style.json");
+    };
+    test.fileSource.tileResponse = [&](const Resource&) {
+        return test.response("0-0-0.vector.pbf");
+    };
+
+    // The observer raises the limit and restarts the download.
+    OfflineDownload download(region->getID(), worldAtZoom0, test.db, test.fileSource);
+    int limitsExceeded = 0;
+    bool restarting = false;
+    OfflineRegionStatus last;
+    auto observer = std::make_unique<MockObserver>();
+    observer->mapboxTileCountLimitExceededFn = [&](uint64_t) {
+        limitsExceeded++;
+        test.db.setOfflineMapboxTileCountLimit(10);
+        restarting = true;
+        download.setState(OfflineRegionDownloadState::Inactive);
+        download.setState(OfflineRegionDownloadState::Active);
+        restarting = false;
+    };
+    observer->statusChangedFn = [&](OfflineRegionStatus status) {
+        if (status.downloadState == OfflineRegionDownloadState::Inactive && !restarting) {
+            last = status;
+            test.loop.stop();
+        }
+    };
+    download.setObserver(std::move(observer));
+    download.setState(OfflineRegionDownloadState::Active);
+    test.loop.run();
+
+    EXPECT_EQ(1, limitsExceeded);
+    EXPECT_TRUE(last.complete());
+    EXPECT_EQ(1u, last.completedTileCount);
+}
