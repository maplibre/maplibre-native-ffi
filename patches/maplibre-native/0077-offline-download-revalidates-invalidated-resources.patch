+// Downloads a region of a style, a TileJSON, and one tile, then invalidates
+// it. The style and the TileJSON have the bodies the case sets.
+struct RefreshedRegion {
+    OfflineTest test;
+    std::optional<OfflineRegion> region;
+    std::optional<Response> style;
+    std::optional<Response> source;
+    int tileRequests = 0;
+    OfflineRegionStatus downloaded;
+
+    RefreshedRegion() {
+        region = *test.createRegion();
+        style = withData(tileJSONSourceStyle());
+        source = withData(tileJSON("http://127.0.0.1:3000/{z}-{x}-{y}.pbf"));
+        test.fileSource.styleResponse = [&](const Resource&) {
+            return style;
+        };
+        test.fileSource.sourceResponse = [&](const Resource&) {
+            return source;
+        };
+        test.fileSource.tileResponse = [&](const Resource&) {
+            tileRequests++;
+            return withData("tile");
+        };
+        downloaded = downloadUntilInactive(test, region->getID(), worldAtZoom0);
+        EXPECT_TRUE(test.invalidateRegion(region->getID()) == nullptr);
+    }
+
+    // Refreshes the region, expecting one error of `reason`, and checks that
+    // the region keeps every resource, and that the stale tile was refreshed.
+    void refreshKeepingResources(Response::Error::Reason reason) {
+        std::vector<Response::Error> errors;
+        OfflineRegionStatus status = downloadUntilInactive(test, region->getID(), worldAtZoom0, &errors);
+        ASSERT_EQ(1u, errors.size());
+        EXPECT_EQ(reason, errors[0].reason);
+        EXPECT_TRUE(status.requiredResourceCountIsPrecise);
+        EXPECT_EQ(downloaded.completedResourceCount, status.completedResourceCount);
+        EXPECT_EQ(downloaded.completedResourceSize, status.completedResourceSize);
+        EXPECT_EQ(downloaded.completedTileCount, status.completedTileCount);
+        EXPECT_EQ(2, tileRequests);
+        std::optional<Response> tile = test.db.get(
+            Resource::tile("http://127.0.0.1:3000/{z}-{x}-{y}.pbf", 1, 0, 0, 0, Tileset::Scheme::XYZ));
+        ASSERT_TRUE(tile);
+        EXPECT_FALSE(tile->mustRevalidate);
+    }
+};
+
