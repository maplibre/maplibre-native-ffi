+TEST(OfflineDownload, RefreshKeepsTilesThatOnlyAnEarlierStyleListed) {
+    OfflineTest test;
+    auto region = test.createRegion();
+    ASSERT_TRUE(region);
+    const std::string v1 = "http://127.0.0.1:3000/v1/{z}-{x}-{y}.pbf";
+    const std::string v2 = "http://127.0.0.1:3000/v2/{z}-{x}-{y}.pbf";
+    std::string tileURL = v1;
+    test.fileSource.styleResponse = [&](const Resource&) {
+        return withData(inlineSourceStyle(tileURL));
+    };
+    test.fileSource.tileResponse = [&](const Resource& resource) {
+        return withData("tile " + resource.tileData->urlTemplate);
+    };
+    downloadUntilInactive(test, region->getID(), worldAtZoom0);
+
+    // The refreshed style moves the tile to another URL.
+    tileURL = v2;
+    ASSERT_TRUE(test.invalidateRegion(region->getID()) == nullptr);
+    OfflineDownload download(region->getID(), worldAtZoom0, test.db, test.fileSource);
+    OfflineRegionStatus active = runUntilInactive(test, download);
+
+    // While it runs, the refresh counts what the current style lists.
+    EXPECT_TRUE(active.complete());
+    EXPECT_EQ(2u, active.completedResourceCount);
+    EXPECT_EQ(1u, active.completedTileCount);
+    EXPECT_EQ(storedSize("tile " + v2), active.completedTileSize);
+
+    // Once it stops, the status counts the earlier tile as well.
+    OfflineRegionStatus stored = download.getStatus();
+    EXPECT_TRUE(stored.complete());
+    EXPECT_EQ(2u, stored.requiredResourceCount);
+    EXPECT_EQ(1u, stored.requiredTileCount);
+    EXPECT_EQ(3u, stored.completedResourceCount);
+    EXPECT_EQ(2u, stored.completedTileCount);
+    EXPECT_EQ(storedSize("tile " + v1) + storedSize("tile " + v2), stored.completedTileSize);
+
+    std::optional<Response> earlier = test.db.get(Resource::tile(v1, 1, 0, 0, 0, Tileset::Scheme::XYZ));
+    ASSERT_TRUE(earlier);
+    EXPECT_TRUE(earlier->mustRevalidate);
+    std::optional<Response> current = test.db.get(Resource::tile(v2, 1, 0, 0, 0, Tileset::Scheme::XYZ));
+    ASSERT_TRUE(current && current->data);
+    EXPECT_EQ("tile " + v2, *current->data);
+}
