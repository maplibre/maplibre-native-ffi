+TEST(OfflineDownload, PausingFromAnErrorStopsTheRefresh) {
+    RefreshedRegion refreshed;
+    OfflineTest& test = refreshed.test;
+    // One request at a time, so that work the pause failed to stop would
+    // still be queued when the download resumes.
+    test.fileSource.setProperty(MAX_CONCURRENT_REQUESTS_KEY, 1u);
+    refreshed.style = withData("not JSON");
+
+    // The observer pauses the download when it reports the invalid style.
+    OfflineDownload download(refreshed.region->getID(), worldAtZoom0, test.db, test.fileSource);
+    auto observer = std::make_unique<MockObserver>();
+    observer->responseErrorFn = [&](Response::Error) {
+        download.setState(OfflineRegionDownloadState::Inactive);
+        test.loop.stop();
+    };
+    download.setObserver(std::move(observer));
+    download.setState(OfflineRegionDownloadState::Active);
+    test.loop.run();
+    EXPECT_EQ(1, refreshed.tileRequests);
+
+    // Resumed with a valid style, the refresh counts each resource once.
+    refreshed.style = withData(tileJSONSourceStyle());
+    OfflineRegionStatus completed = runUntilInactive(test, download);
+    OfflineRegionStatus stored = download.getStatus();
+    EXPECT_EQ(3u, completed.completedResourceCount);
+    EXPECT_EQ(1u, completed.completedTileCount);
+    EXPECT_EQ(completed.completedResourceCount, stored.completedResourceCount);
+    EXPECT_EQ(completed.completedResourceSize, stored.completedResourceSize);
+    EXPECT_EQ(2, refreshed.tileRequests);
+}
