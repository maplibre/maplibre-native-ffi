+namespace {
+
+const OfflineTilePyramidRegionDefinition worldAtZoom0(
+    "http://127.0.0.1:3000/style.json", LatLngBounds::world(), 0.0, 0.0, 1.0, false);
+
+std::string inlineSourceStyle(const std::string& tileURL) {
+    return R"({"version":8,"sources":{"inline":{"type":"vector","tiles":[")" + tileURL + R"("]}},"layers":[]})";
+}
+
+std::string tileJSONSourceStyle() {
+    return R"({"version":8,"sources":{"remote":{"type":"vector","url":"http://127.0.0.1:3000/tiles.json"}},"layers":[]})";
+}
+
+std::string tileJSON(const std::string& tileURL) {
+    return R"({"tilejson":"2.1.0","tiles":[")" + tileURL + R"("]})";
+}
+
+Response withData(const std::string& data) {
+    Response response;
+    response.data = std::make_shared<std::string>(data);
+    return response;
+}
+
+Response noContent() {
+    Response response;
+    response.noContent = true;
+    return response;
+}
+
+// The status of the region `regionID` as the database reports it while no
+// download runs.
+OfflineRegionStatus storedStatus(OfflineTest& test, int64_t regionID) {
+    return OfflineDownload(regionID, worldAtZoom0, test.db, test.fileSource).getStatus();
+}
+
+Response notFound() {
+    Response response;
+    response.error = std::make_unique<Response::Error>(Response::Error::Reason::NotFound);
+    return response;
+}
+
+} // namespace
