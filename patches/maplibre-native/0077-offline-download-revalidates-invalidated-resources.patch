+TEST(OfflineDownload, RevalidatesOnlyStoredResourcesThatMustBeRevalidated) {
+    OfflineTest test;
+    auto region = test.createRegion();
+    ASSERT_TRUE(region);
+    const OfflineTilePyramidRegionDefinition definition(
+        "http://127.0.0.1:3000/style.json", LatLngBounds::world(), 0.0, 1.0, 1.0, false);
+    const Timestamp past = util::now() - std::chrono::hours(1);
+    const Timestamp future = util::now() + std::chrono::hours(1);
+
+    // The style was sent with Cache-Control: must-revalidate, and has expired.
+    Response style = test.response("inline_source.style.json");
+    style.etag = "style-1";
+    style.mustRevalidate = true;
+    style.expires = past;
+    test.db.put(Resource::style("http://127.0.0.1:3000/style.json"), style);
+
+    // The z0 tile has expired, and the z1 tiles must be revalidated once they
+    // expire.
+    Response expiredTile = test.response("0-0-0.vector.pbf");
+    expiredTile.expires = past;
+    test.db.put(Resource::tile("http://127.0.0.1:3000/{z}-{x}-{y}.vector.pbf", 1, 0, 0, 0, Tileset::Scheme::XYZ),
+                expiredTile);
+    for (int32_t x = 0; x < 2; x++) {
+        for (int32_t y = 0; y < 2; y++) {
+            Response freshTile = test.response("0-0-0.vector.pbf");
+            freshTile.mustRevalidate = true;
+            freshTile.expires = future;
+            test.db.put(
+                Resource::tile("http://127.0.0.1:3000/{z}-{x}-{y}.vector.pbf", 1, x, y, 1, Tileset::Scheme::XYZ),
+                freshTile);
+        }
+    }
+
+    int styleRequests = 0;
+    test.fileSource.styleResponse = [&](const Resource& resource) {
+        styleRequests++;
+        EXPECT_EQ("style-1", resource.priorEtag);
+        Response response;
+        response.notModified = true;
+        response.expires = future;
+        return response;
+    };
+    test.fileSource.tileResponse = [&](const Resource& resource) {
+        ADD_FAILURE() << "requested usable tile " << resource.url;
+        return test.response("0-0-0.vector.pbf");
+    };
+
+    OfflineRegionStatus status = downloadUntilInactive(test, region->getID(), definition);
+
+    EXPECT_EQ(1, styleRequests);
+    EXPECT_EQ(6u, status.completedResourceCount);
+    EXPECT_EQ(test.size, status.completedResourceSize);
+    EXPECT_EQ(5u, status.completedTileCount);
+}
