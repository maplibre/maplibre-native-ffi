+uint64_t storedSize(const std::string& data) {
+    return std::min(data.size(), util::compress(data).size());
+}
+
+// Runs `download` until it goes inactive, and returns its last active status.
+// Collects the errors the download reports in `errors`, and fails on any if
+// it's null.
+OfflineRegionStatus runUntilInactive(OfflineTest& test,
+                                     OfflineDownload& download,
+                                     std::vector<Response::Error>* errors = nullptr) {
+    OfflineRegionStatus completed;
+    auto observer = std::make_unique<MockObserver>();
+    observer->responseErrorFn = [&](Response::Error error) {
+        if (errors) {
+            errors->push_back(error);
+        } else {
+            ADD_FAILURE() << "unexpected error: " << error.message;
+        }
+    };
+    observer->statusChangedFn = [&](OfflineRegionStatus status) {
+        if (status.downloadState == OfflineRegionDownloadState::Active) {
+            completed = status;
+        } else {
+            test.loop.stop();
+        }
+    };
+    download.setObserver(std::move(observer));
+    download.setState(OfflineRegionDownloadState::Active);
+    test.loop.run();
+    return completed;
+}
+
+// Runs a download of `regionID` until it goes inactive, and returns its last
+// active status. The completed counts and sizes that the database reports
+// afterwards must match it, so the region must hold only what its current
+// style lists. Its required counts come from the style, so they still include
+// resources that the download skipped as not found.
+OfflineRegionStatus downloadUntilInactive(OfflineTest& test,
+                                          int64_t regionID,
+                                          const OfflineTilePyramidRegionDefinition& definition,
+                                          std::vector<Response::Error>* errors = nullptr) {
+    OfflineDownload download(regionID, definition, test.db, test.fileSource);
+    OfflineRegionStatus completed = runUntilInactive(test, download, errors);
+    EXPECT_TRUE(completed.complete());
+    OfflineRegionStatus stored = download.getStatus();
+    EXPECT_EQ(completed.completedResourceCount, stored.completedResourceCount);
+    EXPECT_EQ(completed.completedResourceSize, stored.completedResourceSize);
+    EXPECT_EQ(completed.completedTileCount, stored.completedTileCount);
+    EXPECT_EQ(completed.completedTileSize, stored.completedTileSize);
+    return completed;
+}
+
+// Downloads a region of a style and one tile, invalidates it, and downloads it
+// again. The server answers 304 Not Modified for the resources marked, and
+// sends new data for the others.
+void testRefreshInvalidatedRegion(bool styleNotModified, bool tileNotModified) {
+    OfflineTest test;
+    auto region = test.createRegion();
+    ASSERT_TRUE(region);
+    const OfflineTilePyramidRegionDefinition definition(
+        "http://127.0.0.1:3000/style.json", LatLngBounds::world(), 0.0, 0.0, 1.0, false);
+    const Resource styleResource = Resource::style("http://127.0.0.1:3000/style.json");
+    const Resource tileResource = Resource::tile(
+        "http://127.0.0.1:3000/{z}-{x}-{y}.vector.pbf", 1, 0, 0, 0, Tileset::Scheme::XYZ);
+    const Timestamp modified = util::now() - std::chrono::hours(1);
+    const Timestamp expires = util::now() + std::chrono::hours(1);
+
+    const std::string oldStyle = util::read_file("test/fixtures/offline_download/inline_source.style.json");
+    const std::string newStyle = oldStyle + "\n";
+    const std::string oldTile = util::read_file("test/fixtures/offline_download/0-0-0.vector.pbf");
+    const std::string newTile = "new tile";
+
+    auto withData = [&](const std::string& data, const std::string& etag) {
+        Response response;
+        response.data = std::make_shared<std::string>(data);
+        response.etag = etag;
+        response.modified = modified;
+        return response;
+    };
+
+    test.fileSource.styleResponse = [&](const Resource&) {
+        return withData(oldStyle, "style-1");
+    };
+    test.fileSource.tileResponse = [&](const Resource&) {
+        return withData(oldTile, "tile-1");
+    };
+    downloadUntilInactive(test, region->getID(), definition);
+
+    ASSERT_TRUE(test.invalidateRegion(region->getID()) == nullptr);
+
+    auto revalidate = [&](const Resource& resource,
+                          const std::string& priorEtag,
+                          bool notModified,
+                          const std::string& data,
+                          const std::string& etag) {
+        EXPECT_EQ(priorEtag, resource.priorEtag);
+        EXPECT_EQ(modified, resource.priorModified);
+        Response response = withData(data, etag);
+        if (notModified) {
+            response = Response();
+            response.notModified = true;
+        }
+        response.expires = expires;
+        return response;
+    };
+
+    int styleRequests = 0;
+    int tileRequests = 0;
+    test.fileSource.styleResponse = [&](const Resource& resource) {
+        styleRequests++;
+        return revalidate(resource, "style-1", styleNotModified, newStyle, "style-2");
+    };
+    test.fileSource.tileResponse = [&](const Resource& resource) {
+        tileRequests++;
+        return revalidate(resource, "tile-1", tileNotModified, newTile, "tile-2");
+    };
+    OfflineRegionStatus status = downloadUntilInactive(test, region->getID(), definition);
+
+    EXPECT_EQ(1, styleRequests);
+    EXPECT_EQ(1, tileRequests);
+
+    const std::string& style = styleNotModified ? oldStyle : newStyle;
+    const std::string& tile = tileNotModified ? oldTile : newTile;
+    EXPECT_EQ(2u, status.completedResourceCount);
+    EXPECT_EQ(storedSize(style) + storedSize(tile), status.completedResourceSize);
+    EXPECT_EQ(1u, status.completedTileCount);
+    EXPECT_EQ(storedSize(tile), status.completedTileSize);
+
+    auto checkStored = [&](const Resource& resource, const std::string& data, const std::string& etag) {
+        std::optional<Response> stored = test.db.get(resource);
+        ASSERT_TRUE(stored);
+        EXPECT_FALSE(stored->mustRevalidate);
+        EXPECT_EQ(expires, stored->expires);
+        EXPECT_TRUE(stored->isUsable());
+        ASSERT_TRUE(stored->data);
+        EXPECT_EQ(data, *stored->data);
+        EXPECT_EQ(etag, stored->etag);
+    };
+    checkStored(styleResource, style, styleNotModified ? "style-1" : "style-2");
+    checkStored(tileResource, tile, tileNotModified ? "tile-1" : "tile-2");
+}
+
+} // namespace
