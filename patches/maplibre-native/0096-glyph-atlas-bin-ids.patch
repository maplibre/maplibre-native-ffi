+TEST_F(DynamicTextureAtlasTest, GlyphsOfDifferentFontStacksGetTheirOwnAllocations) {
+    // These font stack hashes and code points once gave both glyphs the same bin, as a 32-bit build's
+    // hashes often did for Latin and CJK glyphs, so one drew the other.
+    const auto b = makeGlyph(u'B');
+    const auto a = makeGlyph(u'A');
+    glyphAtlases.push_back(atlas.uploadGlyphs({{0, {{b->id, b}}}, {4, {{a->id, a}}}}));
+    const auto& glyphAtlas = glyphAtlases.back();
+
+    ASSERT_EQ(2u, glyphAtlas.textureHandles.size());
+    EXPECT_NE(glyphAtlas.textureHandles[0].getRectangle(), glyphAtlas.textureHandles[1].getRectangle());
+    EXPECT_NE(glyphAtlas.glyphPositions.at(0).at(b->id).rect, glyphAtlas.glyphPositions.at(4).at(a->id).rect);
+}
+
+TEST_F(DynamicTextureAtlasTest, FontStacksShareTheAllocationOfTheSameGlyph) {
