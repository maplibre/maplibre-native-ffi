+std::optional<TextureHandle> DynamicTextureAtlas::reserveGlyph(const DynamicTexturePtr& dynamicTexture,
+                                                               const Immutable<Glyph>& glyph) {
+    const auto size = Size(glyph->bitmap.size.width + 2 * padding, glyph->bitmap.size.height + 2 * padding);
+    const GlyphAllocationKey key{.dynamicTexture = dynamicTexture.get(), .glyph = glyph.get()};
+
+    // Reuse the bin of this exact glyph; otherwise let the shelf pack assign a fresh id.
+    const auto it = glyphAllocations.find(key);
+    auto texHandle = dynamicTexture->reserveSize(size, it != glyphAllocations.end() ? it->second.binId : -1);
+    if (texHandle && it == glyphAllocations.end()) {
+        glyphAllocations.emplace(key, GlyphAllocation{.glyph = glyph, .binId = texHandle->getId()});
+        glyphAllocationKeys.emplace(BinKey{.dynamicTexture = dynamicTexture.get(), .binId = texHandle->getId()}, key);
+    }
+    return texHandle;
+}
