-    // The last handle was released, so forget the revision; its bin may now be reused by other images.
-    const auto it = imageAllocationKeys.find(
-        BinKey{.dynamicTexture = dynamicTexture.get(), .binId = texHandle.getId()});
-    if (it != imageAllocationKeys.end()) {
+    // The last handle was released, so forget the image revision or glyph; its bin may now be reused.
+    const BinKey binKey{.dynamicTexture = dynamicTexture.get(), .binId = texHandle.getId()};
+    if (const auto it = imageAllocationKeys.find(binKey); it != imageAllocationKeys.end()) {
         imageAllocations.erase(it->second);
         imageAllocationKeys.erase(it);
     }
+    if (const auto it = glyphAllocationKeys.find(binKey); it != glyphAllocationKeys.end()) {
+        glyphAllocations.erase(it->second);
+        glyphAllocationKeys.erase(it);
+    }
 }
 
