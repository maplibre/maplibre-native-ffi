+
+test('Map#globalState', function(t) {
+    t.test('rejects updates before a style is loaded', function(t) {
+        var map = new mbgl.Map({request: function() {}});
+
+        t.throws(function() {
+            map.setGlobalStateProperty('showLabels', false);
