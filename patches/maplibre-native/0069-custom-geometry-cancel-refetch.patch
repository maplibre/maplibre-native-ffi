+// Makes every subscriber fetch the tile again when it next needs it, and drops
+// the tile's state and cached data. Returns the state after it.
+CustomTileLoader::TileStates::iterator CustomTileLoader::invalidate(TileStates::iterator state) {
+    const auto tileID = state->first;
+    for (auto& subscriber : state->second.subscribers) {
+        subscriber.tile.invoke(&CustomGeometryTile::invalidateTileData);
+    }
+    if (state->second.required()) {
+        invokeTileCancel(tileID);
+    }
+    dataCache.erase(tileID);
+    return tileStates.erase(state);
+}
+
+std::vector<CustomTileLoader::Subscriber>::iterator CustomTileLoader::TileState::find(
+    const ActorRef<CustomGeometryTile>& tileRef) {
+    return std::find_if(subscribers.begin(), subscribers.end(), [&](const Subscriber& subscriber) {
+        return subscriber.tile == tileRef;
+    });
+}
+
+bool CustomTileLoader::TileState::required() const {
+    return std::any_of(
+        subscribers.begin(), subscribers.end(), [](const Subscriber& subscriber) { return subscriber.required; });
+}
+
+// Once no tile needs the data, tells the host to stop, and forgets the request
+// so that the next tile to need the data asks for it again.
+void CustomTileLoader::cancelIfUnneeded(const CanonicalTileID& tileID, TileState& state) {
+    if (!state.required()) {
+        state.fetching = false;
+        invokeTileCancel(tileID);
+    }
+}
