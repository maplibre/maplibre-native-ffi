+// Removing state from one feature and setting it on another in the same frame
+// must render both changes in that frame. The removal used to replace the
+// coalesced changes for the source layer, so the other feature kept its old
+// color until a later frame.
+TEST(Map, FeatureStateRemoveAndSetInOneFrame) {
+    MapTest<> test;
+
+    test.map.getStyle().loadJSON(R"STYLE({
+      "version": 8,
+      "sources": {
+        "fs": {
+          "type": "geojson",
+          "data": {
+            "type": "FeatureCollection",
+            "features": [{
+              "type": "Feature",
+              "id": 1,
+              "properties": {},
+              "geometry": {
+                "type": "Polygon",
+                "coordinates": [[[-180, -85], [0, -85], [0, 85], [-180, 85], [-180, -85]]]
+              }
+            }, {
+              "type": "Feature",
+              "id": 2,
+              "properties": {},
+              "geometry": {
+                "type": "Polygon",
+                "coordinates": [[[0, -85], [180, -85], [180, 85], [0, 85], [0, -85]]]
+              }
+            }]
+          }
+        }
+      },
+      "layers": [{
+        "id": "fill",
+        "type": "fill",
+        "source": "fs",
+        "paint": {
+          "fill-color": ["case", ["boolean", ["feature-state", "active"], false], "#ff0000", "#0000ff"]
+        }
+      }]
+    })STYLE");
+
+    test.map.jumpTo(CameraOptions().withCenter(LatLng{0, 0}).withZoom(0.0));
+
+    auto* renderer = test.frontend.getRenderer();
+
+    // Reads one channel (0=R, 1=G, 2=B) of the pixel at a quarter (feature 1)
+    // or three quarters (feature 2) of the width, at mid height
+    const auto channel = [](const PremultipliedImage& image, size_t quarter, size_t channel) -> int {
+        const size_t x = image.size.width * quarter / 4;
+        const size_t y = image.size.height / 2;
+        return image.data.get()[y * image.stride() + x * image.channels + channel];
+    };
+
+    {
+        const auto result = test.frontend.render(test.map);
+        EXPECT_LT(channel(result.image, 1, 0), 40) << "feature 1 red channel (default)";
+        EXPECT_LT(channel(result.image, 3, 0), 40) << "feature 2 red channel (default)";
+    }
+
+    FeatureState active;
+    active["active"] = true;
+    renderer->setFeatureState("fs", {}, "1", active);
+    {
+        const auto result = test.frontend.render(test.map);
+        EXPECT_GT(channel(result.image, 1, 0), 200) << "feature 1 red channel (active)";
+        EXPECT_LT(channel(result.image, 3, 0), 40) << "feature 2 red channel (default)";
+    }
+
+    renderer->removeFeatureState("fs", {}, std::optional<std::string>("1"), {});
+    renderer->setFeatureState("fs", {}, "2", active);
+    {
+        const auto result = test.frontend.render(test.map);
+        EXPECT_LT(channel(result.image, 1, 0), 40) << "feature 1 red channel (removed)";
+        EXPECT_GT(channel(result.image, 1, 2), 200) << "feature 1 blue channel (removed)";
+        EXPECT_GT(channel(result.image, 3, 0), 200) << "feature 2 red channel (active)";
+        EXPECT_LT(channel(result.image, 3, 2), 40) << "feature 2 blue channel (active)";
+    }
+}
+
