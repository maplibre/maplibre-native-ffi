             }
         }
-        changes[sourceLayer] = std::move(layerStates);
+        auto& layerChanges = changes[sourceLayer];
+        for (auto& [featureID, featureState] : layerStates) {
+            layerChanges[featureID] = std::move(featureState);
+        }
     }
 
