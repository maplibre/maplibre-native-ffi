+void CustomTileLoader::setTileError(const CanonicalTileID& tileID, std::exception_ptr error) {
+    std::scoped_lock guard(dataMutex);
+    auto iter = tileCallbackMap.find(tileID);
+    if (iter == tileCallbackMap.end()) return;
+    for (auto& tuple : iter->second) {
+        auto actor = std::get<2>(tuple);
+        actor.invoke(&CustomGeometryTile::setTileError, error);
+    }
+    // Keep the callbacks, so invalidating the failed tile fetches it again.
+    dataCache.erase(tileID);
+}
