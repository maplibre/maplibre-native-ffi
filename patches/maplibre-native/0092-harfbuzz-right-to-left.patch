+std::vector<BiDiRun> BiDi::visualRuns(const std::u16string& input) {
+    std::vector<BiDiRun> runs;
+    if (input.empty()) return runs;
+
+    UErrorCode errorCode = U_ZERO_ERROR;
+    ubidi_setPara(impl->bidiText,
+                  mln::utf16char_cast<const UChar*>(input.c_str()),
+                  static_cast<int32_t>(input.size()),
+                  UBIDI_DEFAULT_LTR,
+                  nullptr,
+                  &errorCode);
+    if (U_FAILURE(errorCode)) {
+        return {{input, false}};
+    }
+
+    const int32_t runCount = ubidi_countRuns(impl->bidiText, &errorCode);
+    if (U_FAILURE(errorCode) || runCount <= 0) {
+        return {{input, false}};
+    }
+
+    runs.reserve(static_cast<std::size_t>(runCount));
+    for (int32_t runIndex = 0; runIndex < runCount; runIndex++) {
+        int32_t logicalStart = 0;
+        int32_t length = 0;
+        const UBiDiDirection direction = ubidi_getVisualRun(impl->bidiText, runIndex, &logicalStart, &length);
+        if (length <= 0) continue;
+        runs.push_back({input.substr(static_cast<std::size_t>(logicalStart), static_cast<std::size_t>(length)),
+                        direction == UBIDI_RTL});
+    }
+
+    if (runs.empty()) runs.push_back({input, false});
+    return runs;
+}
