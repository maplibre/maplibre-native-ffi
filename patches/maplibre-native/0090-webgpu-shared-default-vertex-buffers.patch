+const VertexBufferResource& Context::getDefaultVertexBuffer(gfx::AttributeDataType type, std::size_t size) {
+    auto& buffers = defaultVertexBuffers[type];
+    if (!buffers.empty() && buffers.back()->getSizeInBytes() >= size) {
+        return *buffers.back();
+    }
+
+    // Grow geometrically, so a context keeps few of these.
+    const std::size_t previous = buffers.empty() ? 0 : buffers.back()->getSizeInBytes();
+    const std::size_t capacity = std::max<std::size_t>({size, previous * 2, 256});
+
+    // Colors default to opaque white and opacities to fully opaque. Every other
+    // attribute defaults to zero.
+    std::vector<uint8_t> data(capacity, 0);
+    if (type == gfx::AttributeDataType::Float4 || type == gfx::AttributeDataType::Float2) {
+        auto* const values = reinterpret_cast<float*>(data.data());
+        std::fill(values, values + capacity / sizeof(float), 1.0f);
+    }
+    auto buffer = createBuffer(data.data(), capacity, WGPUBufferUsage_Vertex, false, true);
+    if (!buffer.getBuffer()) {
+        Log::Error(Event::Render, "WebGPU: Failed to create a default vertex buffer");
+    }
+    buffers.push_back(std::make_unique<VertexBufferResource>(std::move(buffer)));
+    return *buffers.back();
+}
