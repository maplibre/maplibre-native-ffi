diff --git a/test/renderer/vulkan_acquire.test.cpp b/test/renderer/vulkan_acquire.test.cpp
new file mode 100644
--- /dev/null
+++ b/test/renderer/vulkan_acquire.test.cpp
@@ -0,0 +1,126 @@
+#if MLN_RENDER_BACKEND_VULKAN
+#include <gtest/gtest.h>
+
+#include <cstdint>
+#include <type_traits>
+
+#include <mln/gfx/backend_scope.hpp>
+#include <mln/vulkan/context.hpp>
+#include <mln/vulkan/headless_backend.hpp>
+#include <mln/vulkan/renderable_resource.hpp>
+
+namespace {
+
+template <typename T>
+T fakeHandle() {
+    if constexpr (std::is_pointer_v<T>)
+        return reinterpret_cast<T>(uintptr_t{1});
+    else
+        return T{1};
+}
+
+// Keep real device resources and frame fences, replacing only WSI acquisition.
+class TestSurfaceResource final : public mln::vulkan::SurfaceRenderableResource {
+public:
+    explicit TestSurfaceResource(mln::vulkan::RendererBackend& backend_)
+        : SurfaceRenderableResource(backend_) {
+        init(64, 64);
+        acquireSemaphores.emplace_back(
+            backend.getDevice()->createSemaphoreUnique({}, nullptr, backend.getDispatcher()));
+        surface = vk::UniqueSurfaceKHR(vk::SurfaceKHR(fakeHandle<VkSurfaceKHR>()), {});
+    }
+    ~TestSurfaceResource() override { surface.release(); }
+    void createPlatformSurface() override {}
+    void bind() override {}
+    uint64_t getAcquireTimeout() const override { return 16'000'000; }
+    void makeHeadless() { surface.release(); }
+};
+
+struct AcquireProbe {
+    VkResult result = VK_TIMEOUT;
+    uint64_t timeout = 0;
+    unsigned acquisitions = 0;
+    unsigned recordings = 0;
+    unsigned fenceResets = 0;
+    unsigned submissions = 0;
+    PFN_vkBeginCommandBuffer begin = nullptr;
+    PFN_vkResetFences reset = nullptr;
+    PFN_vkQueueSubmit submit = nullptr;
+};
+thread_local AcquireProbe* probe = nullptr;
+
+VKAPI_ATTR VkResult VKAPI_CALL acquire(VkDevice, VkSwapchainKHR, uint64_t timeout, VkSemaphore, VkFence, uint32_t*) {
+    probe->timeout = timeout;
+    ++probe->acquisitions;
+    return probe->result;
+}
+VKAPI_ATTR VkResult VKAPI_CALL begin(VkCommandBuffer buffer, const VkCommandBufferBeginInfo* info) {
+    ++probe->recordings;
+    return probe->begin(buffer, info);
+}
+VKAPI_ATTR VkResult VKAPI_CALL reset(VkDevice device, uint32_t count, const VkFence* fences) {
+    ++probe->fenceResets;
+    return probe->reset(device, count, fences);
+}
+VKAPI_ATTR VkResult VKAPI_CALL submit(VkQueue queue, uint32_t count, const VkSubmitInfo* info, VkFence fence) {
+    ++probe->submissions;
+    return probe->submit(queue, count, info, fence);
+}
+
+TEST(VulkanAcquire, UnavailableImagePreservesFrameResources) {
+    mln::vulkan::HeadlessBackend backend({64, 64});
+    mln::gfx::BackendScope scope(backend);
+    auto& context = backend.getContext<mln::vulkan::Context>();
+    auto resource = std::make_unique<TestSurfaceResource>(backend);
+    auto* surface = resource.get();
+    backend.setResource(std::move(resource));
+
+    auto& dispatcher = const_cast<mln::vulkan::DispatchLoaderDynamic&>(backend.getDispatcher());
+    const auto saved = dispatcher;
+    AcquireProbe state;
+    state.begin = dispatcher.vkBeginCommandBuffer;
+    state.reset = dispatcher.vkResetFences;
+    state.submit = dispatcher.vkQueueSubmit;
+    probe = &state;
+    dispatcher.vkAcquireNextImageKHR = acquire;
+    dispatcher.vkBeginCommandBuffer = begin;
+    dispatcher.vkResetFences = reset;
+    dispatcher.vkQueueSubmit = submit;
+    struct Restore {
+        mln::vulkan::DispatchLoaderDynamic& dispatcher;
+        mln::vulkan::DispatchLoaderDynamic saved;
+        ~Restore() {
+            dispatcher = saved;
+            probe = nullptr;
+        }
+    } restore{dispatcher, saved};
+
+    for (const auto result : {VK_TIMEOUT, VK_NOT_READY, VK_TIMEOUT}) {
+        state.result = result;
+        EXPECT_THROW(context.beginFrame(), mln::vulkan::SurfaceNotReady);
+        EXPECT_EQ(state.timeout, 16'000'000u);
+        EXPECT_EQ(state.recordings, 0u);
+        EXPECT_EQ(state.fenceResets, 0u);
+        EXPECT_EQ(state.submissions, 0u);
+        EXPECT_TRUE(context.waitFrame());
+    }
+    EXPECT_EQ(state.acquisitions, 3u);
+
+    state.result = VK_ERROR_SURFACE_LOST_KHR;
+    EXPECT_THROW(context.beginFrame(), vk::SurfaceLostKHRError);
+    EXPECT_EQ(state.recordings, 0u);
+
+    // Reuse the same context and fences for real GPU submissions after the stalls.
+    surface->makeHeadless();
+    for (unsigned frame = 0; frame < 3; ++frame) {
+        context.beginFrame();
+        context.submitFrame();
+        EXPECT_TRUE(context.waitFrame());
+    }
+    EXPECT_EQ(state.recordings, 3u);
+    EXPECT_EQ(state.fenceResets, 3u);
+    EXPECT_EQ(state.submissions, 3u);
+}
+
+} // namespace
+#endif
