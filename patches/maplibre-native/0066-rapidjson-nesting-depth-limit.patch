--- a/vendor/rapidjson/include/rapidjson/reader.h
+++ b/vendor/rapidjson/include/rapidjson/reader.h
@@ -140,6 +140,18 @@ RAPIDJSON_NAMESPACE_BEGIN
 #define RAPIDJSON_PARSE_DEFAULT_FLAGS kParseNoFlags
 #endif
 
+/*! \def RAPIDJSON_PARSE_MAX_DEPTH
+    \ingroup RAPIDJSON_CONFIG
+    \brief User-defined limit on how deeply arrays and objects nest.
+
+    The recursive parser uses stack at each level, so a deeper document fails
+    with \c kParseErrorDepth rather than overflowing the stack. The iterative
+    parser does not recurse and ignores the limit.
+*/
+#ifndef RAPIDJSON_PARSE_MAX_DEPTH
+#define RAPIDJSON_PARSE_MAX_DEPTH 256
+#endif
+
 //! Combination of parseFlags
 /*! \see Reader::Parse, Document::Parse, Document::ParseInsitu, Document::ParseStream
  */
@@ -545,7 +557,7 @@ public:
         \param stackCapacity stack capacity in bytes for storing a single decoded string.  (Only use for non-destructive parsing)
     */
     GenericReader(StackAllocator* stackAllocator = 0, size_t stackCapacity = kDefaultStackCapacity) :
-        stack_(stackAllocator, stackCapacity), parseResult_(), state_(IterativeParsingStartState) {}
+        stack_(stackAllocator, stackCapacity), parseResult_(), state_(IterativeParsingStartState), depth_(0) {}
 
     //! Parse JSON text.
     /*! \tparam parseFlags Combination of \ref ParseFlag.
@@ -561,6 +573,7 @@ public:
             return IterativeParse<parseFlags>(is, handler);
 
         parseResult_.Clear();
+        depth_ = 0;
 
         ClearStackOnExit scope(*this);
 
@@ -1755,8 +1768,17 @@ private:
             case 't': ParseTrue  <parseFlags>(is, handler); break;
             case 'f': ParseFalse <parseFlags>(is, handler); break;
             case '"': ParseString<parseFlags>(is, handler); break;
-            case '{': ParseObject<parseFlags>(is, handler); break;
-            case '[': ParseArray <parseFlags>(is, handler); break;
+            case '{':
+            case '[':
+                if (RAPIDJSON_UNLIKELY(depth_ >= RAPIDJSON_PARSE_MAX_DEPTH))
+                    RAPIDJSON_PARSE_ERROR(kParseErrorDepth, is.Tell());
+                ++depth_;
+                if (is.Peek() == '{')
+                    ParseObject<parseFlags>(is, handler);
+                else
+                    ParseArray<parseFlags>(is, handler);
+                --depth_;
+                break;
             default :
                       ParseNumber<parseFlags>(is, handler);
                       break;
@@ -2227,6 +2249,7 @@ private:
     internal::Stack<StackAllocator> stack_;  //!< A stack for storing decoded string temporarily during non-destructive parsing.
     ParseResult parseResult_;
     IterativeParsingState state_;
+    unsigned depth_; //!< How many arrays and objects the recursive parser is inside.
 }; // class GenericReader
 
