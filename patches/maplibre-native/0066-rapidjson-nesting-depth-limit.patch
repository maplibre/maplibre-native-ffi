 }
+
+TEST(StyleParser, NestingDepthLimit) {
+    const auto parse = [](std::size_t depth) {
+        style::Parser parser;
+        return util::toString(parser.parse(std::string(depth, '[') + std::string(depth, ']')));
+    };
+
+    EXPECT_EQ(parse(256), "style must be an object");
+    EXPECT_EQ(parse(257), "Arrays and objects nest too deeply. at offset 256");
+    // Deep enough to overflow the stack if the parser recursed through it all.
+    EXPECT_EQ(parse(1000000), "Arrays and objects nest too deeply. at offset 256");
+}
