+TEST(Source, GeoJSONSourceKeepsTheStyleAttribution) {
+    SourceTest test;
+
+    style::conversion::Error error;
+    auto converted = style::conversion::convertJSON<std::unique_ptr<Source>>(
+        R"({"type": "geojson", "attribution": "Fixture data", "data": {"type": "FeatureCollection", "features": []}})",
+        error,
+        "source");
+    ASSERT_TRUE(converted) << error.message;
+    auto& source = static_cast<GeoJSONSource&>(**converted);
+    EXPECT_EQ("Fixture data", source.getAttribution());
+
+    source.setObserver(&test.styleObserver);
+    source.setGeoJSON(mapbox::geojson::parse(R"({"type": "Point", "coordinates": [1.1, 1.1]})"));
+    EXPECT_EQ("Fixture data", source.getAttribution());
+
+    test.fileSource->sourceResponse = [&](const Resource&) {
+        Response response;
+        response.data = std::make_unique<std::string>(R"({"type": "Point", "coordinates": [2.2, 2.2]})");
+        return response;
+    };
+    test.styleObserver.sourceLoaded = [&](Source& loaded) {
+        EXPECT_EQ("Fixture data", loaded.getAttribution());
+        test.end();
+    };
+    source.setURL("url");
+    source.loadDescription(*test.fileSource);
+    test.run();
+}
