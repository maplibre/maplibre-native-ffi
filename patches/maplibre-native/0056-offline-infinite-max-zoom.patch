+TEST(OfflineDownload, GetStatusInfiniteMaxZoom) {
+    OfflineTest test;
+    auto region = test.createRegion();
+    ASSERT_TRUE(region);
+    OfflineDownload download(region->getID(),
+                             OfflineTilePyramidRegionDefinition("http://127.0.0.1:3000/style.json",
