diff --git a/platform/darwin/core/utf8.hpp b/platform/darwin/core/utf8.hpp
new file mode 100644
--- /dev/null
+++ b/platform/darwin/core/utf8.hpp
@@ -0,0 +1,18 @@
+#pragma once
+
+#import <Foundation/Foundation.h>
+
+#include <stdexcept>
+#include <string>
+
+namespace mln::platform::detail {
+
+inline NSString* stringFromUTF8(const std::string& value) {
+    NSString* result = [[NSString alloc] initWithBytes:value.data() length:value.size() encoding:NSUTF8StringEncoding];
+    if (!result) {
+        throw std::invalid_argument("Invalid UTF-8 in locale expression");
+    }
+    return result;
+}
+
+} // namespace mln::platform::detail
