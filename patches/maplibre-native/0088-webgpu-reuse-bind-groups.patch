+
+    // A bind group and what it was built from. A draw reuses it while its
+    // layout and entries stay the same. The record holds a reference on each
+    // entry's buffer, sampler, and view, so a handle it compares can't be freed
+    // and reused for another object.
     struct BindGroupRecord {
         uint32_t slot = 0;
         uint32_t group = 0;
+        WGPUBindGroupLayout layout = nullptr;
         WGPUBindGroup handle = nullptr;
+        std::vector<WGPUBindGroupEntry> entries;
+
+        BindGroupRecord() = default;
+        BindGroupRecord(const BindGroupRecord&) = delete;
+        BindGroupRecord& operator=(const BindGroupRecord&) = delete;
+        BindGroupRecord(BindGroupRecord&& other) noexcept { *this = std::move(other); }
+        BindGroupRecord& operator=(BindGroupRecord&& other) noexcept {
+            if (this != &other) {
+                reset();
+                slot = other.slot;
+                group = other.group;
+                layout = other.layout;
+                handle = other.handle;
+                entries = std::move(other.entries);
+                other.handle = nullptr;
+                other.entries.clear();
+            }
+            return *this;
+        }
+        ~BindGroupRecord() { reset(); }
+
+        bool matches(WGPUBindGroupLayout layout_, const std::vector<WGPUBindGroupEntry>& entries_) const {
+            if (!handle || layout != layout_ || entries.size() != entries_.size()) {
+                return false;
+            }
+            for (std::size_t i = 0; i < entries.size(); ++i) {
+                const auto& a = entries[i];
+                const auto& b = entries_[i];
+                if (a.binding != b.binding || a.buffer != b.buffer || a.offset != b.offset || a.size != b.size ||
+                    a.sampler != b.sampler || a.textureView != b.textureView) {
+                    return false;
+                }
+            }
+            return true;
+        }
+
+        void assign(uint32_t slot_,
+                    uint32_t group_,
+                    WGPUBindGroupLayout layout_,
+                    WGPUBindGroup handle_,
+                    std::vector<WGPUBindGroupEntry> entries_) {
+            reset();
+            slot = slot_;
+            group = group_;
+            layout = layout_;
+            handle = handle_;
+            entries = std::move(entries_);
+            for (const auto& entry : entries) {
+                if (entry.buffer) wgpuBufferAddRef(entry.buffer);
+                if (entry.sampler) wgpuSamplerAddRef(entry.sampler);
+                if (entry.textureView) wgpuTextureViewAddRef(entry.textureView);
+            }
+        }
+
+        void reset() {
+            for (const auto& entry : entries) {
+                if (entry.buffer) wgpuBufferRelease(entry.buffer);
+                if (entry.sampler) wgpuSamplerRelease(entry.sampler);
+                if (entry.textureView) wgpuTextureViewRelease(entry.textureView);
+            }
+            entries.clear();
+            if (handle) {
+                wgpuBindGroupRelease(handle);
+                handle = nullptr;
+            }
+            layout = nullptr;
+        }
     };
     std::vector<BindGroupRecord> bindGroups;
 };
