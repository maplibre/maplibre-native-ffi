diff --git a/test/map/map.test.cpp b/test/map/map.test.cpp
index 7300093..b4fb26f 100644
--- a/test/map/map.test.cpp
+++ b/test/map/map.test.cpp
@@ -2889,3 +2889,62 @@ INSTANTIATE_TEST_SUITE_P(Rendering,
                          [](const testing::TestParamInfo<std::string>& paramInfo) {
                              return paramInfo.param == "color-relief" ? "colorRelief"s : paramInfo.param;
                          });
+
+// Symbols that overlap draw in the order of their position on the screen, so a
+// rotation sorts them again. Each drawable must draw with the new order: an
+// OpenGL drawable kept drawing with the index buffer it first uploaded, which
+// the sort had replaced.
+TEST(Map, OverlappingSymbolsSortAgainAfterRotation) {
+    MapTest<> test;
+
+    // Two squares a few pixels apart vertically, both covering the center.
+    test.map.getStyle().loadJSON(R"STYLE({
+      "version": 8,
+      "sources": {
+        "points": {
+          "type": "geojson",
+          "data": {
+            "type": "FeatureCollection",
+            "features": [
+              { "type": "Feature", "properties": { "icon": "red" },
+                "geometry": { "type": "Point", "coordinates": [0, 3] } },
+              { "type": "Feature", "properties": { "icon": "blue" },
+                "geometry": { "type": "Point", "coordinates": [0, -3] } }
+            ]
+          }
+        }
+      },
+      "layers": [{
+        "id": "symbols",
+        "type": "symbol",
+        "source": "points",
+        "layout": {
+          "icon-image": ["get", "icon"],
+          "icon-allow-overlap": true,
+          "symbol-z-order": "viewport-y"
+        }
+      }]
+    })STYLE");
+    const auto addSquare = [&](const std::string& id, std::array<uint8_t, 4> rgba) {
+        PremultipliedImage image({32, 32});
+        for (std::size_t i = 0; i < image.bytes(); i += 4) {
+            std::copy(rgba.begin(), rgba.end(), image.data.get() + i);
+        }
+        test.map.getStyle().addImage(std::make_unique<style::Image>(id, std::move(image), 1.0f));
+    };
+    addSquare("red", {255, 0, 0, 255});
+    addSquare("blue", {0, 0, 255, 255});
+    test.map.jumpTo(CameraOptions().withCenter(LatLng{0, 0}).withZoom(0).withBearing(0));
+
+    const auto centerPixel = [&]() {
+        const auto image = test.frontend.render(test.map).image;
+        const auto* pixel = image.data.get() + (image.size.height / 2 * image.size.width + image.size.width / 2) * 4;
+        return std::array<uint8_t, 4>{pixel[0], pixel[1], pixel[2], pixel[3]};
+    };
+
+    // The square lower on the screen draws on top.
+    EXPECT_EQ((std::array<uint8_t, 4>{0, 0, 255, 255}), centerPixel());
+
+    test.map.jumpTo(CameraOptions().withBearing(180));
+    EXPECT_EQ((std::array<uint8_t, 4>{255, 0, 0, 255}), centerPixel());
+}
