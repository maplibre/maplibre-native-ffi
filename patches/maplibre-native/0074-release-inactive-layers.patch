     // This layer is either being freshly included in the renderable set or excluded
     activateLayerGroup(layerGroup, willRender, changes);
+
+    if (!willRender) {
+        // Neither prepare() nor update() runs while the layer isn't renderable, so drop the tiles and
+        // drawables it holds, which keep the tiles' render data alive. The next prepare() and update()
+        // rebuild them from the source's current tiles.
+        removeAllDrawables();
+        renderTiles.reset();
+        renderTilesOwner = makeMutable<std::vector<RenderTile>>();
+        renderTileIDs.clear();
+        placementData.clear();
+    }
 }
 
