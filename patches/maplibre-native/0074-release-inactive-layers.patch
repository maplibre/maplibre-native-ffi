+struct InactiveLayerCase {
+    std::string name;
+    std::string source;
+    // A layer object without "id", "source", "minzoom", or "maxzoom".
+    std::string layer;
+    // A layer that renders nothing, without "id", "source", "minzoom", or "maxzoom".
+    std::string keeper;
+};
