+
+// At zoom 16.1 to 16.45, a 256 pixel viewport shows one raster tile at the small center, and four at the large one.
+const CanonicalTileID smallTileID{15, 16484, 16283};
+const LatLng smallCenter = LatLngBounds(smallTileID).center();
+const LatLng largeCenter{0, 0};
+
+std::string inactiveLayerFeatures() {
+    std::string json = R"({"type":"FeatureCollection","features":[)";
+    const auto feature = [&](const std::string& geometry) {
+        json += R"({"type":"Feature","properties":{},"geometry":)" + geometry + "},";
+    };
+    const auto point = [](const LatLng& center, double dx, double dy) {
+        return "[" + std::to_string(center.longitude() + dx) + "," + std::to_string(center.latitude() + dy) + "]";
+    };
+
+    const auto& small = smallCenter;
+    feature(R"({"type":"Polygon","coordinates":[[)" + point(small, 0, 0) + "," + point(small, 0.001, 0) + "," +
+            point(small, 0, 0.001) + "," + point(small, 0, 0) + "]]}");
+    feature(R"({"type":"LineString","coordinates":[)" + point(small, 0, 0) + "," + point(small, 0.001, 0.001) + "]}");
+    feature(R"({"type":"Point","coordinates":)" + point(small, 0, 0) + "}");
+
+    const auto& large = largeCenter;
+    std::string ring;
+    for (int i = 0; i <= 256; ++i) {
+        const double angle = 2 * M_PI * (i % 256) / 256;
+        ring += (i ? "," : "") + point(large, 0.002 * std::cos(angle), 0.002 * std::sin(angle));
+    }
+    feature(R"({"type":"Polygon","coordinates":[[)" + ring + "]]}");
+    for (int row = 0; row < 32; ++row) {
+        std::string line;
+        for (int column = 0; column < 32; ++column) {
+            const auto coordinates = point(large, -0.002 + column * 0.000125, -0.002 + row * 0.000125);
+            line += (column ? "," : "") + coordinates;
+            feature(R"({"type":"Point","coordinates":)" + coordinates + "}");
+        }
+        feature(R"({"type":"LineString","coordinates":[)" + line + "]}");
+    }
+    json.back() = ']';
+    return json + "}";
+}
+
+class InactiveLayerTest : public testing::TestWithParam<InactiveLayerCase> {};
+
+} // namespace
+
+// A layer outside its zoom range, and a source whose layers all are, release the tiles they last rendered.
+TEST_P(InactiveLayerTest, ReleasesTilesOutsideZoomRange) {
+    const auto& param = GetParam();
+    MapTest<> test;
+    test.map.setPrefetchZoomDelta(0);
+    test.frontend.getRenderer()->setTileCacheEnabled(false);
+    test.fileSource->glyphsResponse = [](const Resource&) {
+        Response response;
+        response.data = std::make_shared<std::string>(util::read_file("test/fixtures/resources/glyphs.pbf"));
+        return response;
+    };
+    const auto smallTile = std::make_shared<std::string>(encodePNG(PremultipliedImage({4, 4})));
+    const auto largeTile = std::make_shared<std::string>(util::read_file("test/fixtures/resources/raster.tile"));
+    test.fileSource->tileResponse = [&](const Resource& resource) {
+        const CanonicalTileID id(resource.tileData->z, resource.tileData->x, resource.tileData->y);
+        Response response;
+        if (id == smallTileID) {
+            response.data = smallTile;
+        } else if (id.z == 15 && (id.x == 16383 || id.x == 16384) && (id.y == 16383 || id.y == 16384)) {
+            response.data = largeTile;
+        } else {
+            response.noContent = true;
+        }
+        return response;
+    };
+
+    const auto source = param.source == "geojson"
+                            ? R"({"type":"geojson","data":)" + inactiveLayerFeatures() + "}"
+                            : R"({"type":")" + param.source + R"(","tiles":["https://example.com/{z}/{x}/{y}.png"]})";
+    const auto layer = [](const std::string& id, const std::string& zoom, const std::string& json) {
+        return R"({"id":")" + id + R"(","source":"data",)" + zoom + "," + json.substr(1);
+    };
+    test.map.getStyle().loadJSON(R"({"version":8,"glyphs":"https://example.com/{fontstack}/{range}.pbf",)"
+                                 R"("sources":{"data":)" +
+                                 source + R"(},"layers":[)" + layer("layer", R"("minzoom":16.4)", param.layer) +
+                                 "," + layer("keeper", R"("minzoom":16.2,"maxzoom":16.35)", param.keeper) + "]}");
+
+    const auto render = [&](const LatLng& center, double zoom) {
+        test.map.jumpTo(CameraOptions().withCenter(center).withZoom(zoom));
+        auto result = test.frontend.render(test.map);
+        // A dropped tile is destroyed on the thread pool, which leaves its render data to the render thread's next
+        // frame. Release it now.
+        auto threadPool = test.frontend.getThreadPool();
+        threadPool.waitForEmpty();
+        gfx::BackendScope scope{*test.frontend.getBackend()};
+        threadPool.runRenderJobs();
+        result.stats = test.frontend.getBackend()->getContext().renderingStats();
+        return result;
+    };
+    const auto leaveZoomRange = [&](const LatLng& center) {
+        // The layer leaves its zoom range while the keeper still renders the source.
+        render(center, 16.3);
+        // The keeper leaves its zoom range too, so the source stops rendering.
+        return render(center, 16.1).stats;
+    };
+    const auto expectSameResources = [](const gfx::RenderingStats& expected, const gfx::RenderingStats& actual) {
+        EXPECT_EQ(expected.numVertexBuffers, actual.numVertexBuffers);
+        EXPECT_EQ(expected.memVertexBuffers, actual.memVertexBuffers);
+        EXPECT_EQ(expected.numIndexBuffers, actual.numIndexBuffers);
+        EXPECT_EQ(expected.memIndexBuffers, actual.memIndexBuffers);
+        EXPECT_EQ(expected.numActiveTextures, actual.numActiveTextures);
+    };
+
+    // Render the layer once with little data, so it creates whatever it keeps between frames.
+    ASSERT_GT(render(smallCenter, 16.45).stats.numDrawCalls, 0);
+    const auto released = leaveZoomRange(smallCenter);
+
+    const auto rendered = render(largeCenter, 16.45);
+    const auto& image = rendered.image;
+    ASSERT_TRUE(std::any_of(image.data.get(), image.data.get() + image.bytes(), [](uint8_t v) { return v != 0; }));
+    {
+        SCOPED_TRACE("released");
+        expectSameResources(released, leaveZoomRange(largeCenter));
+    }
+
+    const auto renderedAgain = render(largeCenter, 16.45);
+    SCOPED_TRACE("rendered again");
+    expectSameResources(rendered.stats, renderedAgain.stats);
+    ASSERT_EQ(image.bytes(), renderedAgain.image.bytes());
+    EXPECT_TRUE(std::equal(image.data.get(), image.data.get() + image.bytes(), renderedAgain.image.data.get()));
+}
