Caches whether each OpenGL framebuffer has a stencil buffer
(https://github.com/maplibre/maplibre-native-ffi/issues/1688).
PaintParameters::updateStencilBufferAvailability() runs at least once a frame,
and again for each render target, and each call queried GL_STENCIL_BITS. In
WebGL that query is a synchronous round trip to the GPU process, and it took
about a third of a browser page's render time. A framebuffer's stencil bits
don't change while its attachments stay, so gl::Context now keeps the answer
for each framebuffer name it has bound. It forgets a name when it deletes that
framebuffer, since GL may reuse the name. A dirty or implicit binding still
queries, because the bound framebuffer is unknown. setDirtyState() keeps the
answers: a shared context calls it every frame, and the host can't reuse the
name of a framebuffer this context still owns. The default framebuffer keeps
its answer when the context moves to another surface, since EGL and WGL require
each surface a context draws to to match the context's config, stencil size
included.

diff --git a/src/mln/gl/context.cpp b/src/mln/gl/context.cpp
index f30d62c..57b0ddf 100644
--- a/src/mln/gl/context.cpp
+++ b/src/mln/gl/context.cpp
@@ -26,8 +26,10 @@
 #include <mln/renderer/render_target.hpp>
 #include <mln/shaders/gl/shader_program_gl.hpp>
 
+#include <algorithm>
 #include <cstring>
 #include <iterator>
+#include <limits>
 
 namespace mln {
 namespace gl {
@@ -719,10 +721,26 @@ void Context::setStencilMode(const gfx::StencilMode& stencil) {
     }
 }
 
-bool Context::hasStencilBuffer() const {
-    GLint bits = 0;
-    MBGL_CHECK_ERROR(glGetIntegerv(GL_STENCIL_BITS, &bits));
-    return bits > 0;
+bool Context::hasStencilBuffer() {
+    const auto query = [] {
+        GLint bits = 0;
+        MBGL_CHECK_ERROR(glGetIntegerv(GL_STENCIL_BITS, &bits));
+        return bits > 0;
+    };
+    // A dirty binding, or RendererBackend's implicit one, means the bound
+    // framebuffer is unknown.
+    const auto framebuffer = bindFramebuffer.getCurrentValue();
+    if (bindFramebuffer.isDirty() || framebuffer == std::numeric_limits<FramebufferID>::max()) {
+        return query();
+    }
+    const auto cached = std::ranges::find_if(stencilBufferCache,
+                                             [framebuffer](const auto& entry) { return entry.first == framebuffer; });
+    if (cached != stencilBufferCache.end()) {
+        return cached->second;
+    }
+    const auto hasStencil = query();
+    stencilBufferCache.emplace_back(framebuffer, hasStencil);
+    return hasStencil;
 }
 
 void Context::setColorMode(const gfx::ColorMode& color) {
@@ -857,6 +875,8 @@ void Context::performCleanup() {
             if (bindFramebuffer == id) {
                 bindFramebuffer.setDirty();
             }
+            // GL may reuse the name for a framebuffer with other attachments.
+            std::erase_if(stencilBufferCache, [id](const auto& entry) { return entry.first == id; });
         }
         MBGL_CHECK_ERROR(glDeleteFramebuffers(int(abandonedFramebuffers.size()), abandonedFramebuffers.data()));
         stats.numFrameBuffers -= int(abandonedFramebuffers.size());
