@@ -185,4 +185,24 @@ TEST(GLContext, UniformBufferCloneCopiesLargeBuffer) {
     MBGL_CHECK_ERROR(glBindBuffer(GL_COPY_READ_BUFFER, 0));
 }
 
+TEST(GLContext, StencilBufferFollowsReusedFramebufferName) {
+    gl::HeadlessBackend backend{{32, 32}};
+    gfx::BackendScope scope{backend};
+
+    gl::Context context{backend};
+    const Size size{32, 32};
+    auto color = context.createRenderbuffer<gfx::RenderbufferPixelType::RGBA>(size);
+
+    {
+        auto depthStencil = context.createRenderbuffer<gfx::RenderbufferPixelType::DepthStencil>(size);
+        auto framebuffer = context.createFramebuffer(color, depthStencil);
+        EXPECT_TRUE(context.hasStencilBuffer());
+    }
+    // Deletes the framebuffer, so GL may give its name to the next one.
+    context.performCleanup();
+
+    auto framebuffer = context.createFramebuffer(color);
+    EXPECT_FALSE(context.hasStencilBuffer());
+}
