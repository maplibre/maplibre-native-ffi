Names the path in the error when a local file request finds no file, or finds a
directory. The NotFound error had no message, so loading
file:///nonexistent/style.json failed with "loading style failed: " and nothing
after the colon. file://, asset://, and Android's local file sources all read
through requestLocalFile.
(https://github.com/maplibre/maplibre-native-ffi/issues/1708)
Upstream: not proposed

diff --git a/platform/default/src/mln/storage/local_file_request.cpp b/platform/default/src/mln/storage/local_file_request.cpp
index 8df2d09..29dbc46 100644
--- a/platform/default/src/mln/storage/local_file_request.cpp
+++ b/platform/default/src/mln/storage/local_file_request.cpp
@@ -23,8 +23,12 @@ void requestLocalFile(const std::string& path,
     const bool notFound = status.type() == std::filesystem::file_type::not_found;
     const bool isDirectory = std::filesystem::is_directory(status);
 
-    if (notFound || isDirectory) {
-        response.error = std::make_unique<Response::Error>(Response::Error::Reason::NotFound);
+    if (notFound) {
+        response.error = std::make_unique<Response::Error>(Response::Error::Reason::NotFound,
+                                                           std::string("Cannot find file ") + path);
+    } else if (isDirectory) {
+        response.error = std::make_unique<Response::Error>(Response::Error::Reason::NotFound,
+                                                           std::string("Cannot read directory ") + path);
     } else {
         auto data = util::readFile(path, dataRange);
         if (!data) {
