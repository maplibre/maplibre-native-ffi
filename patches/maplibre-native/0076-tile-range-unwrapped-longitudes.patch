+TEST(LatLngBounds, ContainsTileIDsOfHugeBounds) {
+    // Both edges are finite, but the width is not.
+    const auto bounds = LatLngBounds::hull({10, -1e308}, {20, 1e308});
+    for (uint32_t x = 0; x < 4; x++) {
+        EXPECT_TRUE(bounds.contains(CanonicalTileID(2, x, 1))) << x;
+    }
+}
