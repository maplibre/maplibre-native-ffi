--- a/test/util/tile_range.test.cpp
+++ b/test/util/tile_range.test.cpp
@@ -4,6 +4,8 @@
 
 #include <gtest/gtest.h>
 
+#include <cmath>
+
 using namespace mln;
 
 TEST(TileRange, ContainsWorld) {
@@ -65,3 +67,60 @@ TEST(TileRange, ContainsBoundsCrossingAntimeridian) {
         EXPECT_TRUE(range.contains(CanonicalTileID(6, 63, 28)));
     }
 }
+
+TEST(TileRange, ContainsUnwrappedWorld) {
+    // The whole world, measured from the prime meridian.
+    auto range = util::TileRange::fromLatLngBounds(LatLngBounds::hull({-90, 0}, {90, 360}), 2);
+    for (uint32_t x = 0; x < 4; x++) {
+        EXPECT_TRUE(range.contains(CanonicalTileID(2, x, 1))) << x;
+    }
+}
+
+TEST(TileRange, ContainsBoundsWiderThanTheWorld) {
+    auto range = util::TileRange::fromLatLngBounds(LatLngBounds::hull({10, 10}, {20, 375}), 2);
+    for (uint32_t x = 0; x < 4; x++) {
+        EXPECT_TRUE(range.contains(CanonicalTileID(2, x, 1))) << x;
+    }
+}
+
+TEST(TileRange, ContainsBoundsReachingEveryColumn) {
+    // Less than a world wide, but it starts in column 2 and ends in column 2
+    // one world east, so it touches every column.
+    auto range = util::TileRange::fromLatLngBounds(LatLngBounds::hull({10, 10}, {20, 365}), 2);
+    for (uint32_t x = 0; x < 4; x++) {
+        EXPECT_TRUE(range.contains(CanonicalTileID(2, x, 1))) << x;
+    }
+}
+
+TEST(TileRange, ContainsBoundsOneWorldWest) {
+    // The same column as {{10, 0}, {20, 10}}.
+    auto range = util::TileRange::fromLatLngBounds(LatLngBounds::hull({10, -360}, {20, -350}), 2);
+    EXPECT_TRUE(range.contains(CanonicalTileID(2, 2, 1)));
+    EXPECT_FALSE(range.contains(CanonicalTileID(2, 1, 1)));
+    EXPECT_FALSE(range.contains(CanonicalTileID(2, 3, 1)));
+    EXPECT_FALSE(range.contains(CanonicalTileID(2, 0, 1)));
+}
+
+TEST(TileRange, ContainsBoundsWhoseWidthOverflows) {
+    // Both edges are finite, but the width is not.
+    auto range = util::TileRange::fromLatLngBounds(LatLngBounds::hull({10, -1e308}, {20, 1e308}), 2);
+    for (uint32_t x = 0; x < 4; x++) {
+        EXPECT_TRUE(range.contains(CanonicalTileID(2, x, 1))) << x;
+    }
+}
+
+TEST(TileRange, ContainsHugeLongitude) {
+    // A whole number of worlds east of the prime meridian, so column 4 of 8.
+    // 180 more degrees round away at this magnitude.
+    const double longitude = 360.0 * std::pow(2.0, 52);
+    auto range = util::TileRange::fromLatLngBounds(LatLngBounds::hull({10, longitude}, {20, longitude}), 3);
+    EXPECT_TRUE(range.contains(CanonicalTileID(3, 4, 3)));
+    EXPECT_FALSE(range.contains(CanonicalTileID(3, 5, 3)));
+}
+
+TEST(TileRange, InvertedBoundsStayInTheWorld) {
+    // Empty bounds are inverted: their east edge is west of their west edge.
+    auto range = util::TileRange::fromLatLngBounds(LatLngBounds::empty(), 2);
+    EXPECT_LT(range.range.max.x, 4u);
+    EXPECT_FALSE(range.contains(CanonicalTileID(2, 0, 1)));
+}
