+TEST(Expression, ParsingLimitsNestingDepth) {
+    const auto nest = [](std::size_t depth, const std::string& open, const std::string& inner, const std::string& close) {
+        std::string json;
+        for (std::size_t i = 0; i < depth; ++i) json += open;
+        json += inner;
+        for (std::size_t i = 0; i < depth; ++i) json += close;
+        return json;
+    };
+    const auto errors = [](const std::string& json) {
+        JSDocument document;
+        document.Parse<0>(json);
+        const JSValue* expression = &document;
+        expression::ParsingContext ctx;
+        return ctx.parseExpression(conversion::Convertible(expression)) ? std::string() : ctx.getCombinedErrors();
+    };
+    const std::string tooDeep = "Expression nests more than 64 levels deep.";
+
+    EXPECT_EQ(errors(nest(64, R"(["+", )", "1", ", 1]")), "");
+    EXPECT_NE(errors(nest(65, R"(["+", )", "1", ", 1]")).find(tooDeep), std::string::npos);
+
+    // The arrays of a literal value count toward the depth of the expression that holds it.
+    EXPECT_EQ(errors(R"(["literal", )" + nest(63, "[", "", "]") + "]"), "");
+    EXPECT_NE(errors(R"(["literal", )" + nest(64, "[", "", "]") + "]").find(tooDeep), std::string::npos);
+}
