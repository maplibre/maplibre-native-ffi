+TEST(Filter, LegacyFilterLimitsNestingDepth) {
+    const auto nest = [](std::size_t depth, const std::string& op) {
+        std::string json;
+        for (std::size_t i = 1; i < depth; ++i) json += R"([")" + op + R"(", )";
+        json += R"(["==", "a", 1])";
+        json += std::string(depth - 1, ']');
+        return json;
+    };
+
+    // "all" can be an expression or a legacy filter, and "none" is only a legacy filter.
+    for (const std::string op : {"all", "none"}) {
+        conversion::Error error;
+        EXPECT_TRUE(conversion::convertJSON<Filter>(nest(64, op), error)) << op;
+        EXPECT_FALSE(conversion::convertJSON<Filter>(nest(65, op), error)) << op;
+        EXPECT_NE(error.message.find("more than 64 levels deep"), std::string::npos) << op;
+    }
