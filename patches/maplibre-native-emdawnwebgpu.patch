+        renderQueues[tag].push(std::move(fn));
+    }
+
+    void runRenderJobs(const util::SimpleIdentity tag, bool closeQueue = false) override {
+        drainAll(queues, false);
+        drain(renderQueues, tag, closeQueue);
+    }
+
+    void waitForEmpty(const util::SimpleIdentity tag = util::SimpleIdentity::Empty) override {
+        if (tag.isEmpty()) {
+            drainAll(queues, true);
+            return;
+        }
+        drain(queues, tag, true);
+    }
+
+private:
+    using TaskQueue = std::queue<std::function<void()>>;
+    using QueueMap = mbgl::unordered_map<util::SimpleIdentity, TaskQueue>;
+
+    void drainAll(QueueMap& targetQueues, bool closeQueue) {
+        while (true) {
+            auto task = popNext(targetQueues, closeQueue);
+            if (!task) {
+                return;
+            }
+            task();
+        }
+    }
+
+    void drain(QueueMap& targetQueues, const util::SimpleIdentity tag, bool closeQueue) {
+        while (true) {
+            auto task = popTagged(targetQueues, tag, closeQueue);
+            if (!task) {
+                return;
+            }
+            task();
+        }
+    }
+
+    std::function<void()> popNext(QueueMap& targetQueues, bool closeQueue) {
+        std::scoped_lock lock(mtx);
+        for (auto it = targetQueues.begin(); it != targetQueues.end(); ++it) {
+            if (it->second.empty()) {
+                continue;
+            }
+
+            auto task = std::move(it->second.front());
+            it->second.pop();
