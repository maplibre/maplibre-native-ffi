+        if (it->second.empty()) {
+            if (closeQueue) {
+                targetQueues.erase(it);
+            }
+            return {};
+        }
+
+        auto task = std::move(it->second.front());
+        it->second.pop();
+        if (closeQueue && it->second.empty()) {
+            targetQueues.erase(it);
+        }
+        return task;
+    }
