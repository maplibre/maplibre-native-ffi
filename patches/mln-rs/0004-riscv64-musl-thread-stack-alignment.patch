 pub const STACK_SIZE: usize = 2 * 1024 * 1024;
 
 /// A builder for a thread named `name` with a [`STACK_SIZE`] stack.
-pub fn builder(name: impl Into<String>) -> std::thread::Builder {
-    std::thread::Builder::new().name(name.into()).stack_size(STACK_SIZE)
+pub fn builder(name: impl Into<String>) -> Builder {
+    Builder(std::thread::Builder::new().name(name.into()).stack_size(STACK_SIZE))
+}
+
+/// Starts a thread that mln-rs owns. Its body runs on a stack aligned as the
+/// platform's C ABI requires, so the host callbacks it calls do too.
+#[derive(Debug)]
+pub struct Builder(std::thread::Builder);
+
+impl Builder {
+    /// Starts the thread, as [`std::thread::Builder::spawn`] does.
+    pub fn spawn<F, T>(self, f: F) -> io::Result<JoinHandle<T>>
+    where
+        F: FnOnce() -> T + Send + 'static,
+        T: Send + 'static,
+    {
+        self.0.spawn(move || with_aligned_stack(f))
+    }
+}
+
+#[cfg(not(all(target_arch = "riscv64", target_env = "musl")))]
+fn with_aligned_stack<T>(f: impl FnOnce() -> T) -> T {
+    f()
+}
+
+/// Runs `f` with the stack pointer aligned to 16 bytes, as the RISC-V psABI
+/// requires at every call.
+///
+/// musl's riscv64 `__clone` doesn't align the stack it's given, and
+/// `pthread_create` aligns the top of a new thread's stack to 8 bytes only,
+/// below the thread's TLS. A thread can start 8 bytes off, depending on the
+/// TLS size of the libraries loaded so far. Compiled code keeps the alignment
+/// it starts with, so the thread's calls into the host would be misaligned
+/// too, and a host that relies on the psABI, such as the JVM's upcall stubs,
+/// corrupts its frame.
+#[cfg(all(target_arch = "riscv64", target_env = "musl"))]
+#[allow(unsafe_code)]
+fn with_aligned_stack<F: FnOnce() -> T, T>(f: F) -> T {
+    use std::panic::{self, AssertUnwindSafe};
+
+    struct Call<F, T> {
+        f: Option<F>,
+        result: std::thread::Result<T>,
+    }
+
+    // A panic can't unwind through the assembly, so `run` catches it and the
+    // caller resumes it.
+    extern "C" fn run<F: FnOnce() -> T, T>(call: *mut Call<F, T>) {
+        // SAFETY: the exclusive borrow of `call` below, for this call only.
+        let call = unsafe { &mut *call };
+        if let Some(f) = call.f.take() {
+            call.result = panic::catch_unwind(AssertUnwindSafe(f));
+        }
+    }
+
+    let mut call = Call { f: Some(f), result: Err(Box::new("the aligned call didn't run")) };
+    let run: extern "C" fn(*mut Call<F, T>) = run::<F, T>;
+    // SAFETY: s2 is callee-saved, so it holds the stack pointer across the
+    // call to `run`, which follows the C ABI. Aligning moves the stack
+    // pointer down by at most 8 bytes, into free stack: RISC-V has no red
+    // zone.
+    unsafe {
+        core::arch::asm!(
+            "mv s2, sp",
+            "andi sp, sp, -16",
+            "jalr {run}",
+            "mv sp, s2",
+            run = in(reg) run,
+            in("a0") &raw mut call,
+            out("s2") _,
+            clobber_abi("C"),
+        );
+    }
+    match call.result {
+        Ok(value) => value,
+        Err(payload) => panic::resume_unwind(payload),
+    }
 }
 
