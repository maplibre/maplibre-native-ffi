+    /// Calls `with_aligned_stack` with the stack pointer 8 bytes off, as a
+    /// thread that musl's riscv64 `__clone` started can be.
+    #[cfg(all(target_arch = "riscv64", target_env = "musl"))]
+    #[test]
+    #[allow(unsafe_code)]
+    fn aligns_a_misaligned_stack() {
+        extern "C" fn misaligned(sp: *mut usize) {
+            let inner: usize;
+            // SAFETY: reads the stack pointer.
+            unsafe { core::arch::asm!("mv {}, sp", out(reg) inner) };
+            assert_ne!(inner % 16, 0);
+            let aligned = with_aligned_stack(|| {
+                let sp: usize;
+                // SAFETY: reads the stack pointer.
+                unsafe { core::arch::asm!("mv {}, sp", out(reg) sp) };
+                sp
+            });
+            // SAFETY: the caller's local.
+            unsafe { *sp = aligned };
+        }
+        let mut sp = 0usize;
+        let misaligned: extern "C" fn(*mut usize) = misaligned;
+        // SAFETY: s2 holds the stack pointer across the C call, which runs
+        // 8 bytes below it.
+        unsafe {
+            core::arch::asm!(
+                "mv s2, sp",
+                "addi sp, sp, -8",
+                "jalr {f}",
+                "mv sp, s2",
+                f = in(reg) misaligned,
+                in("a0") &raw mut sp,
+                out("s2") _,
+                clobber_abi("C"),
+            );
+        }
+        assert_eq!(sp % 16, 0);
+    }
 }
