     fn depth_stencil(&self) -> Option<(MTLTexturePtr, MTLTexturePtr)> {
         if let Some(depth) = self.textures.borrow().depth_textures.get(self.selected.get()) {
             return Some((depth.clone(), depth.clone()));
@@ -202,7 +202,7 @@ impl Resource {
