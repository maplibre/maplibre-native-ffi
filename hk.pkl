// hk orchestrates checks for pre-commit, `mise run check`, and `mise run fix`.
// Repository-wide tools are installed at the root. Language-specific steps
// enter their binding's mise context and install that toolchain on demand.

amends "package://github.com/jdx/hk/releases/download/v1.45.0/hk@1.45.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v1.45.0/hk@1.45.0#/Builtins.pkl"

local lintSteps = new Mapping<String, Step> {
  ["dprint"] = (Builtins.dprint) {
    // the default batch=false hits the cmd length limit on windows
    batch = true
  }
  ["actionlint"] {
    glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
    check = "actionlint {{files}}"
  }
  // Whole-repository check: every reference must agree with the pins catalog,
  // so it runs whenever any workflow or composite action changes.
  ["action-pins"] {
    glob = List(
      ".github/workflows/*.yml",
      ".github/workflows/*.yaml",
      ".github/actions/**/action.yml",
      ".github/actions/**/action.yaml",
    )
    check = "mise run ci:check-action-pins"
  }
  ["jvl"] {
    glob = List("**/*.json", "**/*.jsonc")
    check = "jvl check {{files}}"
  }
  // Mirrors Builtins.`vp-check` (available in hk 1.46+). dprint owns formatting.
  ["vp-check"] {
    glob = List(
      "**/*.js",
      "**/*.mjs",
      "**/*.cjs",
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.jsx",
      "**/*.tsx",
      "**/*.vue",
      "**/*.svelte",
      "**/*.astro",
    )
    exclude = List("third_party/**")
    check = "pnpm exec vp check --no-fmt {{files}}"
    fix = "pnpm exec vp check --no-fmt --fix {{files}}"
  }
  // The guides embed these snippets verbatim. Header changes are in the glob so
  // an API change that invalidates a documented snippet fails here first.
  ["docs-snippets"] {
    glob = List("docs/snippets/c/**/*.c", "include/**/*.h")
    check = "mise run //docs:check-snippets"
  }
  ["ruff"] {
    glob = List("**/*.py")
    exclude = List("third_party/**")
    check = "uv run --no-sync ruff check {{files}} && uv run --no-sync ruff format --check {{files}}"
    fix = "uv run --no-sync ruff check --fix {{files}} && uv run --no-sync ruff format {{files}}"
  }
  ["ty"] {
    glob = List("bindings/python/python/**/*.py", "docs/scripts/**/*.py")
    check = "uv run --no-sync ty check --error-on-warning --ignore invalid-argument-type --ignore not-iterable --ignore not-subscriptable {{files}}"
  }
  ["gofumpt"] {
    glob = List("bindings/go/**/*.go")
    check = "unformatted=\"$(mise run --quiet //bindings/go:_gofumpt-check {{files}})\"; test -z \"$unformatted\" || { echo \"$unformatted\" >&2; exit 1; }"
    fix = "mise run --quiet //bindings/go:_gofumpt-fix {{files}}"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps {
      ...lintSteps
    }
  }
  ["check"] {
    steps {
      ...lintSteps
    }
  }
  ["fix"] {
    fix = true
    steps {
      ...lintSteps
    }
  }
}
