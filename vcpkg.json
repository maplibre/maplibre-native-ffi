{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "maplibre-native-ffi",
  "version-string": "0.1.0",
  "builtin-baseline": "a4676fa5be1d5e94250745b4614d5d2a9034290b",
  "dependencies": [
    "zlib",
    {
      "name": "curl",
      "default-features": false,
      "features": ["mbedtls"],
      "platform": "linux | android"
    },
    {
      "name": "curl",
      "default-features": false,
      "features": ["ssl"],
      "platform": "windows"
    },
    {
      "name": "libjpeg-turbo",
      "features": ["jpeg8"],
      "platform": "linux | windows | android"
    },
    { "name": "libpng", "platform": "linux | windows | android" },
    { "name": "libuv", "platform": "linux | windows | android" },
    {
      "name": "libwebp",
      "default-features": false,
      "platform": "linux | windows | android"
    },
    { "name": "opengl-registry", "platform": "linux" }
  ]
}
