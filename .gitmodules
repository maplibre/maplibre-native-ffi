# Cargo and SwiftPM fetch a git dependency's submodules recursively, so a git
# dependency on this repository would pull these trees too. Both honour
# `update = none` and skip a submodule that sets it. tools/deps/sync-submodules
# passes --checkout to opt back in for the builds that need the source.
[submodule "third_party/mln-rs"]
	path = third_party/mln-rs
	url = https://github.com/louwers/mln-rs
	shallow = true
	ignore = dirty
	update = none
[submodule "third_party/Vulkan-Headers"]
	path = third_party/Vulkan-Headers
	url = https://github.com/KhronosGroup/Vulkan-Headers
	shallow = true
	update = none
