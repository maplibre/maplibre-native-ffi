<Project>
  <PropertyGroup>
    <MaplibreNativeCRuntimeDir Condition="'$(OS)' == 'Windows_NT'">$(MaplibreNativeCInstallDir)/bin</MaplibreNativeCRuntimeDir>
    <MaplibreNativeCRuntimeDir Condition="'$(OS)' != 'Windows_NT'">$(MaplibreNativeCInstallDir)/lib</MaplibreNativeCRuntimeDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Copies every shared library from the install beside the app, matching
         how NuGet runtime assets enter the native-library lookup. Not just the
         C API one: the OpenGL presets install ANGLE beside it. -->
    <Content Include="$(MaplibreNativeCRuntimeDir)/*.so;$(MaplibreNativeCRuntimeDir)/*.so.*;$(MaplibreNativeCRuntimeDir)/*.dylib;$(MaplibreNativeCRuntimeDir)/*.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
