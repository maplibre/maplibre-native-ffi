#!/usr/bin/env bash
#MISE description="Test the .NET binding against a native preset's install, with one of its render backends."
#MISE extends="ffi:test"
#MISE dir="../.."
#MISE shell="bash"
set -euo pipefail

source "$MISE_MONOREPO_ROOT/tools/env/test-backend.sh" "$usage_preset" "$usage_backend"
case "$usage_preset" in
  android-*)
    exec mise run //bindings/dotnet:_android "$usage_preset" "$MLN_FFI_TEST_BACKEND"
    ;;
  ios-* | tvos-*)
    exec "$MISE_MONOREPO_ROOT/scripts/test-dotnet-apple.sh" "$usage_preset" "$MLN_FFI_TEST_BACKEND"
    ;;
  macos-x64)
    if [[ $(uname -m) == arm64 ]]; then
      version=$(dotnet --version)
      sdk="$MISE_MONOREPO_ROOT/build/tools/dotnet/$version/x64"
      if [[ ! -x "$sdk/dotnet" ]]; then
        scratch=$(mktemp -d)
        trap 'rm -rf "$scratch"' EXIT
        curl --fail --location https://dot.net/v1/dotnet-install.sh -o "$scratch/install.sh"
        bash "$scratch/install.sh" --version "$version" --architecture x64 --install-dir "$sdk" --no-path
      fi
      export DOTNET_ROOT="$sdk"
      export PATH="$sdk:$PATH"
    fi
    ;;
esac
if [[ "$usage_preset" == linux-musl-* ]]; then
  exec python3 tools/release/dotnet_release.py smoke-musl "$usage_preset"
fi

MaplibreNativeCInstallDir="$MISE_MONOREPO_ROOT/build/$usage_preset/install" \
  dotnet test \
    --project bindings/dotnet/tests/Maplibre.NativeFfi.Tests/Maplibre.NativeFfi.Tests.csproj \
    -c Release \
    -p:Platform="Any CPU" \
    -p:BaseOutputPath="$MISE_MONOREPO_ROOT/build/dotnet/$usage_preset/"
