#!/usr/bin/env bash
#MISE description="Test the .NET binding against a native preset's install."
#MISE extends="ffi:preset"
#MISE dir="../.."
#MISE shell="bash"
set -euo pipefail

case "$usage_preset" in
  ios-* | tvos-*)
    echo "The .NET binding has no iOS or tvOS target." >&2
    exit 2
    ;;
esac
if [[ "$usage_preset" == linux-musl-* ]]; then
  exec python3 ci/dotnet_release.py smoke-musl "$usage_preset"
fi

# The same Release and Any CPU settings as the build task, for the same reasons.
MaplibreNativeCInstallDir="$MISE_MONOREPO_ROOT/build/$usage_preset/install" \
  dotnet test \
    --project bindings/dotnet/tests/Maplibre.NativeFfi.Tests/Maplibre.NativeFfi.Tests.csproj \
    -c Release \
    -p:Platform="Any CPU" \
    -p:BaseOutputPath="$MISE_MONOREPO_ROOT/build/dotnet/$usage_preset/"
