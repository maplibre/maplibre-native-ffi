<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference
      Include="Maplibre.NativeFfi"
      VersionOverride="$(MaplibreNativeFfiPackageVersion)"
    />
    <PackageReference
      Include="Maplibre.NativeFfi.Runtime.$(MaplibreNativeFfiRenderBackend)"
      VersionOverride="$(MaplibreNativeFfiPackageVersion)"
    />
  </ItemGroup>
</Project>
