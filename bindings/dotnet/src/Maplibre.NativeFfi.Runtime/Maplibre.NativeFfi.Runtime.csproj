<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      Maplibre.NativeFfi.Runtime carries every platform's native library, each
      with all of its render backends. MinGW builds serve the RIDs of the MSVC
      ones, so they pack as Maplibre.NativeFfi.Runtime.MinGW, with a
      RuntimePackageIdSuffix of .MinGW.
    -->
    <PackageId>Maplibre.NativeFfi.Runtime$(RuntimePackageIdSuffix)</PackageId>
    <Description>Native runtime assets for MapLibre Native .NET, with every render backend of each platform.</Description>
    <Description Condition="'$(RuntimePackageIdSuffix)' == '.MinGW'">MinGW-built native runtime assets for MapLibre Native .NET on Windows, with every render backend.</Description>
    <Authors>MapLibre</Authors>
    <PackageLicenseExpression>BSD-2-Clause</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/maplibre/maplibre-native-ffi</PackageProjectUrl>
    <RepositoryUrl>https://github.com/maplibre/maplibre-native-ffi</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>
  <ItemGroup>
    <None
      Include="$(SbomPath)"
      Pack="true"
      PackagePath="sbom/maplibre-native-ffi.cdx.json"
    />
    <ProjectReference Include="../Maplibre.NativeFfi/Maplibre.NativeFfi.csproj" />
    <None Include="_._" Pack="true" PackagePath="lib/$(TargetFramework)/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None
      Include="$(NativeAssetsDir)/**"
      Condition="'$(NativeAssetsDir)' != ''"
      Pack="true"
      PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)"
    />
    <None
      Include="$(AppleFrameworksDir)/**"
      Condition="'$(AppleFrameworksDir)' != ''"
      Pack="true"
      PackagePath="buildTransitive/native/%(RecursiveDir)%(Filename)%(Extension)"
    />
    <None
      Include="Maplibre.NativeFfi.Runtime.targets"
      Pack="true"
      PackagePath="buildTransitive/$(PackageId).targets"
    />
  </ItemGroup>
  <!--
    The native library must come from the same release as Maplibre.NativeFfi, so
    the runtime package requires that exact version, as [x.y.z], rather than the
    minimum that a project reference packs. Pack reads the version from this
    item, which _GetProjectReferenceVersions fills.
  -->
  <Target
    Name="PinManagedPackageVersion"
    AfterTargets="_GetProjectReferenceVersions"
  >
    <ItemGroup>
      <_ProjectReferencesWithVersions>
        <ProjectVersion>[%(ProjectVersion)]</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>
</Project>
