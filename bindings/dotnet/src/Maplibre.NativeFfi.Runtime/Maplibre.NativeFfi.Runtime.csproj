<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Maplibre.NativeFfi.Runtime.$(RenderBackend)</PackageId>
    <Description>$(RenderBackend) native runtime assets for MapLibre Native .NET.</Description>
    <Authors>MapLibre</Authors>
    <PackageLicenseExpression>BSD-2-Clause</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/maplibre/maplibre-native-ffi</PackageProjectUrl>
    <RepositoryUrl>https://github.com/maplibre/maplibre-native-ffi</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Maplibre.NativeFfi/Maplibre.NativeFfi.csproj" />
    <None Include="_._" Pack="true" PackagePath="lib/$(TargetFramework)/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None
      Include="$(NativeAssetsDir)/**"
      Pack="true"
      PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)"
    />
  </ItemGroup>
</Project>
