#!/usr/bin/env bash
#MISE description="Write the Swift package as a release does, with local native assets, then run a consumer against it. On macOS, the assets are the XCFramework, and the consumer also builds for iOS. On Linux, they are the native archives, whose artifact bundle the package takes, and the consumer checks that it linked every backend of the platform."
#MISE dir="../.."
#MISE shell="bash"
#USAGE arg "[assets]" default="build/packages/native/dist" help="Directory that holds MaplibreNativeC.xcframework.zip on macOS, or the native archives on Linux"
set -euo pipefail

scratch="$(mktemp -d)"
trap 'rm -rf "$scratch"' EXIT

assets="$usage_assets"
if [[ "$(uname -s)" == Linux ]]; then
  source "$MISE_MONOREPO_ROOT/tools/env/swift-libxml2-env.sh"
  # The package takes the bundle that a release would build from the same
  # archives.
  assets="$scratch/assets"
  mkdir -p "$assets"
  while IFS= read -r preset; do
    archive="$(find "$usage_assets" -type f -name "maplibre-native-c-${preset}.tar.gz" -print -quit)"
    if [[ -z "$archive" ]]; then
      echo "Missing native package for ${preset} under ${usage_assets}" >&2
      exit 1
    fi
    ln -s "$(realpath "$archive")" "$assets/"
  done < <(python3 -m tools.ci.plan --package-inputs swift-artifact-bundles)
  PYTHONPATH=tools/release python3 - "$assets" <<'PY'
import pathlib
import sys

from swift_artifact_bundle import write_bundles

assets = pathlib.Path(sys.argv[1])
write_bundles(assets, sorted(assets.glob("*.tar.gz")), "0.0.0")
PY
fi

# The package takes copies of the assets where a release's would take their
# URLs, so it builds as a consumer's dependency on the release would.
package="$scratch/maplibre-native-ffi-distribution"
python3 tools/release/distribution.py "$package" "$assets" --local

# Writes a consumer of the package.
consumer() {
  local directory="$scratch/consumer"
  mkdir -p "$directory"
  cp -R tests/release/swift-package/. "$directory/"
  cat >"$directory/Package.swift" <<EOF
// swift-tools-version: 6.2
import PackageDescription

let package = Package(
  name: "PackageConsumer",
  platforms: [.macOS("14.3"), .iOS("15.0")],
  dependencies: [.package(path: "$package")],
  targets: [
    .executableTarget(
      name: "PackageConsumer",
      dependencies: [
        .product(name: "MaplibreNativeFFI", package: "maplibre-native-ffi-distribution"),
        .product(name: "MaplibreNativeC", package: "maplibre-native-ffi-distribution"),
      ]
    ),
  ]
)
EOF
  echo "$directory"
}

directory="$(consumer)"
if [[ "$(uname -s)" == Linux ]]; then
  # The consumer prints the backend mask that the package linked: Vulkan (2) and
  # OpenGL (4).
  swift build --package-path "$directory" --scratch-path "$scratch/build/linux"
  backends="$("$(swift build --package-path "$directory" --scratch-path "$scratch/build/linux" --show-bin-path)/PackageConsumer")"
  if [[ "$backends" != 6 ]]; then
    echo "The package linked backends $backends, not 6" >&2
    exit 1
  fi
  echo "The package linked backends $backends"
  exit 0
fi

cd "$directory"
swift run --scratch-path "$scratch/build/macos" PackageConsumer
swift build \
  --product PackageConsumer \
  --scratch-path "$scratch/build/ios" \
  --sdk "$(xcrun --sdk iphoneos --show-sdk-path)" \
  --triple arm64-apple-ios15.0
