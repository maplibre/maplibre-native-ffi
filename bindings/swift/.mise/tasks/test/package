#!/usr/bin/env bash
#MISE description="Write the Swift package as a release does, with a local XCFramework, then run a macOS consumer and build it for iOS."
#MISE dir="../.."
#MISE shell="bash"
#USAGE arg "[assets]" default="build/packages/native/dist" help="Directory that holds MaplibreNativeC.xcframework.zip"
set -euo pipefail

scratch="$(mktemp -d)"
trap 'rm -rf "$scratch"' EXIT

# The package takes a copy of the XCFramework where a release's would take its
# URL, so it builds as a consumer's dependency on the release would.
package="$scratch/maplibre-native-ffi-distribution"
python3 tools/release/distribution.py "$package" "$usage_assets" --local

consumer="$scratch/consumer"
mkdir -p "$consumer"
cp -R tests/release/swift-package/. "$consumer/"
cat >"$consumer/Package.swift" <<EOF
// swift-tools-version: 6.0
import PackageDescription

let package = Package(
  name: "PackageConsumer",
  platforms: [.macOS("14.3"), .iOS("15.0")],
  dependencies: [.package(path: "$package")],
  targets: [
    .executableTarget(
      name: "PackageConsumer",
      dependencies: [
        .product(name: "MaplibreNativeFFI", package: "maplibre-native-ffi-distribution"),
        .product(name: "MaplibreNativeC", package: "maplibre-native-ffi-distribution"),
      ]
    ),
  ]
)
EOF

cd "$consumer"
swift run --scratch-path "$scratch/build/macos" PackageConsumer
swift build \
  --product PackageConsumer \
  --scratch-path "$scratch/build/ios" \
  --sdk "$(xcrun --sdk iphoneos --show-sdk-path)" \
  --triple arm64-apple-ios15.0
