#!/usr/bin/env bash
#MISE description="Run the Kotlin/Native suite against a native preset's install, on a simulator or emulator where the target needs one."
#MISE extends="ffi:preset"
#MISE dir="../.."
#MISE shell="bash"
set -euo pipefail

gradle_tasks=()
case "$usage_preset" in
  linux-gnu-x64-*) kotlin_target=linuxX64 ;;
  macos-arm64-*) kotlin_target=macosArm64 ;;
  android-arm64-*) kotlin_target=androidNativeArm64 ;;
  android-x64-*) kotlin_target=androidNativeX64 ;;
  ios-simulator-arm64-metal)
    kotlin_target=iosSimulatorArm64
    gradle_tasks+=(":bindings:kotlin:runtimes:metal:${kotlin_target}Klib")
    MLN_FFI_IOS_SIMULATOR_DEVICE_ID=$(devices-cli get ios)
    export MLN_FFI_IOS_SIMULATOR_DEVICE_ID
    ;;
  tvos-simulator-arm64-metal)
    kotlin_target=tvosSimulatorArm64
    gradle_tasks+=(":bindings:kotlin:runtimes:metal:${kotlin_target}Klib")
    MLN_FFI_IOS_SIMULATOR_DEVICE_ID=$(devices-cli get tvos)
    export MLN_FFI_IOS_SIMULATOR_DEVICE_ID
    ;;
  ios-arm64-metal)
    echo "The Kotlin iOS tests need a runnable target; test ios-simulator-arm64-metal instead of $usage_preset." >&2
    exit 2
    ;;
  tvos-arm64-metal)
    echo "The Kotlin tvOS tests need a runnable target; test tvos-simulator-arm64-metal instead of $usage_preset." >&2
    exit 2
    ;;
  *)
    echo "The Kotlin binding has no runnable Kotlin/Native tests for preset $usage_preset." >&2
    exit 2
    ;;
esac
install="build/$usage_preset/install"
if [[ "$kotlin_target" != androidNative* ]]; then
  exec ./gradlew -Pmaplibre.localBuild="$install" \
    ${gradle_tasks[@]+"${gradle_tasks[@]}"} ":bindings:kotlin:${kotlin_target}Test"
fi
# Gradle only links the Android suite; tools/devices/run runs it on an emulator
# for the install's ABI.
mise run //:android-sdk-packages --native-only
# Use the project's NDK linker, which also runs natively on Apple Silicon.
# Kotlin's bundled Android toolchain contains an Intel-only macOS linker.
./gradlew \
  -Pmaplibre.localBuild="$install" \
  -Pmaplibre.android.nativeTestToolchain="$("$MISE_MONOREPO_ROOT/tools/env/android-ndk-prebuilt.sh")" \
  ":bindings:kotlin:linkDebugTest${kotlin_target/androidNative/AndroidNative}"
export MLN_FFI_DEVICE_INSTALL="$install" MLN_FFI_DEVICE_TIMEOUT=300
export MLN_FFI_DEVICE_LIBRARIES="$install/lib/libmln_test_graphics.so"
exec "$MISE_MONOREPO_ROOT/tools/devices/run" "bindings/kotlin/build/bin/$kotlin_target/debugTest/test.kexe"
