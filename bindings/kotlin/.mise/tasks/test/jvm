#!/usr/bin/env bash
#MISE description="Run the Kotlin/JVM suite against a host, musl, or FreeBSD preset's install."
#MISE extends="ffi:preset"
#MISE dir="../.."
#MISE shell="bash"
set -euo pipefail

case "$usage_preset" in
  linux-musl-* | freebsd-*)
    # Gradle runs on the host, so it stages the suite's classpath in the
    # repository, and tools/devices/run starts a JDK 25 in Alpine or the
    # worktree's FreeBSD virtual machine, which mount it.
    ./gradlew :bindings:kotlin:jvmDeviceTestClasspath
    install="$PWD/build/$usage_preset/install"
    suite="$PWD/bindings/kotlin/build/jvm-device-test"
    classpath="$suite/classes:$suite/lib/*"
    export MLN_FFI_DEVICE_INSTALL="$install" MLN_FFI_DEVICE_TIMEOUT=900
    export MLN_FFI_MUSL_TEST_IMAGE=eclipse-temurin:25-jre-alpine
    if [[ "$usage_preset" == freebsd-* ]]; then
      host=$(tools/devices/freebsd-host)
      ssh -o BatchMode=yes "$host" pkg install --yes --quiet openjdk25-jre-headless >&2
    fi
    exec tools/devices/run java --enable-native-access=ALL-UNNAMED -cp "$classpath" \
      -Djava.library.path="$install/lib" \
      -Dorg.maplibre.nativeffi.test.graphics.library="$install/lib/libmln_test_graphics.so" \
      -Dorg.maplibre.nativeffi.test.classpath="$classpath" \
      org.maplibre.nativeffi.DeviceSuite "$suite/classes"
    ;;
  linux-* | macos-* | windows-*) ;;
  *)
    echo "The Kotlin/JVM suite tests host and FreeBSD presets only, got: $usage_preset" >&2
    exit 2
    ;;
esac
./gradlew -Pmaplibre.localBuild="build/$usage_preset/install" :bindings:kotlin:jvmTest
