#!/usr/bin/env bash
#MISE description="Run the Kotlin/Wasm suite in headless Chromium against a web preset's browser package."
#MISE dir="../.."
#MISE shell="bash"
#USAGE arg "<preset>"
#USAGE flag "--filter <filter>" help="Run only the tests that match this Gradle test filter"
set -euo pipefail

# The preset is checked before it builds, so a refusal names its reason.
case "$usage_preset" in
  web-wasm32-webgl) render_backend=webgl ;;
  web-wasm32-webgpu) render_backend=webgpu ;;
  *)
    echo "The Kotlin/Wasm suite tests the web-wasm32 presets, got: $usage_preset" >&2
    exit 2
    ;;
esac
mise run //:build "$usage_preset"
module_dir="$(bindings/kotlin/scripts/stage-wasm-runtime.sh "$usage_preset")"
gradle_args=(
  -Pmaplibre.wasm.moduleDir="$module_dir"
  -Pmaplibre.wasm.renderBackend="$render_backend"
  -Pmaplibre.wasm.chromium="$(node scripts/find-chromium.mjs)"
)
test_args=()
if [[ -n "${usage_filter:-}" ]]; then
  test_args+=(--tests "$usage_filter")
fi
./gradlew "${gradle_args[@]}" :bindings:kotlin:wasmJsBrowserTest ${test_args[@]+"${test_args[@]}"}
