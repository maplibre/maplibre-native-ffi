#!/usr/bin/env bash
#MISE description="Build the Kotlin binding and embedded native runtime for an iOS or tvOS target."
#MISE depends=[{ task = "//:build", args = ["{{usage.preset}}"] }]
#MISE dir="../.."
#MISE shell="bash"
#USAGE arg "<preset>" {
#USAGE   choices "ios-arm64" "ios-simulator-arm64" "tvos-arm64" "tvos-simulator-arm64"
#USAGE }
set -euo pipefail

case "$usage_preset" in
  ios-arm64) kotlin_target=iosArm64 ;;
  ios-simulator-arm64) kotlin_target=iosSimulatorArm64 ;;
  tvos-arm64) kotlin_target=tvosArm64 ;;
  tvos-simulator-arm64) kotlin_target=tvosSimulatorArm64 ;;
esac
./gradlew \
  -Pmaplibre.localBuild="build/$usage_preset/install" \
  ":bindings:kotlin:${kotlin_target}Klib" \
  ":bindings:kotlin:runtimes:native:${kotlin_target}Klib"
