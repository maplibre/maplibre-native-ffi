#!/usr/bin/env bash
#MISE description="Build the Kotlin Android binding and runtime from the presets built under build/."
#MISE dir="../.."
#MISE shell="bash"
#USAGE arg "[abis]" default="armeabi-v7a,arm64-v8a,x86,x86_64" {
#USAGE   choices "armeabi-v7a" "arm64-v8a" "x86" "x86_64" "arm64-v8a,x86_64" "armeabi-v7a,arm64-v8a,x86_64" "arm64-v8a,x86,x86_64" "armeabi-v7a,arm64-v8a,x86,x86_64"
#USAGE }
set -euo pipefail

./gradlew \
  -Pmaplibre.localBuild=build \
  -Pmaplibre.android.abis="$usage_abis" \
  :bindings:kotlin:androidBuild
