#!/usr/bin/env bash
#MISE description="Build the Kotlin binding for a native preset's target against its install."
#MISE extends="ffi:preset"
#MISE dir="../.."
#MISE shell="bash"
set -euo pipefail

# The runtime KLIB embeds the platform's static archive, so it builds for the
# presets of the native runtime's targets. A web preset's runtime packs its
# browser package.
runtime_target=
tasks=()
case "$usage_preset" in
  android-arm) kotlin_target=androidNativeArm32; runtime_target=$kotlin_target ;;
  android-arm64) kotlin_target=androidNativeArm64; runtime_target=$kotlin_target ;;
  android-x86) kotlin_target=androidNativeX86; runtime_target=$kotlin_target ;;
  android-x64) kotlin_target=androidNativeX64; runtime_target=$kotlin_target ;;
  linux-gnu-x64) kotlin_target=linuxX64; runtime_target=$kotlin_target; tasks+=(:bindings:kotlin:jvmJar) ;;
  macos-arm64) kotlin_target=macosArm64; runtime_target=$kotlin_target; tasks+=(:bindings:kotlin:jvmJar) ;;
  macos-x64) kotlin_target=macosX64; runtime_target=$kotlin_target ;;
  windows-x64) kotlin_target=mingwX64; tasks+=(:bindings:kotlin:jvmJar) ;;
  linux-gnu-arm64 | windows-arm64 | mingw-*) kotlin_target=; tasks+=(:bindings:kotlin:jvmJar) ;;
  web-wasm32-webgl) kotlin_target=; tasks+=(:bindings:kotlin:compileKotlinWasmJs :bindings:kotlin:runtimes:webgl:wasmJsProcessResources) ;;
  web-wasm32-webgpu) kotlin_target=; tasks+=(:bindings:kotlin:compileKotlinWasmJs :bindings:kotlin:runtimes:webgpu:wasmJsProcessResources) ;;
  *)
    echo "Unsupported Kotlin build preset: $usage_preset" >&2
    exit 2
    ;;
esac
gradle_args=(-Pmaplibre.localBuild="build/$usage_preset/install")
if [[ -n "$kotlin_target" ]]; then
  tasks+=(":bindings:kotlin:${kotlin_target}Klib")
fi
if [[ -n "$runtime_target" ]]; then
  tasks+=(":bindings:kotlin:runtimes:native:${runtime_target}Klib")
fi
exec ./gradlew "${gradle_args[@]}" "${tasks[@]}"
