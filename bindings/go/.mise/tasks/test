#!/usr/bin/env bash
#MISE description="Test the Go binding against a native preset's install."
#MISE extends="ffi:preset"
#MISE shell="bash"
set -euo pipefail

# The preset selects the compiler and test runner.
case "$usage_preset" in
  android-arm-*)
    echo "The Android emulator runs arm64 and x64 guests; check $usage_preset with //bindings/go:build and test an android-arm64 or android-x64 preset instead." >&2
    exit 2
    ;;
  ohos-x64-*) ;;
  ohos-*)
    echo "The OpenHarmony emulator runs an x64 guest; check $usage_preset with //bindings/go:build and test ohos-x64-egl instead." >&2
    exit 2
    ;;
esac

source "$MISE_MONOREPO_ROOT/tools/env/go-native-env.sh" "$usage_preset"
export GOCACHE="$MISE_MONOREPO_ROOT/build/$usage_preset/go-cache"
source "$MISE_MONOREPO_ROOT/bindings/go/test-tags.sh" "$usage_preset"
source "$MISE_MONOREPO_ROOT/tools/env/go-cross-env.sh" "$usage_preset"
if [[ -n "$goos" ]]; then
  # The render tests load tests/graphics, which travels beside the C API
  # library. Go's own timeout ends a hung binary with a goroutine dump before
  # the device runner's deadline ends it without one.
  export MLN_FFI_DEVICE_INSTALL="$native_install_dir"
  export MLN_FFI_DEVICE_TIMEOUT=300
  case "$usage_preset" in
    ios-*) export MLN_FFI_DEVICE_LIBRARIES="$native_install_dir/lib/libmln_test_graphics.dylib" ;;
    *) export MLN_FFI_DEVICE_LIBRARIES="$native_install_dir/lib/libmln_test_graphics.so" ;;
  esac
  # Alpine and the FreeBSD virtual machine see only the repository, so the
  # test binaries are built inside it.
  export GOTMPDIR="$MISE_MONOREPO_ROOT/build/$usage_preset/go-tmp"
  mkdir -p "$GOTMPDIR"
  # The device boots here rather than inside the first binary's deadline.
  "$MISE_MONOREPO_ROOT/tools/devices/run" --boot
  go test -count=1 -p 1 -timeout 270s -v -exec "$MISE_MONOREPO_ROOT/tools/devices/run" -tags "$go_test_tags" ./...
  exec go vet -tags "$go_test_tags" ./...
fi

# The race detector also turns on checkptr's unsafe.Pointer checks. Go has no
# race detector for windows/arm64.
race=-race
case "$usage_preset" in
  windows-arm64-*) race= ;;
esac
# Go's test cache cannot see the native library, so always rerun the suite.
go test -count=1 ${race:+"$race"} -tags "$go_test_tags" ./...
go vet -tags "$go_test_tags" ./...
