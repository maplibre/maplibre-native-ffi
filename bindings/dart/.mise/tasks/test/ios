#!/usr/bin/env bash
#MISE description="Run portable Dart binding suites in a Flutter iOS simulator host."
#MISE depends=[{ task = "//:build", args = ["{{usage.preset}}"] }, { task = ":_native-prefix", args = ["{{usage.preset}}"] }]
#MISE shell="bash"
#USAGE arg "[preset]" default="ios-simulator-arm64-metal" { choices "ios-simulator-arm64-metal" }
set -euo pipefail

device=$(devices-cli get ios)
app=.dart_tool/flutter_ios_test
flutter create --empty --no-pub --org org.maplibre.native_ffi \
  --platforms ios --project-name maplibre_native_ffi_ios_test "$app"
cp tool/flutter_ios_test/pubspec.yaml "$app/pubspec.yaml"
mkdir -p "$app/integration_test" "$app/hook"
cp tool/flutter_ios_test/hook/build.dart "$app/hook/build.dart"
cp tool/flutter_ios_test/integration_test/binding_test.dart "$app/integration_test/binding_test.dart"
cd "$app"
if ! grep -q '^ARCHS = arm64$' ios/Flutter/Debug.xcconfig; then
  printf '\nARCHS = arm64\n' >>ios/Flutter/Debug.xcconfig
fi
flutter pub get
# Flutter 3.47 can launch the app before it starts reading the simulator log,
# miss the app's VM service address, and wait for it without limit
# (flutter/flutter#181771). The bound turns that wait into a failure, and the
# tool's verbose log and the app's own log show which step stalled.
: >test-results.txt
status=0
perl -e 'alarm shift; exec @ARGV' 300 \
  flutter test integration_test/binding_test.dart --device-id "$device" \
  --timeout 2m --verbose --reporter silent \
  --file-reporter expanded:test-results.txt >flutter-test.log 2>&1 || status=$?
cat test-results.txt
if [[ $status -ne 0 ]]; then
  cat flutter-test.log
fi
if [[ $status -eq 142 ]]; then
  echo "flutter test did not finish within 5 minutes. The app's Flutter log:" >&2
  perl -e 'alarm shift; exec @ARGV' 60 \
    xcrun simctl spawn "$device" log show --last 10m --style compact \
    --predicate 'process == "Runner" AND senderImagePath ENDSWITH "/Flutter"' |
    tail -n 20 >&2 || true
fi
exit "$status"
