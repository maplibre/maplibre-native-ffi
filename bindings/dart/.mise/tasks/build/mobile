#!/usr/bin/env bash
#MISE description="Build the Dart binding in a Flutter mobile application."
#MISE depends=[{ task = "//:build", args = ["{{usage.preset}}"] }, { task = ":_native-prefix", args = ["{{usage.preset}}"] }]
#MISE shell="bash"
#USAGE arg "[preset]" {
#USAGE   choices \
#USAGE     "android-arm-egl" \
#USAGE     "android-arm-vulkan" \
#USAGE     "android-arm64-egl" \
#USAGE     "android-arm64-vulkan" \
#USAGE     "android-x64-egl" \
#USAGE     "android-x64-vulkan" \
#USAGE     "ios-arm64-metal" \
#USAGE     "ios-simulator-arm64-metal"
#USAGE }
set -euo pipefail

app=.dart_tool/flutter_smoke
flutter create \
  --empty \
  --no-pub \
  --org org.maplibre.native_ffi \
  --platforms android,ios \
  --project-name maplibre_native_ffi_smoke \
  "$app"
cp tool/flutter_smoke/pubspec.yaml "$app/pubspec.yaml"
cp tool/flutter_smoke/lib/main.dart "$app/lib/main.dart"
cd "$app"
flutter pub get

case "$usage_preset" in
  android-arm-*)
    flutter build apk --release --target-platform android-arm
    ;;
  android-arm64-*)
    flutter build apk --release --target-platform android-arm64
    ;;
  android-x64-*)
    flutter build apk --release --target-platform android-x64
    ;;
  ios-arm64-*)
    flutter build ios --release --no-codesign
    ;;
  ios-simulator-arm64-*)
    # Flutter prepares native assets for every standard simulator architecture
    # before Xcode narrows a debug build to the active architecture.
    printf '\nARCHS = arm64\n' >>ios/Flutter/Debug.xcconfig
    flutter build ios --debug --simulator --no-codesign
    ;;
esac
