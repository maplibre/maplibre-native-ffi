#!/usr/bin/env bash
#MISE description="Run the TypeScript binding suite under Node, Bun, and Deno, on ArkTS for an OpenHarmony preset, or in headless Chromium for an Emscripten preset."
#MISE extends="ffi:preset"
#MISE depends=[{ task = ":build", args = ["{{usage.preset}}"] }]
#MISE shell="bash"
#USAGE arg "[runtime]" help="One of the preset's supported desktop runtimes" {
#USAGE   choices "node" "bun" "deno"
#USAGE }
set -euo pipefail

# The preset selects the host: OpenHarmony presets run the suite on ArkTS from
# a signed HAP on the emulator, Emscripten presets run it as a page in headless
# Chromium, and desktop presets run it in one process per runtime, after
# packing the preset's packages as the pack task does.
case "$usage_preset" in
  ohos-*)
    if [[ -n ${usage_runtime:-} ]]; then
      echo "error: an OpenHarmony preset runs the suite on ArkTS, not $usage_runtime" >&2
      exit 2
    fi
    exec mise run :_test-arkts "$usage_preset"
    ;;
  emscripten-*)
    if [[ -n ${usage_runtime:-} ]]; then
      echo "error: an Emscripten preset runs the suite in a browser, not $usage_runtime" >&2
      exit 2
    fi
    exec scripts/test-browser.sh "$usage_preset"
    ;;
esac
exec scripts/test-desktop.sh "$usage_preset" ${usage_runtime:-}
