#!/usr/bin/env bash
#MISE description="Run the TypeScript binding suite with one of the preset's render backends, under Node, Bun, and Deno, on ArkTS for an OpenHarmony preset, or in headless Chromium for a web preset."
#MISE extends="ffi:test"
#MISE depends=[{ task = ":build", args = ["{{usage.preset}}"] }]
#MISE shell="bash"
#USAGE arg "[runtime]" help="One of the preset's supported desktop runtimes" {
#USAGE   choices "node" "bun" "deno"
#USAGE }
set -euo pipefail

source "$MISE_MONOREPO_ROOT/tools/env/test-backend.sh" "$usage_preset" "$usage_backend"
case "$usage_preset" in
  ohos-*)
    if [[ -n "${usage_runtime:-}" ]]; then
      echo "error: an OpenHarmony preset runs the suite on ArkTS, not $usage_runtime" >&2
      exit 2
    fi
    exec mise run :_test-arkts "$usage_preset" "$MLN_FFI_TEST_BACKEND"
    ;;
  web-*)
    if [[ -n "${usage_runtime:-}" ]]; then
      echo "error: a web preset runs the suite in a browser, not $usage_runtime" >&2
      exit 2
    fi
    exec scripts/test-browser.sh "$usage_preset"
    ;;
esac
exec scripts/test-desktop.sh "$usage_preset" "${usage_runtime:-}"
