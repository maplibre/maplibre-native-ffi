#!/usr/bin/env bash
#MISE description="Test and lint the Rust crates against a native preset's install."
#MISE extends="ffi:preset"
#MISE dir="../.."
#MISE shell="bash"
#USAGE arg "[profile]" default="dev" {
#USAGE   choices "dev" "release"
#USAGE }
set -euo pipefail

# The preset selects the runner: Emscripten presets run as a page in headless
# Chromium, host and Mac Catalyst presets run in process, and cargo hands every
# other test executable to tools/devices/run, which pushes it to an emulator,
# spawns it on a simulator, or runs it in Alpine.
case "$usage_preset" in
  android-arm-*)
    echo "The Android emulator runs arm64 and x64 guests; check $usage_preset with //bindings/rust:build and test an android-arm64 or android-x64 preset instead." >&2
    exit 2
    ;;
  ohos-x64-egl) ;;
  ohos-x64-*)
    echo "The OpenHarmony emulator runs EGL only; check $usage_preset with //bindings/rust:build and test ohos-x64-egl instead." >&2
    exit 2
    ;;
  ohos-*)
    echo "The OpenHarmony emulator runs an x64 guest; check $usage_preset with //bindings/rust:build and test ohos-x64-egl instead." >&2
    exit 2
    ;;
  emscripten-*)
    exec "$MISE_MONOREPO_ROOT/scripts/test-rust-browser.sh" "$usage_preset"
    ;;
  ios-maccatalyst-* | ios-simulator-* | visionos-simulator-*) ;;
  ios-* | visionos-*)
    echo "The Rust binding tests need a runnable target; test an ios-simulator, visionos-simulator, or ios-maccatalyst preset instead of $usage_preset." >&2
    exit 2
    ;;
esac

native_install_dir="$MISE_MONOREPO_ROOT/build/$usage_preset/install"
export MAPLIBRE_NATIVE_FFI_LOCAL_BUILD="$native_install_dir"
if command -v cygpath >/dev/null 2>&1; then
  # On Windows the DLL loads its own dependencies from the prefix it was
  # installed into.
  native_bin_dir="$(cygpath -u "$native_install_dir/bin")"
  export PATH="$native_bin_dir${PATH:+:${PATH}}"
fi
if [[ "$usage_preset" == linux-musl-* ]]; then
  # Rendering loads Alpine's graphics implementation, so the test process uses
  # musl's dynamic loader while the packaged native archive remains static.
  export MLN_FFI_RUST_MUSL_DYNAMIC=1
fi
source "$MISE_MONOREPO_ROOT/tools/env/rust-cross-env.sh" "$usage_preset"
cargo_args=()
if [[ -n "$cargo_target" ]]; then
  cargo_args+=(--target "$cargo_target")
fi
if [[ "$usage_profile" == "release" ]]; then
  cargo_args+=(--release)
fi
# The sys crate's rpath covers only its own link targets, so the core and
# umbrella test binaries need the library located at run time. Resolving it here
# rather than through RUSTFLAGS keeps the preset out of the compiler command
# line, which sccache keys on.
lib_dirs="$native_install_dir/lib"
if [[ -n "${MLN_FFI_VULKAN_LOADER_DIR:-}" ]]; then
  lib_dirs="$lib_dirs:$MLN_FFI_VULKAN_LOADER_DIR"
fi
export LD_LIBRARY_PATH="$lib_dirs${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export DYLD_LIBRARY_PATH="$lib_dirs${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"
# On the host, tests run in parallel: the ones that change process-global state
# serialize on a lock of their own.
test_args=()
if [[ -n "$cargo_runner" ]]; then
  # Off the host each test executable runs its tests one at a time and gets
  # ten minutes, and doctests stay with the host's suite. The simulator reads
  # the host's file system and passes each SIMCTL_CHILD_ variable without the
  # prefix; an emulator receives the render tests' tests/graphics library
  # beside the executable.
  export MLN_FFI_DEVICE_TIMEOUT=600
  export SIMCTL_CHILD_DYLD_LIBRARY_PATH="$native_install_dir/lib"
  export MLN_FFI_DEVICE_LIBRARIES="$native_install_dir/lib/libmln_test_graphics.so"
  cargo_args+=(--tests)
  test_args+=(-- --test-threads=1)
fi
cargo test ${cargo_args[@]+"${cargo_args[@]}"} \
  -p maplibre-native-ffi-sys \
  -p maplibre-native-ffi \
  ${test_args[@]+"${test_args[@]}"}
# Clippy is profile-independent. Every other host preset runs it against the
# dev graph, so the release variant avoids compiling that graph a second time.
if [[ "$usage_profile" == "dev" ]]; then
  clippy_args=()
  if [[ -n "$cargo_target" ]]; then
    clippy_args+=(--target "$cargo_target")
  fi
  cargo clippy \
    -p maplibre-native-ffi-sys \
    -p maplibre-native-ffi \
    ${clippy_args[@]+"${clippy_args[@]}"} --all-targets -- -D warnings
fi
