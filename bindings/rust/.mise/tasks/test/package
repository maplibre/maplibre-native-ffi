#!/usr/bin/env bash
#MISE description="Package the crates as a release prepares them, and test the sys crate against this build's native archive."
#MISE dir="../.."
# A file task's usage is not templated, so the host preset default arrives
# through the environment.
#MISE env={ MLN_FFI_HOST_NATIVE_PRESET = "{{vars.host_native_preset}}" }
#MISE shell="bash"
#USAGE arg "[preset]" env="MLN_FFI_HOST_NATIVE_PRESET"
set -euo pipefail

# Tests the packaged sys crate: the crate above it adds nothing to how the native
# library arrives.
archive="$MISE_MONOREPO_ROOT/build/packages/native/dist/maplibre-native-c-$usage_preset.tar.gz"
tag=v0.202601.0
scratch="$(mktemp -d)"
trap 'rm -rf "$scratch"' EXIT

# A copy of the workspace stands in for the release checkout, which the release
# prepares in place.
workspace="$scratch/workspace"
mkdir -p "$workspace"
git ls-files -z --cached --others --exclude-standard -- \
  Cargo.toml Cargo.lock LICENSE bindings/python bindings/rust |
  tar -c --null -T - | tar -x -C "$workspace"
PYTHONPATH=tools/release python3 - "$scratch/artifacts.json" "$tag" "$archive" <<'PY'
import json, pathlib, sys, tarfile
from native_package_release import artifact_index, publish_inventory

archive = pathlib.Path(sys.argv[3])
archive_root = archive.name.removesuffix(".tar.gz")
with tarfile.open(archive) as source:
    inventory = json.load(source.extractfile(f"{archive_root}/share/maplibre-native-c/sbom.cdx.json"))
publish_inventory(archive, inventory, sys.argv[2])
pathlib.Path(sys.argv[1]).write_text(json.dumps(artifact_index(sys.argv[2], [archive])))
PY
python3 tools/release/rust_release.py "$workspace" "$tag" --artifacts "$scratch/artifacts.json"
cargo package --manifest-path "$workspace/Cargo.toml" --no-verify \
  --target-dir "$scratch/target" \
  -p maplibre-native-ffi-sys \
  -p maplibre-native-ffi

crate=maplibre-native-ffi-sys
mkdir "$scratch/$crate"
tar -xzf "$scratch/target/package/$crate-${tag#v}.crate" -C "$scratch/$crate" --strip-components 1
package="$scratch/$crate/Cargo.toml"
# An empty cache makes the build script download the archive.
python3 tools/release/native_download_fixture.py "$archive" "$tag" -- \
  env -u MAPLIBRE_NATIVE_FFI_LOCAL_BUILD XDG_CACHE_HOME="$scratch/cache" \
  cargo test --locked --manifest-path "$package" \
  --target-dir "$MISE_MONOREPO_ROOT/target"
