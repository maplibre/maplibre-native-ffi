#!/usr/bin/env bash
#MISE description="Test the Zig binding against a native preset's install."
#MISE extends="ffi:preset"
#MISE shell="bash"
set -euo pipefail

# Android presets use their matching emulator, musl presets run in Alpine, and
# other host presets run in process. Each test gets 30 seconds times
# MLN_TEST_TIMEOUT_SCALE, which defaults to 3 on emulators and in Alpine's
# software renderer, and to 1 on the host; the fixture scales its waits by the
# same value.
native_install_dir="$MISE_MONOREPO_ROOT/build/$usage_preset/install"
case "$usage_preset" in
  android-* | linux-musl-*)
    export MLN_TEST_TIMEOUT_SCALE="${MLN_TEST_TIMEOUT_SCALE:-3}"
    ;;
  windows-*)
    export MLN_TEST_TIMEOUT_SCALE="${MLN_TEST_TIMEOUT_SCALE:-1}"
    # The DLL loads its own dependencies from the prefix it was installed into.
    export PATH="$(cygpath -u "$native_install_dir/bin")${PATH:+:${PATH}}"
    ;;
  *)
    export MLN_TEST_TIMEOUT_SCALE="${MLN_TEST_TIMEOUT_SCALE:-1}"
    ;;
esac
case "$usage_preset" in
  android-arm64-* | android-x64-*) ;;
  android-*)
    echo "The Android emulator runs arm64 and x64 guests; check $usage_preset with //bindings/zig:build and test an android-arm64 or android-x64 preset instead." >&2
    exit 2
    ;;
esac

source "$MISE_MONOREPO_ROOT/tools/env/zig-cross-env.sh" "$usage_preset"
zig build test --build-file ../../build.zig \
  -Doptimize=ReleaseSafe \
  -Dlocal-build="$native_install_dir" \
  -Ddependency-include-dir="$MISE_MONOREPO_ROOT/third_party/maplibre-native/vendor/Vulkan-Headers/include" \
  ${zig_cross_args[@]+"${zig_cross_args[@]}"} \
  --test-timeout "$((30 * MLN_TEST_TIMEOUT_SCALE))s" \
  --summary all \
  --verbose
