#!/usr/bin/env bash
#MISE description="Build the runtime wheel for a preset's render backend into dist/."
#MISE extends="ffi:preset"
#MISE shell="bash"
set -euo pipefail

if [[ "$usage_preset" == android-* ]]; then
  exec "$MISE_MONOREPO_ROOT/scripts/build-python-android-wheel.sh" "$usage_preset"
fi

# Zig preserves the glibc floor from cmake/toolchains/zig.cmake; the host linker
# would bind libm references to the build machine's newer glibc.
install_dir="$MISE_MONOREPO_ROOT/build/$usage_preset/install"
backend=$(jq -r .backend "$install_dir/share/maplibre-native-c/artifact.json")
if [[ -z "$backend" || ! -d "runtimes/$backend" ]]; then
  echo "No Python runtime serves the backend of $usage_preset." >&2
  exit 2
fi
runtime=$backend
if [[ "$usage_preset" == mingw-* ]]; then
  runtime+=-mingw
fi
python3 "$MISE_MONOREPO_ROOT/tools/release/python_release.py" metadata . "$install_dir"
maturin_flags=()
if [ "$(uname -s)" = Linux ]; then maturin_flags=(--zig); fi
# Zig links a musl target against its own musl, so the wheel takes a
# musllinux tag and needs no repair either.
case "$usage_preset" in
  # Match the native archive's minimum OS rather than maturin's default.
  macos-*)
    export MACOSX_DEPLOYMENT_TARGET=14.3
    if [[ "$usage_preset" == macos-x64-* ]]; then
      maturin_flags+=(--target x86_64-apple-darwin)
    fi
    ;;
  linux-musl-arm64-*) maturin_flags+=(--target aarch64-unknown-linux-musl) ;;
  linux-musl-x64-*) maturin_flags+=(--target x86_64-unknown-linux-musl) ;;
  linux-gnu-riscv64-*) maturin_flags+=(--target riscv64gc-unknown-linux-gnu) ;;
  linux-musl-riscv64-*) maturin_flags+=(--target riscv64gc-unknown-linux-musl) ;;
  mingw-*)
    source "$MISE_MONOREPO_ROOT/tools/env/rust-cross-env.sh" "$usage_preset"
    maturin_flags+=(--target "$cargo_target" --auditwheel repair)
    ;;
esac
wheel_output=$(mktemp -d)
trap 'rm -rf "$wheel_output"' EXIT
mkdir -p dist
cd "runtimes/$runtime"
MAPLIBRE_NATIVE_FFI_LOCAL_BUILD="$install_dir" \
  uv run --project ../.. --no-sync maturin build --release --out "$wheel_output" \
  ${maturin_flags[@]+"${maturin_flags[@]}"}

uv run --no-project --with wheel==0.47.0 python "$MISE_MONOREPO_ROOT/tools/release/python_release.py" embed "$wheel_output" sbom.cdx.json
mv "$wheel_output"/*.whl ../../dist/
