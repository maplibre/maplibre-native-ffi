    return mln_acquired_frame_dispose(
      static_cast<mln_acquired_frame>(handle), nullptr
    );
  }
  if (std::strcmp(native_type, "mln_event_batch") == 0) {
    mln_event_batch_release(static_cast<mln_event_batch>(handle));
    return MLN_STATUS_OK;
