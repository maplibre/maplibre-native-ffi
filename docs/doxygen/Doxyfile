PROJECT_NAME = "MapLibre Native C API"
PROJECT_BRIEF = "Public C ABI for the MapLibre Native wrapper."
QUIET = YES

OUTPUT_DIRECTORY = doxygen/gen
INPUT = ../include
FILE_PATTERNS = *.h
RECURSIVE = YES
# The binding-internal header that cmake/mln_ffi_install.cmake leaves out.
EXCLUDE = ../include/maplibre_native_c/binding_support.h

GENERATE_HTML = YES
HTML_OUTPUT = html
GENERATE_LATEX = NO
GENERATE_XML = NO
GENERATE_TAGFILE = doxygen/gen/html/maplibre-native-c.tag

# Every declaration is listed, documented or not, so a comment can be left out
# when the name and type already say everything.
EXTRACT_ALL = YES
EXTRACT_STATIC = NO

OPTIMIZE_OUTPUT_FOR_C = YES
MACRO_EXPANSION = YES
EXPAND_ONLY_PREDEF = YES
PREDEFINED = MLN_API= \
             MLN_NOEXCEPT= \
             "MLN_BINDING(contract)="
EXCLUDE_SYMBOLS = MLN_API MLN_NOEXCEPT MLN_BINDING

SHOW_INCLUDE_FILES = NO
SOURCE_BROWSER = NO
INLINE_SOURCES = NO
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION = NO
GENERATE_TREEVIEW = NO
FULL_SIDEBAR = NO
DISABLE_INDEX = NO
HAVE_DOT = NO

WARN_AS_ERROR = NO
WARN_IF_UNDOCUMENTED = NO
WARN_IF_DOC_ERROR = YES
