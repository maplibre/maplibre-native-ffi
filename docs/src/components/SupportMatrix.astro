---
import supportMatrix from "../generated/support-matrix.json";
import { Badge } from "@astrojs/starlight/components";

type Status = "tested" | "run" | "build-only";
type BadgeVariant = "default" | "note" | "success" | "caution";

type Backend = {
  backendLabel: string;
  status: Status;
};

type EnvironmentSupport = {
  environment: string;
  environmentLabel: string;
  backends: Backend[];
};

type SubprojectSupport = {
  label: string;
  environments: EnvironmentSupport[];
};

const environmentColumns = supportMatrix.environments.map((row) => ({
  environment: row.environment,
  label: row.environmentLabel,
}));

function badgeVariant(status: Status): BadgeVariant {
  if (status === "tested" || status === "run") {
    return "success";
  }
  if (status === "build-only") {
    return "caution";
  }
  return "default";
}

function environmentSupport(
  subproject: SubprojectSupport,
  environment: string,
): EnvironmentSupport | undefined {
  return subproject.environments.find(
    (entry) => entry.environment === environment,
  );
}
---

<section aria-labelledby="support-native-heading">
  <h3 id="support-native-heading">Native Platforms</h3>
  <table>
    <thead>
      <tr>
        <th scope="col">Environment</th>
        <th scope="col">Backends</th>
      </tr>
    </thead>
    <tbody>
      {supportMatrix.native.map((row) => (
        <tr>
          <th scope="row">{row.environmentLabel}</th>
          <td>
            {row.backends.map((backend) => (
              <span>
                <Badge
                  text={backend.backendLabel}
                  variant={badgeVariant(backend.status)}
                  size="small"
                />{" "}
              </span>
            ))}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</section>

<section aria-labelledby="support-bindings-heading">
  <h3 id="support-bindings-heading">Language Bindings</h3>
  <table>
    <thead>
      <tr>
        <th scope="col">Binding</th>
        {environmentColumns.map((environment) => (
          <th scope="col">{environment.label}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {supportMatrix.bindings.map((binding) => (
        <tr>
          <th scope="row">{binding.label}</th>
          {environmentColumns.map((environment) => {
            const support = environmentSupport(binding, environment.environment);
            return (
              <td>
                {support ? support.backends.map((backend) => (
                  <span>
                    <Badge
                      text={backend.backendLabel}
                      variant={badgeVariant(backend.status)}
                      size="small"
                    />{" "}
                  </span>
                )) : "-"}
              </td>
            );
          })}
        </tr>
      ))}
    </tbody>
  </table>
</section>

<section aria-labelledby="support-examples-heading">
  <h3 id="support-examples-heading">Examples</h3>
  <table>
    <thead>
      <tr>
        <th scope="col">Example</th>
        {environmentColumns.map((environment) => (
          <th scope="col">{environment.label}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {supportMatrix.examples.map((example) => (
        <tr>
          <th scope="row">{example.label}</th>
          {environmentColumns.map((environment) => {
            const support = environmentSupport(example, environment.environment);
            return (
              <td>
                {support ? support.backends.map((backend) => (
                  <span>
                    <Badge
                      text={backend.backendLabel}
                      variant={badgeVariant(backend.status)}
                      size="small"
                    />{" "}
                  </span>
                )) : "-"}
              </td>
            );
          })}
        </tr>
      ))}
    </tbody>
  </table>
</section>
