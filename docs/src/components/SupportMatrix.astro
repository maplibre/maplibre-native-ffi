---
import supportMatrix from "../generated/support-matrix.json";

type Status = "tested" | "build-only" | "path-known" | "blocked" | "unknown";

type Cell = {
  status: string;
  detail?: string;
};

const glyphs: Record<Status, string> = {
  tested: "✓",
  "build-only": "◐",
  "path-known": "○",
  blocked: "✕",
  unknown: "?",
};

const statusLabels = new Map(
  supportMatrix.statuses.map((row) => [row.status, row.label]),
);

const sourceRoot = "https://github.com/maplibre/maplibre-native-ffi/tree/main";
const issueRoot = "https://github.com/maplibre/maplibre-native-ffi/issues";

const rows = supportMatrix.platforms.flatMap((platform) => {
  const platformRows = platform.architectures.reduce(
    (count, arch) => count + arch.backends.length,
    0,
  );
  return platform.architectures.flatMap((arch, archIndex) =>
    arch.backends.map((backend, backendIndex) => ({
      platform: platform.label,
      arch: arch.label,
      backend: backend.label,
      cells: backend.cells as Cell[],
      platformRows: archIndex === 0 && backendIndex === 0 ? platformRows : 0,
      archRows: backendIndex === 0 ? arch.backends.length : 0,
    })),
  );
});

// Gaps that share a language and reason collapse into one entry, as in the
// tracking issue.
function gapGroups(status: string) {
  const groups = new Map<
    string,
    { language: string; platforms: string[]; reason: string; link?: string }
  >();
  for (const gap of supportMatrix.gaps as {
    language: string;
    platform: string;
    status: string;
    reason: string;
    link?: string;
  }[]) {
    if (gap.status !== status) {
      continue;
    }
    const key = [gap.language, gap.reason, gap.link].join("\n");
    const group = groups.get(key);
    if (group) {
      group.platforms.push(gap.platform);
    } else {
      groups.set(key, { ...gap, platforms: [gap.platform] });
    }
  }
  return [...groups.values()];
}

const gapSections = [
  { title: "Blocked upstream", gaps: gapGroups("blocked") },
  { title: "Not started, path known", gaps: gapGroups("path-known") },
];

// Reasons are Markdown whose only markup is code spans.
function codeSpans(text: string) {
  return text
    .split("`")
    .map((part, index) => ({ part, code: index % 2 === 1 }));
}

function cellLabel(language: string, row: (typeof rows)[number], cell: Cell) {
  const label = `${language} on ${row.platform} ${row.arch} with ${row.backend}: ${statusLabels.get(cell.status)}`;
  return cell.detail ? `${label}. ${cell.detail}` : label;
}
---

<div class="not-content support-matrix">
  <p class="legend">
    {supportMatrix.statuses.map((row) => (
      <span>
        <span class={`cell ${row.status}`} aria-hidden="true">
          {glyphs[row.status as Status]}
        </span>
        {row.label}
      </span>
    ))}
  </p>
  <div class="scroll">
    <table>
      <thead>
        <tr>
          <th scope="col">Platform</th>
          <th scope="col">Arch</th>
          <th scope="col">Backend</th>
          {supportMatrix.languages.map((language) => (
            <th scope="col" class="language">
              <a href={`${sourceRoot}/${language.sourceDirectory}`}>
                {language.label}
              </a>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr class:list={{ "platform-start": row.platformRows > 0 }}>
            {row.platformRows > 0 && (
              <th scope="rowgroup" rowspan={row.platformRows}>
                {row.platform}
              </th>
            )}
            {row.archRows > 0 && (
              <th scope="row" class="secondary" rowspan={row.archRows}>
                {row.arch}
              </th>
            )}
            <th scope="row" class="secondary">{row.backend}</th>
            {row.cells.map((cell, index) => {
              const label = cellLabel(supportMatrix.languages[index].label, row, cell);
              return (
                <td>
                  <span
                    class={`cell ${cell.status}`}
                    title={label}
                    aria-label={label}
                    role="img"
                  >
                    {glyphs[cell.status as Status]}
                  </span>
                </td>
              );
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <details class="gaps">
    <summary>Gaps and their causes</summary>
    {gapSections.map((section) => (
      <>
        <p class="gap-title">{section.title}</p>
        <ul>
          {section.gaps.map((gap) => (
            <li>
              <strong>
                {gap.language} on {gap.platforms.join(", ")}:
              </strong>{" "}
              {codeSpans(gap.reason).map(({ part, code }) => (code ? (
                <code>{part}</code>
              ) : part))}
              {gap.link && (
                <>
                  {" "}
                  <a href={gap.link}>Upstream</a>
                </>
              )}
            </li>
          ))}
        </ul>
      </>
    ))}
  </details>
  <p class="note">
    Hover a cell for details. OpenGL uses WGL on Windows and EGL on other
    platforms. macOS EGL uses ANGLE.{" "}
    <a href={`${issueRoot}/${supportMatrix.issue}`}>
      Issue #{supportMatrix.issue}
    </a>{" "}
    tracks the gaps.
  </p>
</div>

<style>
.support-matrix {
  margin-block: 1.5rem;
  font-size: var(--sl-text-sm);
}
.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem 1rem;
  color: var(--sl-color-gray-3);
}
.legend > span {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
}
.scroll {
  overflow-x: auto;
  margin-block: 0.75rem;
}
table {
  border-collapse: separate;
  border-spacing: 2px;
}
th {
  font-weight: 600;
  text-align: start;
  white-space: nowrap;
  padding: 0 0.5rem 0 0;
  vertical-align: top;
}
th.secondary {
  color: var(--sl-color-gray-3);
  font-weight: 400;
}
thead th {
  vertical-align: bottom;
  color: var(--sl-color-gray-3);
  font-weight: 400;
}
th.language {
  padding: 0;
  height: 6rem;
}
th.language a {
  display: block;
  margin-inline: auto;
  writing-mode: vertical-rl;
  transform: rotate(180deg);
  color: var(--sl-color-white);
  font-weight: 600;
  text-decoration: none;
}
tr.platform-start > * {
  border-top: 1px solid var(--sl-color-hairline);
  padding-top: 0.25rem;
}
td {
  padding: 0;
  text-align: center;
}
.cell {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 1.5rem;
  height: 1.25rem;
  border: 1px solid transparent;
  border-radius: 0.25rem;
  font-size: var(--sl-text-xs);
  font-weight: 700;
  line-height: 1;
}
.tested {
  background: var(--sl-color-green-low);
  border-color: var(--sl-color-green);
  color: var(--sl-color-green-high);
}
.build-only {
  background: var(--sl-color-orange-low);
  border-color: var(--sl-color-orange);
  color: var(--sl-color-orange-high);
}
.blocked {
  background: var(--sl-color-red-low);
  border-color: var(--sl-color-red);
  color: var(--sl-color-red-high);
}
.path-known {
  border-color: var(--sl-color-gray-3);
  color: var(--sl-color-white);
}
.unknown {
  background: var(--sl-color-gray-6);
  border-color: var(--sl-color-gray-5);
  color: var(--sl-color-white);
}
.note {
  color: var(--sl-color-gray-3);
}
.gaps {
  margin-block: 0.75rem;
}
.gaps summary {
  cursor: pointer;
  font-weight: 600;
}
.gap-title {
  margin-block: 0.75rem 0.25rem;
  font-weight: 600;
}
.gaps ul {
  margin: 0;
  padding-inline-start: 1.25rem;
}
.gaps li {
  margin-block: 0.25rem;
}
.gaps a,
.note a {
  color: var(--sl-color-text-accent);
}
</style>
