---
import supportMatrix from "../generated/support-matrix.json";

// The matrix also says why a target is unsupported, which matters only to
// maintainers, so the site shows every such status as unsupported.
type Status = "tested" | "build-only" | "unsupported";

const statuses: { status: Status; label: string; glyph: string }[] = [
  { status: "tested", label: "Tested in CI", glyph: "✓" },
  { status: "build-only", label: "Built only", glyph: "◐" },
  { status: "unsupported", label: "Not supported", glyph: "✕" },
];
const glyphs = new Map(statuses.map((row) => [row.status, row.glyph]));
const statusLabels = new Map(statuses.map((row) => [row.status, row.label]));

function siteStatus(status: string): Status {
  return status === "tested" || status === "build-only"
    ? status
    : "unsupported";
}

const sourceRoot = "https://github.com/maplibre/maplibre-native-ffi/tree/main";
const issueRoot = "https://github.com/maplibre/maplibre-native-ffi/issues";
const bindings = supportMatrix.bindings;

// Backends of one architecture share a row when every binding gives them the
// same status.
const groups = supportMatrix.platforms.map((platform) => {
  // A label such as `Linux (GNU)` names a platform and its variant.
  const parts = /^(.*) \((.*)\)$/.exec(platform.label);
  const rows = platform.architectures.flatMap((arch) => {
    const merged = new Map<string, { backends: string[]; cells: Status[] }>();
    for (const backend of arch.backends) {
      const cells = backend.cells.map((cell) => siteStatus(cell.status));
      const row = merged.get(cells.join());
      if (row) row.backends.push(backend.label);
      else merged.set(cells.join(), { backends: [backend.label], cells });
    }
    const variant = "variant" in arch ? arch.variant : undefined;
    return [...merged.values()].map((row, index) => ({
      ...row,
      arch: arch.arch,
      variant,
      archSpan: index === 0 ? merged.size : 0,
    }));
  });
  return {
    label: platform.label,
    name: parts ? parts[1] : platform.label,
    variant: parts?.[2],
    rows,
  };
});

// Hovering a binding's header or cell highlights its column.
const columnHighlight = bindings
  .map((_, index) => {
    const table = `.support-matrix table:has(.col-${index}:hover)`;
    return `${table} .col-${index} { background: var(--sl-color-gray-6); }
${table} th.col-${index} a { color: var(--sl-color-text-accent); }`;
  })
  .join("\n");

function cellLabel(
  binding: string,
  target: string,
  backends: string[],
  status: Status,
) {
  return `${binding} on ${target} with ${backends.join(" or ")}: ${statusLabels.get(status)}`;
}
---

<div class="not-content support-matrix">
  <style is:inline set:html={columnHighlight} />
  <p class="legend">
    {statuses.map((row) => (
      <span>
        <span class={`cell ${row.status}`} aria-hidden="true">
          {row.glyph}
        </span>
        {row.label}
      </span>
    ))}
  </p>
  <div class="scroll">
    <table>
      <thead>
        <tr>
          <th scope="col">Platform</th>
          <th scope="col">Arch</th>
          <th scope="col">Backend</th>
          {bindings.map((binding, index) => (
            <th scope="col" class={`binding col-${index}`}>
              <a
                href={`${sourceRoot}/${binding.sourceDirectory}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                {binding.label}
              </a>
            </th>
          ))}
        </tr>
      </thead>
      {groups.map((platform) => (
        <tbody>
          {platform.rows.map((row, rowIndex) => (
            <tr>
              {rowIndex === 0 && (
                <th
                  scope="rowgroup"
                  rowspan={platform.rows.length}
                  class="platform"
                >
                  {platform.name}
                  {platform.variant && (
                    <span class="variant">{platform.variant}</span>
                  )}
                </th>
              )}
              {row.archSpan > 0 && (
                <th scope="row" rowspan={row.archSpan} class="secondary">
                  {row.arch}
                  {row.variant && <span class="variant">{row.variant}</span>}
                </th>
              )}
              <th scope="row" class="secondary backend">
                {row.backends.join(", ")}
              </th>
              {row.cells.map((status, index) => {
                const target = [platform.label, row.arch, row.variant]
                  .filter(Boolean)
                  .join(" ");
                const label = cellLabel(bindings[index].label, target, row.backends, status);
                return (
                  <td class={`col-${index}`}>
                    <span
                      class={`cell ${status}`}
                      title={label}
                      aria-label={label}
                      role="img"
                    >
                      {glyphs.get(status)}
                    </span>
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      ))}
    </table>
  </div>
  <p class="note">
    TypeScript runs under Node, Bun, and Deno, in ArkTS apps on OpenHarmony, and
    in the browser. OpenGL uses WGL on Windows and EGL on other platforms. macOS
    EGL uses ANGLE.{" "}
    <a
      href={`${issueRoot}/${supportMatrix.issue}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      Issue #{supportMatrix.issue}
    </a>{" "}
    tracks the gaps.
  </p>
</div>

<style>
.support-matrix {
  margin-block: 1.5rem;
  font-size: var(--sl-text-sm);
}
.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem 1rem;
  color: var(--sl-color-gray-3);
}
.legend > span {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
}
.scroll {
  overflow-x: auto;
  margin-block: 0.75rem;
}
table {
  border-collapse: collapse;
}
th {
  font-weight: 600;
  text-align: start;
  white-space: nowrap;
  padding: 1px 0.5rem 1px 0;
  vertical-align: top;
  line-height: 1.375rem;
}
th.secondary {
  color: var(--sl-color-gray-3);
  font-weight: 400;
}
/* Fits two backends on a line, and wraps a third. */
th.backend {
  white-space: normal;
  min-width: 7rem;
}
.variant {
  display: block;
  color: var(--sl-color-gray-3);
  font-size: var(--sl-text-xs);
  font-weight: 400;
  line-height: 1rem;
}
thead th {
  vertical-align: bottom;
  color: var(--sl-color-gray-3);
  font-weight: 400;
}
th.binding {
  padding: 0;
  height: 6rem;
  border-radius: 0.25rem 0.25rem 0 0;
}
th.binding a {
  display: block;
  margin-inline: auto;
  padding-inline: 0.25rem;
  writing-mode: vertical-rl;
  transform: rotate(180deg);
  color: var(--sl-color-white);
  font-weight: 600;
  text-decoration: none;
}
tbody {
  border-top: 1px solid var(--sl-color-hairline);
}
tbody > tr:first-child > * {
  padding-top: 0.25rem;
}
tbody > tr:last-child > * {
  padding-bottom: 0.25rem;
}
td {
  padding: 1px;
  text-align: center;
  vertical-align: top;
}
tr:hover > td {
  background: var(--sl-color-gray-6);
}
tr:hover > th.secondary,
tbody:hover > tr > th.platform {
  color: var(--sl-color-text-accent);
}
.cell {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 1.5rem;
  height: 1.25rem;
  border: 1px solid transparent;
  border-radius: 0.25rem;
  font-size: var(--sl-text-xs);
  font-weight: 700;
  line-height: 1;
}
.tested {
  background: var(--sl-color-green-low);
  border-color: var(--sl-color-green);
  color: var(--sl-color-green-high);
}
.build-only {
  background: var(--sl-color-gray-6);
  border-color: var(--sl-color-gray-5);
  color: var(--sl-color-white);
}
.unsupported {
  background: var(--sl-color-red-low);
  border-color: var(--sl-color-red);
  color: var(--sl-color-red-high);
}
.note {
  color: var(--sl-color-gray-3);
}
.note a {
  color: var(--sl-color-text-accent);
}
</style>
