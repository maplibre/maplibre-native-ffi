---
import Default from "@astrojs/starlight/components/Footer.astro";
import { Image } from "astro:assets";

import ciPoweredByBlacksmith from "../assets/ci-powered-by-blacksmith.png";
---

<Default />
<a class="sponsor" href="https://www.blacksmith.sh/">
  <Image
    src={ciPoweredByBlacksmith}
    alt="CI powered by Blacksmith"
    width={180}
  />
</a>

<style>
.sponsor {
  display: block;
  width: fit-content;
  margin: 1.5rem auto 0;
}
</style>
