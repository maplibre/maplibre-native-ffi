---
import GoImport from "../../components/GoImport.astro";

// The go command looks up the tag at the path it imports, so the module root
// and each public package need a page.
export function getStaticPaths() {
  return [{ params: { path: undefined } }, { params: { path: "maplibre" } }];
}
---

<GoImport
  module="maplibre.org/maplibre-native-ffi/go"
  vcs="git"
  url="https://github.com/maplibre/maplibre-native-ffi"
  subdirectory="bindings/go"
/>
