---
import presets from "../../../../bindings/go/presets.json";
import GoImport from "../../components/GoImport.astro";

// Each preset's module is served through the module proxy protocol by the
// Cloudflare Pages site that tools/release/go_native_modules.py writes.
export function getStaticPaths() {
  return presets.map((preset) => ({ params: { preset } }));
}

const { preset } = Astro.params;
---

<GoImport
  module={`maplibre.org/maplibre-native-ffi/go-native/${preset}`}
  vcs="mod"
  url="https://go.maplibre-native-ffi.pages.dev"
/>
