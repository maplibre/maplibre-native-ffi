// maplibre_native_c.h leaves out plugin.h, so it is an explicit submodule
// that a consumer imports by name.
framework module MaplibreNativeC {
  umbrella header "maplibre_native_c.h"
  export *

  explicit module Plugin {
    header "maplibre_native_c/plugin.h"
    header "mln/plugin/plugin_api.h"
    export *
  }
}
