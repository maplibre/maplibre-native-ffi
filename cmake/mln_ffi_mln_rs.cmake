# Builds the C library from mln-rs, the Rust port of MapLibre Native that the
# third_party/mln-rs submodule vendors. Its `mln_c` crate (package mln-rs-c)
# implements the C API that include/ declares. Cargo builds the crate as a
# shared library and a static archive for the preset's Rust target, and this
# file gives both the names, install names, and symbols that the package has
# always had, so the CMake package, pkg-config, the artifact descriptor, and the
# bindings see no difference.
#
# The crate builds every render backend that its target supports, so the
# presets of one platform share a Cargo build and differ in which backend their
# tests drive and which one the descriptor names.

set(MLN_FFI_MLN_RS_DIR "${PROJECT_SOURCE_DIR}/third_party/mln-rs")
set(MLN_FFI_LIBRARY_NAME maplibre-native-c)
set(MLN_FFI_SHIM_PERMISSIONS
    OWNER_READ
    OWNER_WRITE
    OWNER_EXECUTE
    GROUP_READ
    GROUP_EXECUTE
    WORLD_READ
    WORLD_EXECUTE)

# include/ is the source of truth for the C API, and mln-rs keeps a copy of it
# in crates/mln_c/include, which its own ABI tests compile against. A copy that
# differs means that the crate implements another API than the one this
# repository publishes, so the configure step fails until the two agree: copy
# include/ over the crate's copy in a patch under patches/mln-rs/, or update the
# submodule to a commit that already has the change.
function(mln_ffi_check_mln_rs_headers)
  set(ours "${PROJECT_SOURCE_DIR}/include")
  set(theirs "${MLN_FFI_MLN_RS_DIR}/crates/mln_c/include")
  if(NOT IS_DIRECTORY "${theirs}")
    message(
      FATAL_ERROR
        "third_party/mln-rs is not checked out; run `mise deps` to check it out and apply patches/mln-rs"
    )
  endif()
  file(GLOB_RECURSE our_headers RELATIVE "${ours}" CONFIGURE_DEPENDS
       "${ours}/*.h")
  file(GLOB_RECURSE their_headers RELATIVE "${theirs}" CONFIGURE_DEPENDS
       "${theirs}/*.h")
  set(differences)
  foreach(header IN LISTS our_headers their_headers)
    if(NOT EXISTS "${ours}/${header}")
      list(APPEND differences "only in mln-rs: ${header}")
    elseif(NOT EXISTS "${theirs}/${header}")
      list(APPEND differences "only in include/: ${header}")
    else()
      file(SHA256 "${ours}/${header}" our_hash)
      file(SHA256 "${theirs}/${header}" their_hash)
      if(NOT our_hash STREQUAL their_hash)
        list(APPEND differences "differs: ${header}")
      endif()
    endif()
  endforeach()
  list(REMOVE_DUPLICATES differences)
  if(differences)
    list(JOIN differences "\n  " differences)
    message(
      FATAL_ERROR
        "include/ and third_party/mln-rs/crates/mln_c/include differ:\n  ${differences}\n"
        "include/ is the source of truth. Bring mln-rs's copy in line with a "
        "patch in patches/mln-rs/, or update the submodule to a commit that has "
        "the change. See the development overview.")
  endif()
endfunction()

# Writes an executable wrapper that runs `compiler` with the target, sysroot,
# and flags that CMake compiles with, so Cargo, cc-rs, and rustc's link step
# build for the same target and against the same SDK as CMake does. cc-rs adds
# a target of its own, the Rust target's LLVM triple, which lacks the API level
# that an Android or OpenHarmony triple carries, so the wrapper drops it.
function(mln_ffi_write_compiler_shim out_var name compiler language)
  set(arguments)
  set(filter "")
  if(CMAKE_${language}_COMPILER_TARGET)
    list(
      APPEND arguments
      "${CMAKE_${language}_COMPILE_OPTIONS_TARGET}${CMAKE_${language}_COMPILER_TARGET}"
    )
    set(filter
        [=[args=""
quote() { printf '%s' "$1" | sed "s/'/'\\\\''/g"; }
while [ "$#" -gt 0 ]; do
  case "$1" in
    --target=*) shift; continue ;;
    --target | -target) shift 2; continue ;;
  esac
  args="$args '$(quote "$1")'"
  shift
done
eval "set -- $args"
]=])
  endif()
  if(CMAKE_SYSROOT)
    list(APPEND arguments
         "${CMAKE_${language}_COMPILE_OPTIONS_SYSROOT}${CMAKE_SYSROOT}")
  endif()
  separate_arguments(flags NATIVE_COMMAND "${CMAKE_${language}_FLAGS}")
  list(APPEND arguments ${flags})
  set(quoted "")
  foreach(argument IN LISTS arguments)
    string(REPLACE "'" "'\\''" argument "${argument}")
    string(APPEND quoted " '${argument}'")
  endforeach()
  set(shim "${CMAKE_BINARY_DIR}/cargo-shim/${name}")
  file(
    WRITE "${shim}"
    "#!/bin/sh\n# Generated by cmake/mln_ffi_mln_rs.cmake.\n${filter}exec '${compiler}'${quoted} \"$@\"\n"
  )
  file(CHMOD "${shim}" PERMISSIONS ${MLN_FFI_SHIM_PERMISSIONS})
  set(${out_var} "${shim}" PARENT_SCOPE)
endfunction()

# The environment and rustc arguments that build the crate for this preset.
function(mln_ffi_cargo_environment out_environment out_rustc_arguments)
  set(rust_target "${MLN_FFI_RUST_TARGET}")
  string(TOUPPER "${rust_target}" target_upper)
  string(REPLACE "-" "_" target_upper "${target_upper}")
  string(TOLOWER "${target_upper}" target_lower)

  set(environment "CARGO_TARGET_DIR=${MLN_FFI_CARGO_TARGET_DIR}")
  set(rustc_arguments)
  # Flags for every crate that Cargo builds for the target, but not for build
  # scripts, which run on the host.
  set(target_rustflags)

  if(APPLE)
    # rustc and cc-rs find the SDK through xcrun. The deployment target is the
    # preset's, which they read from the environment.
    if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
      list(APPEND environment
           "MACOSX_DEPLOYMENT_TARGET=${CMAKE_OSX_DEPLOYMENT_TARGET}")
    elseif(CMAKE_SYSTEM_NAME STREQUAL "iOS")
      mln_ffi_apple_is_maccatalyst(maccatalyst)
      if(maccatalyst)
        # Mac Catalyst 14.0 runs on macOS 11, the Catalyst floor of Rust.
        list(APPEND environment "MACOSX_DEPLOYMENT_TARGET=11.0")
      else()
        list(APPEND environment
             "IPHONEOS_DEPLOYMENT_TARGET=${CMAKE_OSX_DEPLOYMENT_TARGET}")
      endif()
    elseif(CMAKE_SYSTEM_NAME STREQUAL "tvOS")
      list(APPEND environment
           "TVOS_DEPLOYMENT_TARGET=${CMAKE_OSX_DEPLOYMENT_TARGET}")
    elseif(CMAKE_SYSTEM_NAME STREQUAL "visionOS")
      list(APPEND environment
           "XROS_DEPLOYMENT_TARGET=${CMAKE_OSX_DEPLOYMENT_TARGET}")
    endif()
    list(APPEND rustc_arguments -C
         "link-arg=-Wl,-install_name,@rpath/lib${MLN_FFI_LIBRARY_NAME}.dylib")
  elseif(CMAKE_HOST_WIN32)
    # A Windows host builds with the compilers that its environment provides,
    # which cc-rs and rustc find themselves for MSVC. MinGW takes MSYS2's.
    if(MINGW)
      list(
        APPEND environment "CC_${target_lower}=${CMAKE_C_COMPILER}"
        "CXX_${target_lower}=${CMAKE_CXX_COMPILER}"
        "AR_${target_lower}=${CMAKE_AR}"
        "CARGO_TARGET_${target_upper}_LINKER=${CMAKE_C_COMPILER}")
    endif()
  elseif(MSVC)
    # Another host cross-compiles with clang-cl and lld-link against the
    # /winsysroot tree, which neither cc-rs nor rustc knows of.
    list(
      APPEND
      environment
      "CC_${target_lower}=${CMAKE_C_COMPILER}"
      "CXX_${target_lower}=${CMAKE_CXX_COMPILER}"
      "AR_${target_lower}=${CMAKE_AR}"
      "CFLAGS_${target_lower}=/winsysroot${MLN_FFI_WINSYSROOT}"
      "CXXFLAGS_${target_lower}=/winsysroot${MLN_FFI_WINSYSROOT}"
      "CARGO_TARGET_${target_upper}_LINKER=${CMAKE_LINKER}")
    list(APPEND target_rustflags "-Clink-arg=/winsysroot:${MLN_FFI_WINSYSROOT}")
  else()
    # Linux, FreeBSD, Android, OpenHarmony, and Emscripten: the compiler that
    # CMake uses, wrapped with its target and flags.
    mln_ffi_write_compiler_shim(cc cc "${CMAKE_C_COMPILER}" C)
    mln_ffi_write_compiler_shim(cxx c++ "${CMAKE_CXX_COMPILER}" CXX)
    list(
      APPEND
      environment
      "CC_${target_lower}=${cc}"
      "CXX_${target_lower}=${cxx}"
      "AR_${target_lower}=${CMAKE_AR}"
      "CARGO_TARGET_${target_upper}_AR=${CMAKE_AR}"
      "CARGO_TARGET_${target_upper}_LINKER=${cc}")
    if(NOT EMSCRIPTEN)
      # Cargo gives a shared library no soname, so the library gets the one
      # that it installs under. The symbol table goes the way CPack strips the
      # binaries it installs as targets.
      list(
        APPEND rustc_arguments -C
        "link-arg=-Wl,-soname,lib${MLN_FFI_LIBRARY_NAME}.so" -C strip=symbols)
    endif()
    if(CMAKE_SYSTEM_NAME STREQUAL "OHOS")
      # cc-rs and rustc's OpenHarmony target assume musl, which the SDK
      # selects through this macro.
      list(APPEND environment "CFLAGS_${target_lower}=-D__MUSL__")
    endif()
    if(MLN_FFI_RUST_TARGET MATCHES "-musl$")
      # Rust's musl targets link the C runtime statically by default, which
      # leaves them without shared libraries. The library links musl's
      # libc.so instead, as the hosts that load it do.
      list(APPEND target_rustflags -Ctarget-feature=-crt-static)
    endif()
    if(CMAKE_SYSTEM_NAME STREQUAL "FreeBSD")
      # zig links FreeBSD's libc from stubs of its own, which leave out the
      # system libraries that the libc crate names for every FreeBSD program.
      # Nothing in the library calls them, so empty stand-ins satisfy the link,
      # and --as-needed keeps them out of the library's dependencies.
      set(stub_dir "${CMAKE_BINARY_DIR}/cargo-stubs")
      file(MAKE_DIRECTORY "${stub_dir}")
      file(WRITE "${stub_dir}/empty.c" "")
      foreach(library devstat kvm memstat procstat)
        execute_process(
          COMMAND
            "${CMAKE_C_COMPILER}" -shared -o "${stub_dir}/lib${library}.so"
            "${stub_dir}/empty.c"
          COMMAND_ERROR_IS_FATAL ANY)
      endforeach()
      list(APPEND target_rustflags "-Lnative=${stub_dir}")
    endif()
  endif()

  # Emscripten rejects mixing objects that carry atomics with objects that do
  # not under shared memory, and rustup ships no wasm32-unknown-emscripten std
  # built with atomics, so std is rebuilt from source. -Zbuild-std is
  # nightly-only, and this is the one place the repository reaches for a nightly
  # feature: RUSTC_BOOTSTRAP unlocks it on the pinned stable toolchain, which
  # keeps every other build, and every artifact we ship, on stable.
  if(EMSCRIPTEN)
    list(APPEND environment "RUSTC_BOOTSTRAP=1")
    list(APPEND target_rustflags -Ctarget-feature=+atomics,+bulk-memory
         -Cpanic=abort)
  endif()

  if(target_rustflags)
    list(JOIN target_rustflags " " target_rustflags)
    list(APPEND environment
         "CARGO_TARGET_${target_upper}_RUSTFLAGS=${target_rustflags}")
  endif()

  set(${out_environment} ${environment} PARENT_SCOPE)
  set(${out_rustc_arguments} ${rustc_arguments} PARENT_SCOPE)
endfunction()

# The file names that Cargo gives the crate's outputs for the preset's target,
# and the ones that this package installs them under.
function(mln_ffi_library_files)
  set(cargo_dir "${MLN_FFI_CARGO_TARGET_DIR}/${MLN_FFI_RUST_TARGET}/release")
  set(native_dir "${CMAKE_BINARY_DIR}/native")
  # The libraries go beside the test executables, where Windows looks for the
  # DLLs that an executable imports.
  set(output_dir "${CMAKE_BINARY_DIR}")
  set(shared "")
  set(cargo_shared "")
  set(implib "")
  if(WIN32 AND MSVC)
    set(cargo_static "${cargo_dir}/maplibre_native_c.lib")
    set(static "${output_dir}/${MLN_FFI_LIBRARY_NAME}-static.lib")
    set(cargo_shared "${cargo_dir}/maplibre_native_c.dll")
    set(shared "${output_dir}/${MLN_FFI_LIBRARY_NAME}.dll")
    set(implib "${output_dir}/${MLN_FFI_LIBRARY_NAME}.lib")
  elseif(WIN32)
    set(cargo_static "${cargo_dir}/libmaplibre_native_c.a")
    set(static "${output_dir}/lib${MLN_FFI_LIBRARY_NAME}.a")
    set(cargo_shared "${cargo_dir}/maplibre_native_c.dll")
    set(shared "${output_dir}/${MLN_FFI_LIBRARY_NAME}.dll")
    set(implib "${output_dir}/lib${MLN_FFI_LIBRARY_NAME}.dll.a")
  else()
    set(cargo_static "${cargo_dir}/libmaplibre_native_c.a")
    set(static "${output_dir}/lib${MLN_FFI_LIBRARY_NAME}.a")
    if(APPLE)
      set(cargo_shared "${cargo_dir}/libmaplibre_native_c.dylib")
      set(shared "${output_dir}/lib${MLN_FFI_LIBRARY_NAME}.dylib")
    elseif(NOT EMSCRIPTEN)
      set(cargo_shared "${cargo_dir}/libmaplibre_native_c.so")
      set(shared "${output_dir}/lib${MLN_FFI_LIBRARY_NAME}.so")
    endif()
  endif()
  foreach(
    name
    cargo_dir
    native_dir
    cargo_static
    static
    cargo_shared
    shared
    implib)
    set(MLN_FFI_${name} "${${name}}" PARENT_SCOPE)
  endforeach()
endfunction()

# The commands that turn Cargo's static archive into the package's. An ELF
# archive comes out as one relocatable object whose only global symbols are the
# C API's, so the Rust standard library, compiler-builtins, and C dependencies
# inside it never meet a consumer's own copies, such as a Rust host's.
function(mln_ffi_static_archive_commands out_var input output)
  get_target_property(format mln_ffi_platform_dependencies
                      MLN_FFI_ARCHIVE_FORMAT)
  if(format STREQUAL "elf")
    set(object "${output}.o")
    set(commands
        COMMAND
        "${CMAKE_LINKER}"
        -r
        -o
        "${object}"
        --whole-archive
        "${input}"
        --no-whole-archive
        COMMAND
        "${CMAKE_OBJCOPY}"
        --wildcard
        "--keep-global-symbol=mln_*"
        # The final link keeps one COMDAT group of each name and discards the
        # rest, which would drop members that the now local code still uses.
        --remove-section=.group
        "${object}"
        COMMAND
        "${CMAKE_COMMAND}"
        -E
        rm
        -f
        "${output}"
        COMMAND
        "${CMAKE_AR}"
        qc
        "${output}"
        "${object}"
        COMMAND
        "${CMAKE_RANLIB}"
        "${output}"
        COMMAND
        "${CMAKE_COMMAND}"
        -E
        rm
        -f
        "${object}")
  else()
    set(commands COMMAND "${CMAKE_COMMAND}" -E copy "${input}" "${output}")
  endif()
  set(${out_var} ${commands} PARENT_SCOPE)
endfunction()

# Adds `target`, the C library that the tests, the package, and consumers that
# add this repository as a subdirectory link: an interface library that names
# the shared library, or the static archive where the platform has no shared
# libraries, and that builds them first.
function(mln_ffi_add_c_api_library target)
  mln_ffi_check_mln_rs_headers()
  find_program(CARGO_EXECUTABLE cargo REQUIRED)

  if(NOT MLN_FFI_RUST_TARGET)
    message(
      FATAL_ERROR "The build needs MLN_FFI_RUST_TARGET, which the preset sets")
  endif()
  # See the Emscripten entry in docs/support-gaps.toml.
  if(EMSCRIPTEN)
    message(
      FATAL_ERROR
        "The Emscripten presets are disabled: mln-rs doesn't build for "
        "wasm32-unknown-emscripten. Its browser build targets "
        "wasm32-unknown-unknown with wasm-bindgen, and its OpenGL and storage "
        "crates take those paths for every wasm32 target, while the browser "
        "builds here link Emscripten modules with pthreads.")
  endif()
  set(MLN_FFI_CARGO_TARGET_DIR "${PROJECT_SOURCE_DIR}/build/cargo"
      CACHE PATH "Cargo target directory for mln-rs")

  get_target_property(shared_supported mln_ffi_platform_dependencies
                      MLN_FFI_SHARED_SUPPORTED)
  mln_ffi_library_files()
  mln_ffi_cargo_environment(environment rustc_arguments)

  set(crate_types staticlib)
  if(shared_supported)
    set(crate_types cdylib,staticlib)
  endif()
  set(cargo_extra_arguments)
  if(EMSCRIPTEN)
    list(APPEND cargo_extra_arguments -Z build-std=std,panic_abort)
  endif()
  set(native_libraries "${MLN_FFI_native_dir}/native-static-libs.txt")

  file(
    GLOB_RECURSE
    rust_sources
    CONFIGURE_DEPENDS
    "${MLN_FFI_MLN_RS_DIR}/crates/*.rs"
    "${MLN_FFI_MLN_RS_DIR}/vendor/*.rs"
    "${MLN_FFI_MLN_RS_DIR}/crates/*/Cargo.toml"
    "${MLN_FFI_MLN_RS_DIR}/vendor/*/Cargo.toml")
  set(cargo_outputs "${MLN_FFI_cargo_static}")
  if(MLN_FFI_cargo_shared)
    list(APPEND cargo_outputs "${MLN_FFI_cargo_shared}")
  endif()
  add_custom_command(
    OUTPUT ${cargo_outputs} "${native_libraries}"
    COMMAND "${CMAKE_COMMAND}" -E make_directory "${MLN_FFI_native_dir}"
    COMMAND
      "${CMAKE_COMMAND}"
      -E
      env
      ${environment}
      "${CARGO_EXECUTABLE}"
      rustc
      --locked
      --manifest-path
      "${MLN_FFI_MLN_RS_DIR}/Cargo.toml"
      --package
      mln-rs-c
      --lib
      --crate-type
      ${crate_types}
      --target
      "${MLN_FFI_RUST_TARGET}"
      --release
      ${cargo_extra_arguments}
      --
      ${rustc_arguments}
      "--print=native-static-libs=${native_libraries}"
    DEPENDS
      ${rust_sources} "${MLN_FFI_MLN_RS_DIR}/Cargo.toml"
      "${MLN_FFI_MLN_RS_DIR}/Cargo.lock"
    WORKING_DIRECTORY "${MLN_FFI_MLN_RS_DIR}"
    COMMENT "Building mln-rs-c for ${MLN_FFI_RUST_TARGET} with Cargo"
    USES_TERMINAL
    VERBATIM)

  # The package's static archive.
  mln_ffi_static_archive_commands(static_commands "${MLN_FFI_cargo_static}"
                                  "${MLN_FFI_static}")
  add_custom_command(
    OUTPUT "${MLN_FFI_static}" ${static_commands}
    DEPENDS "${MLN_FFI_cargo_static}"
    VERBATIM)
  set(outputs "${MLN_FFI_static}")

  # The package's shared library, under its own name.
  if(MLN_FFI_shared)
    set(shared_commands
        COMMAND "${CMAKE_COMMAND}" -E copy "${MLN_FFI_cargo_shared}"
        "${MLN_FFI_shared}")
    if(WIN32)
      # The import library names the DLL that it loads, so the one Cargo
      # writes would name Cargo's file. A new one names the package's.
      if(MSVC)
        set(implib_tool "${CMAKE_AR}")
        set(implib_flavor msvc)
      else()
        find_program(MLN_FFI_DLLTOOL NAMES llvm-dlltool dlltool REQUIRED)
        set(implib_tool "${MLN_FFI_DLLTOOL}")
        set(implib_flavor mingw)
      endif()
      find_program(MLN_FFI_READOBJ NAMES llvm-readobj REQUIRED)
      list(
        APPEND
        shared_commands
        COMMAND
        "${CMAKE_COMMAND}"
        "-DDLL=${MLN_FFI_shared}"
        "-DIMPLIB=${MLN_FFI_implib}"
        "-DREADOBJ=${MLN_FFI_READOBJ}"
        "-DTOOL=${implib_tool}"
        "-DFLAVOR=${implib_flavor}"
        "-DARCHITECTURE=${MLN_FFI_TARGET_ARCHITECTURE}"
        -P
        "${PROJECT_SOURCE_DIR}/cmake/mln_ffi_import_library.cmake")
    endif()
    add_custom_command(
      OUTPUT "${MLN_FFI_shared}" ${MLN_FFI_implib} ${shared_commands}
      DEPENDS "${MLN_FFI_cargo_shared}"
      VERBATIM)
    list(APPEND outputs "${MLN_FFI_shared}" ${MLN_FFI_implib})
  endif()
  add_custom_target(${target}_build ALL DEPENDS ${outputs})

  add_library(${target}_static_imported STATIC IMPORTED GLOBAL)
  set_target_properties(
    ${target}_static_imported
    PROPERTIES
      IMPORTED_LOCATION "${MLN_FFI_static}" INTERFACE_COMPILE_DEFINITIONS
      MLN_STATIC)
  get_target_property(static_libraries mln_ffi_platform_dependencies
                      MLN_FFI_STATIC_LINK_LIBRARIES)
  if(static_libraries)
    set_target_properties(
      ${target}_static_imported
      PROPERTIES INTERFACE_LINK_LIBRARIES "${static_libraries}")
  endif()

  if(MLN_FFI_shared)
    add_library(${target}_imported SHARED IMPORTED GLOBAL)
    set_target_properties(
      ${target}_imported
      PROPERTIES IMPORTED_LOCATION "${MLN_FFI_shared}")
    if(WIN32)
      set_target_properties(
        ${target}_imported
        PROPERTIES IMPORTED_IMPLIB "${MLN_FFI_implib}")
    elseif(APPLE)
      set_target_properties(
        ${target}_imported
        PROPERTIES IMPORTED_SONAME "@rpath/lib${MLN_FFI_LIBRARY_NAME}.dylib")
    else()
      set_target_properties(
        ${target}_imported
        PROPERTIES IMPORTED_SONAME "lib${MLN_FFI_LIBRARY_NAME}.so")
    endif()
    set(library ${target}_imported)
  else()
    set(library ${target}_static_imported)
  endif()

  # Linking an interface library follows its dependencies, so a target that
  # links either library waits for Cargo.
  add_library(${target} INTERFACE)
  target_link_libraries(${target} INTERFACE ${library})
  target_include_directories(
    ${target}
    INTERFACE
      $<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/include>
      $<INSTALL_INTERFACE:include>)
  add_dependencies(${target} ${target}_build)
  add_library(${target}_static INTERFACE)
  target_link_libraries(${target}_static INTERFACE ${target}_static_imported)
  target_include_directories(
    ${target}_static
    INTERFACE
      $<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/include>
      $<INSTALL_INTERFACE:include>)
  add_dependencies(${target}_static ${target}_build)

  set_target_properties(
    ${target}
    PROPERTIES
      MLN_FFI_SHARED_FILE
      "${MLN_FFI_shared}"
      MLN_FFI_IMPLIB_FILE
      "${MLN_FFI_implib}"
      MLN_FFI_STATIC_FILE
      "${MLN_FFI_static}"
      MLN_FFI_NATIVE_LIBRARIES_FILE
      "${native_libraries}")

  mln_ffi_add_mln_rs_components(${target})
endfunction()

# The components that the library carries: mln-rs, with its patches, the Rust
# crates that Cargo builds into it, as cargo-about lists them, and the Rust
# standard library.
function(mln_ffi_add_mln_rs_components target)
  find_program(CARGO_ABOUT_EXECUTABLE cargo-about REQUIRED)
  find_program(RUSTC_EXECUTABLE rustc REQUIRED)
  mln_ffi_add_component(
    ${target}
    mln-rs
    https://github.com/louwers/mln-rs
    BSD-2-Clause
    SOURCE
    "${MLN_FFI_MLN_RS_DIR}"
    NOTICES
    "${MLN_FFI_MLN_RS_DIR}/LICENSE.md"
    mln-rs.md)

  set(inventory "${CMAKE_CURRENT_BINARY_DIR}/rust-components.json")
  set(license_config "${PROJECT_SOURCE_DIR}/cmake/about.toml")
  set(manifest "${MLN_FFI_MLN_RS_DIR}/crates/mln_c/Cargo.toml")
  set_property(
    DIRECTORY
    APPEND
    PROPERTY
      CMAKE_CONFIGURE_DEPENDS "${MLN_FFI_MLN_RS_DIR}/Cargo.lock" "${manifest}"
      "${license_config}")
  execute_process(
    COMMAND
      "${CARGO_ABOUT_EXECUTABLE}"
      generate
      --manifest-path
      "${manifest}"
      --config
      "${license_config}"
      --target
      "${MLN_FFI_RUST_TARGET}"
      --locked
      --fail
      --format
      json
      --output-file
      "${inventory}"
    WORKING_DIRECTORY "${MLN_FFI_MLN_RS_DIR}"
    COMMAND_ERROR_IS_FATAL ANY)
  set_property(TARGET ${target} PROPERTY MLN_FFI_CARGO_ABOUT "${inventory}")

  execute_process(
    COMMAND "${RUSTC_EXECUTABLE}" --print sysroot
    OUTPUT_VARIABLE rust_sysroot OUTPUT_STRIP_TRAILING_WHITESPACE
    COMMAND_ERROR_IS_FATAL ANY)
  string(REPLACE "\\" "/" rust_sysroot "${rust_sysroot}")
  execute_process(
    COMMAND "${RUSTC_EXECUTABLE}" --version
    OUTPUT_VARIABLE rust_version OUTPUT_STRIP_TRAILING_WHITESPACE
    COMMAND_ERROR_IS_FATAL ANY)
  mln_ffi_add_component(
    ${target}
    rust-std
    https://github.com/rust-lang/rust
    "MIT OR Apache-2.0"
    VERSION
    "${rust_version}"
    NOTICES
    "${rust_sysroot}/share/doc/rust/COPYRIGHT-library.html"
    rust-std.html)
endfunction()
