#!/usr/bin/env bash
#MISE description="Build the local devcontainer image for the host architecture."
#USAGE flag "--tag <tag>" help="Final image tag" default="maplibre-native-ffi-devcontainer:local"
#USAGE flag "--push" help="Push the final image instead of loading it into Docker"
set -euo pipefail

host_arch="$(uname -m)"
case "$host_arch" in
  arm64 | aarch64)
    platform="linux/arm64"
    mise_env="linux-arm64-vulkan"
    ;;
  x86_64 | amd64)
    platform="linux/amd64"
    mise_env="linux-x64-vulkan"
    ;;
  *) echo "unsupported host architecture: $host_arch" >&2; exit 1 ;;
esac

docker run --rm \
  --platform "$platform" \
  --volume "$PWD/..:/src" \
  --workdir /src \
  --env MISE_EXPERIMENTAL=1 \
  --env MISE_JOBS=1 \
  --env MISE_ENV="$mise_env" \
  --env OUTPUT_GID="$(id -g)" \
  --env OUTPUT_UID="$(id -u)" \
  ubuntu:24.04 \
  bash -euo pipefail -c '
    apt-get update
    apt-get install --no-install-recommends --yes ca-certificates curl git
    curl https://mise.run | sh
    /root/.local/bin/mise trust -y
    cd .devcontainer
    rm -rf mise-oci
    MISE_IGNORED_CONFIG_PATHS=/src/mise.local.toml \
      MISE_SYSTEM_PACKAGES_MANAGERS=apt \
      /root/.local/bin/mise --no-hooks bootstrap --yes
    MISE_IGNORED_CONFIG_PATHS=/src/mise.local.toml \
      MISE_SYSTEM_PACKAGES_MANAGERS=apt \
      /root/.local/bin/mise --no-hooks oci build --output mise-oci
    chown -R "$OUTPUT_UID:$OUTPUT_GID" mise-oci
  '

output_arg="--load"
if [[ "${usage_push:-false}" == "true" ]]; then
  output_arg="--push"
fi

buildx=(docker buildx)
if command -v docker-buildx >/dev/null 2>&1; then
  buildx=(docker-buildx)
fi

builder="maplibre-native-ffi-$$"
"${buildx[@]}" create --name "$builder" --driver docker-container >/dev/null
cleanup_builder() {
  "${buildx[@]}" rm "$builder" >/dev/null 2>&1 || true
}
trap cleanup_builder EXIT

"${buildx[@]}" build \
  --builder "$builder" \
  --platform "$platform" \
  --file Dockerfile \
  --build-context "tools=oci-layout://$PWD/mise-oci" \
  --tag "${usage_tag:?}" \
  "$output_arg" \
  ..
